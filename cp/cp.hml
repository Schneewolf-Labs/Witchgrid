// cp.hml — Witchgrid control plane.
//
// Owns the node registry. Service-supervisor work happens on agents
// (one per node, see ../agent/); CP routes spawn/list/stop requests to
// the agent that owns each service.
//
// Endpoints:
//   POST /register         { node_id, hostname, role, hardware,
//                            agent_url }                         → 200
//   GET  /nodes                                                  → [...]
//   GET  /healthz                                                → ok
//
//   POST /services         { node_id, profile, model, port?,
//                            gpus? }                             → 201
//                          (proxied to the named agent)
//   GET  /services                                               → [...]
//                          (aggregated from every registered agent;
//                           each entry tagged with node_id)
//   POST /services/stop    { id, node_id }                       → 204
//                          (proxied to the named agent)
//
//   * /v1/llama/{profile}/{...}                                  → proxy
//                          (routes to a running llama-server with the
//                           given profile; CP forwards the request
//                           directly to llama-server, agents stay off
//                           the inference data path)
//
// Run:    hemlock cp.hml
// Build:  hemlockc cp.hml -o witchgrid-cp && ./witchgrid-cp

import { open_db, exec, exec as db_exec, query, close_db } from "@stdlib/sqlite";
import { parse, stringify } from "@stdlib/json";
import { post_json, post, get, request as http_request, stream as http_stream, request_timeout as http_request_timeout, url_encode } from "@stdlib/http";
import { sleep, time_ms as unix_ms } from "@stdlib/time";
import { exists, make_dirs, list_dir, remove_file } from "@stdlib/fs";
import { getenv, setenv, unsetenv } from "@stdlib/env";
import { sha256 } from "@stdlib/hash";
import { serve } from "./http_server";
import { mcp_handle } from "./mcp";
import { WITCHGRID_VERSION } from "../version";
import { on_shutdown } from "@stdlib/signal";
import { exit, exec_argv } from "@stdlib/process";
import { read_metadata, estimate_vram_mb, estimate_vram_from_ingredients } from "./gguf";
// Declarative layout: the pure planner + the profile fingerprint the agent
// stamps on every service row.
import { plan_layout, merge_patch, spread_mb, validate_layout_request, same_gpus, sorted_ints,
	gpu_key, mb_total } from "./layout";
import { profile_fingerprint, canonical_json, json_tree } from "../agent/fingerprint";
// Shared-base LoRA: the same pure rules the agent applies (validation,
// adapters, slot/context sizing) for profile checks + join placement.
import { is_sharing_profile, sharing_profile_error, profile_adapters, member_slots,
	member_ctx_per_slot, desired_config } from "../agent/lora_share";
import { render_layout, render_nodes, render_services, render_profiles, render_capabilities, render_catalog, render_stats, render_transfers, render_missing, render_bench,
         OVERVIEW_HTML, PAGE_CATALOG, PAGE_TRANSFERS, PAGE_PROFILES, PAGE_BENCH, PAGE_DEPLOY, PAGE_SETTINGS,
         SHELL_CSS, SHELL_JS, LOGO } from "./dashboard";

let DB_PATH = "witchgrid.db";
// Bind address/port. Default 0.0.0.0:8765 (LAN-first). Override with
// WITCHGRID_CP_HOST / WITCHGRID_CP_PORT — e.g. bind 127.0.0.1 and front it
// with an authenticating reverse proxy for anything beyond a trusted LAN.
let _cp_host_env = getenv("WITCHGRID_CP_HOST");
let HOST = (_cp_host_env == null || _cp_host_env.length == 0) ? "0.0.0.0" : _cp_host_env;
let _cp_port_env = getenv("WITCHGRID_CP_PORT");
let PORT = (_cp_port_env == null || _cp_port_env.length == 0) ? 8765 : i32(_cp_port_env);

// Resolve where the sqlite DB lives. WITCHGRID_DATA_DIR pins it to an
// absolute, CWD-independent location (created if missing); unset keeps the
// historical CWD-relative filename. main() logs the resolved path and warns
// loudly before creating a fresh DB — the "started from the wrong directory
// → empty registry, didn't notice" foot-gun (test-cases-todo #15). The CP
// is especially exposed: a stray fresh DB means every node + profile +
// running service vanishes from its view.
fn resolve_data_path(name: string): string {
	let dir = getenv("WITCHGRID_DATA_DIR");
	if (dir == null || dir.length == 0) { return name; }
	let d = dir;
	while (d.length > 1 && d.substr(d.length - 1, 1) == "/") {
		d = d.substr(0, d.length - 1);
	}
	if (!exists(d)) {
		try { make_dirs(d); } catch (e) {
			eprint("[cp] could not create WITCHGRID_DATA_DIR " + d + ": " + e);
		}
	}
	return d + "/" + name;
}

// ── auth (slice 1: shared bearer for CP↔agent) ─────────────────────
//
// Single shared secret, env-injected. When set, every inbound request
// EXCEPT routes flagged `public: true` (and, unless the protect knobs
// below are on, routes flagged scope: "read" / scope: "inference")
// must carry
//   Authorization: Bearer <secret>
// or it gets a 401. Same secret is sent on every CP→agent call so the
// agent can validate us in turn.
//
// Unset (the default) = legacy mode: no checks, just a [auth] DISABLED
// warning at boot. This lets the operator roll out updated agents
// before flipping the switch on CP. Once every node is on a binary
// that knows the secret, set it on CP last.
//
// Comparison goes through sha256 to bound timing-leak surface to a
// fixed-length digest regardless of secret length. Not strict CT but
// the threat model is LAN/WireGuard, not a remote network attacker.
//
// Read fresh from env on every call rather than caching in a let:
// Hemlock spawn() snapshots module state at spawn time, so async
// tasks (per-accept worker, bench task) would see whatever the let
// was BEFORE init_auth ran. Re-reading dodges that.
fn shared_secret(): string {
	let s = getenv("WITCHGRID_SHARED_SECRET");
	if (s == null) { return ""; }
	return s;
}

// ── auth options ───────────────────────────────────────────────────
//
// Both no-ops unless WITCHGRID_SHARED_SECRET is also set (the secret
// stays optional — LAN-first default is unchanged):
//
//   WITCHGRID_AUTH_PROTECT_READ       gate the read-only surface too
//                                     (/nodes, /ui/*, /api/state, SSE,
//                                     /metrics, /resolve/*, logs, …).
//                                     The browser dashboard can't send
//                                     the bearer yet, so its live views
//                                     401 — front it with a header-
//                                     injecting reverse proxy.
//   WITCHGRID_AUTH_PROTECT_INFERENCE  gate /v1/llama/* (the inference
//                                     data plane) behind the same
//                                     bearer. Off = any LAN client can
//                                     run inference even with a secret
//                                     set (the historical behavior).
//
// Read fresh from env per request, same rationale as shared_secret().
fn env_truthy(name: string): bool {
	let v = getenv(name);
	if (v == null) { return false; }
	let s = v.trim().to_lower();
	return s == "1" || s == "true" || s == "yes" || s == "on";
}

fn auth_protect_read(): bool {
	return env_truthy("WITCHGRID_AUTH_PROTECT_READ");
}

fn auth_protect_inference(): bool {
	return env_truthy("WITCHGRID_AUTH_PROTECT_INFERENCE");
}

// curl auth config: cp_get_fast shells out to curl for the dashboard
// fan-outs, and `-H "Authorization: Bearer <secret>"` in argv leaks the
// secret to every local user via /proc/<pid>/cmdline (world-readable)
// on every fan-out. Instead the bearer lives in a 0600 curl config file
// (`-K <path>`) under the data dir. The content reaches the writing
// shell via the environment — also not argv-visible — so the secret
// never appears on any command line. Rewritten on every boot; removed
// when auth is off.
fn curl_auth_cfg_path(): string {
	return resolve_data_path("curl_auth.cfg");
}

fn write_curl_auth_cfg(): null {
	let path = curl_auth_cfg_path();
	let secret = shared_secret();
	if (secret == "") {
		try { if (exists(path)) { remove_file(path); } } catch (e) { }
		return null;
	}
	// curl config syntax: header = "value" — escape \ and " in the value.
	let esc = "";
	let i = 0;
	while (i < secret.length) {
		let c = secret.substr(i, 1);
		if (c == "\\" || c == "\"") { esc = esc + "\\"; }
		esc = esc + c;
		i = i + 1;
	}
	setenv("WITCHGRID_CURL_CFG_LINE",
		"header = \"Authorization: Bearer " + esc + "\"");
	setenv("WITCHGRID_CURL_CFG_PATH", path);
	try {
		// rm first so the file is recreated under umask 077 even if an
		// old copy exists with looser permissions.
		let r = exec_argv(["sh", "-c",
			"umask 077 && rm -f \"$WITCHGRID_CURL_CFG_PATH\""
			+ " && printf '%s\\n' \"$WITCHGRID_CURL_CFG_LINE\""
			+ " > \"$WITCHGRID_CURL_CFG_PATH\""]);
		if (r.exit_code != 0) {
			eprint("[auth] could not write curl auth config at " + path
				+ " (exit " + r.exit_code
				+ ") — fan-outs fall back to header-in-argv");
		}
	} catch (e) {
		eprint("[auth] could not write curl auth config at " + path
			+ ": " + e + " — fan-outs fall back to header-in-argv");
	}
	unsetenv("WITCHGRID_CURL_CFG_LINE");
	unsetenv("WITCHGRID_CURL_CFG_PATH");
	return null;
}

fn init_auth(): null {
	let s = shared_secret();
	if (s.length > 0) {
		print("[auth] enabled (shared bearer; "
			+ s.length + "-char secret)");
		print("[auth] read surface (/nodes, /ui/*, /api/state, …): "
			+ (auth_protect_read()
				? "bearer required (WITCHGRID_AUTH_PROTECT_READ)"
				: "public — set WITCHGRID_AUTH_PROTECT_READ=1 to gate"));
		print("[auth] inference plane (/v1/llama/*): "
			+ (auth_protect_inference()
				? "bearer required (WITCHGRID_AUTH_PROTECT_INFERENCE)"
				: "public — set WITCHGRID_AUTH_PROTECT_INFERENCE=1 to gate"));
	} else {
		eprint("[auth] DISABLED — WITCHGRID_SHARED_SECRET is unset, so EVERY "
			+ "endpoint (spawn, stop, model pull/delete, register, /mcp) is open "
			+ "to anyone who can reach this port. Set it on the CP and every "
			+ "agent to enable auth; only run without it on a fully trusted LAN.");
		if (auth_protect_read() || auth_protect_inference()) {
			eprint("[auth] WARNING: WITCHGRID_AUTH_PROTECT_READ/"
				+ "_INFERENCE set without WITCHGRID_SHARED_SECRET "
				+ "— they have no effect until a secret is set");
		}
	}
	write_curl_auth_cfg();
	return null;
}

fn auth_match(provided: string): bool {
	let secret = shared_secret();
	if (secret == "") { return true; }
	if (provided == null || provided.length == 0) { return false; }
	let prefix = "Bearer ";
	if (provided.length < prefix.length) { return false; }
	if (provided.substr(0, prefix.length) != prefix) { return false; }
	let raw = provided.substr(prefix.length, provided.length - prefix.length);
	return sha256(raw) == sha256(secret);
}

// Dispatcher hook. Returns null when the request may proceed, or a
// 401 response object when not. Three route tiers (when SHARED_SECRET
// is set):
//
//   public: true        always open — health, static dashboard shell/
//                       assets (baked-in, no fleet data).
//   scope: "read"       data-bearing read-only surface — open by
//                       default, gated when WITCHGRID_AUTH_PROTECT_READ
//                       is set.
//   scope: "inference"  /v1/llama/* data plane — open by default, gated
//                       when WITCHGRID_AUTH_PROTECT_INFERENCE is set.
//   (no flag)           the mutating control surface — always needs
//                       the bearer.
//
// Two acceptable token locations:
//   1. `Authorization: Bearer <secret>` header — preferred path used
//      by curl, browser fetch(), the dashboard, future API consumers.
//   2. `_auth_token` field in the JSON body — workaround used by
//      CP↔agent (Hemlock's libwebsockets POST wrapper drops arbitrary
//      headers; only Content-Type makes it through). Body fallback
//      is the in-band equivalent. To remove once a Hemlock POST-with-
//      headers runtime fn lands.
fn cp_auth_check(req, route) {
	if (shared_secret() == "") { return null; }
	if (route?.public == true) { return null; }
	let scope = route?.scope;
	if (scope == "read" && !auth_protect_read()) { return null; }
	if (scope == "inference" && !auth_protect_inference()) { return null; }
	let header = req?.headers?["authorization"] ?? "";
	if (auth_match(header)) { return null; }
	// Body fallback for Hemlock-originated POSTs.
	if (req?.body != null && req.body.length > 0
		&& req.body.length < 1048576) {
		try {
			let payload = parse(req.body);
			let tok = payload?._auth_token;
			if (tok != null && auth_match("Bearer " + tok)) { return null; }
		} catch (e) { }
	}
	return { status: 401,
		body: "{\"error\":\"unauthorized\"}",
		headers: { "content-type": "application/json",
			"www-authenticate": "Bearer realm=\"witchgrid\"" } };
}

// Outbound auth — every CP→agent call goes through these wrappers
// so they pick up the bearer automatically when the secret is set.
// Same response shape as the underlying @stdlib/http calls.
//
// POSTs add `_auth_token` to the body (Hemlock workaround); GETs
// use the headers list (which Hemlock's libwebsockets wrapper does
// pass through for GET).
//
// Both go through the explicit-timeout variants with a 60s budget.
// Hemlock 2.4.0 dropped the default lws timeout to 5s — fine for
// short ad-hoc calls, but spawning a 12B model needs 5-30s for the
// agent's bind probe to return after CUDA init + safetensors load.
let CP_AGENT_TIMEOUT_MS = 60000;

fn cp_post_json(url: string, data) {
	let secret = shared_secret();
	let payload = json_tree(data);
	if (secret != "" && payload != null) { payload["_auth_token"] = secret; }
	let body = stringify(payload);
	let h = ["Content-Type: application/json"];
	if (secret != "") { h.push("Authorization: Bearer " + secret); }
	return http_request_timeout("POST", url, body, h, CP_AGENT_TIMEOUT_MS);
}
fn cp_get(url: string) {
	let h = [];
	let secret = shared_secret();
	if (secret != "") { h.push("Authorization: Bearer " + secret); }
	return http_request_timeout("GET", url, "", h, CP_AGENT_TIMEOUT_MS);
}
// Short-timeout GET for DASHBOARD fan-outs (events/services snapshots).
// These hit every agent; one slow/just-unreachable node (e.g. a box that
// fell asleep but is still inside the 90s stale window) would otherwise
// stall the whole snapshot ~20s on the OS connect timeout — making the
// dashboard (and the SSE stream every page opens) appear to hang.
//
// Uses curl, NOT the lws client: lws's request timeout does NOT bound the
// TCP connect, so a SYN black-hole still blocks ~20s. curl --connect-timeout
// caps it hard at 3s. All fan-out callers try/catch, so a connect failure
// (curl exit 28) just skips that node from the snapshot.
fn cp_get_fast(url: string): object {
	let args = ["curl", "-sS", "--connect-timeout", "3", "--max-time", "6",
		"-w", "\n%{http_code}"];
	let secret = shared_secret();
	if (secret != "") {
		// Bearer via the 0600 config file (see write_curl_auth_cfg) so
		// the secret stays out of /proc/<pid>/cmdline. Header-in-argv
		// only as a fallback when the config couldn't be written.
		let cfg = curl_auth_cfg_path();
		if (exists(cfg)) {
			args.push("-K"); args.push(cfg);
		} else {
			args.push("-H"); args.push("Authorization: Bearer " + secret);
		}
	}
	args.push(url);
	let r = exec_argv(args);
	if (r.exit_code != 0) { throw "curl exit " + r.exit_code + " for " + url; }
	let out = r.output;
	let nl = -1;
	let i = 0;
	while (i < out.length) { if (out.substr(i, 1) == "\n") { nl = i; } i = i + 1; }
	let body = (nl >= 0) ? out.substr(0, nl) : out;
	let code_str = (nl >= 0) ? out.substr(nl + 1, out.length - nl - 1).trim() : "";
	let code = 0;
	try { code = i32(code_str); } catch (e) { code = 0; }
	return { status_code: code, body: body };
}
fn cp_put_json(url: string, data) {
	let secret = shared_secret();
	let payload = data;
	if (secret != "" && payload != null) { payload["_auth_token"] = secret; }
	let body = stringify(payload);
	let h = ["Content-Type: application/json"];
	if (secret != "") { h.push("Authorization: Bearer " + secret); }
	return http_request_timeout("PUT", url, body, h, CP_AGENT_TIMEOUT_MS);
}

// One global db handle — cp.hml is small enough to live with it.
let DB = null;

fn init_db(db): null {
	exec(db, "create table if not exists nodes ("
		+ "node_id text primary key,"
		+ "hostname text not null,"
		+ "role text not null,"
		+ "hardware_json text not null,"
		+ "agent_url text,"
		+ "registered_at text not null,"
		+ "last_seen_at text not null,"
		+ "state text not null default 'active',"  // active | disabled | draining
		+ "runtime_json text"                       // {llama_server: {...}}
		+ ")", []);
	// Migrations for DBs that predate v0.7 columns (state, runtime_json).
	// SQLite errors if the column exists; wrap in try to make idempotent.
	try { exec(db, "alter table nodes add column state text not null default 'active'", []); } catch (e) { }
	try { exec(db, "alter table nodes add column runtime_json text", []); } catch (e) { }
	// auto_restart: the agent's watchdog toggle, mirrored from each
	// heartbeat (1/0, null for agents too old to report it). Display +
	// the toggle endpoint read this; the agent stays the source of truth.
	try { exec(db, "alter table nodes add column auto_restart integer", []); } catch (e) { }
	// agent_version: the witchgrid agent build each node runs, mirrored from
	// register. null = an agent too old to report it (→ "update" hint). Lets
	// the dashboard surface fleet version drift instead of it being silent.
	try { exec(db, "alter table nodes add column agent_version text", []); } catch (e) { }
	// local_services_json: the `local` engine services this node's agent
	// declares (public view: name, port, vram_mb, health_path, … — never
	// argv/env), replaced on every register. Placement for a `local`
	// profile reads it; null = an agent too old to report any.
	try { exec(db, "alter table nodes add column local_services_json text", []); } catch (e) { }
	// Measured GPU memory from the agent's heartbeat (newer agents):
	// service_vram_json — per-service { id, profile, port, gpus, vram_mb
	// {gpu: MB}, … }; gpu_usage_json — per-GPU { index, total_mb, used_mb,
	// services_mb, other_mb }. Replaced on every register.
	try { exec(db, "alter table nodes add column service_vram_json text", []); } catch (e) { }
	try { exec(db, "alter table nodes add column gpu_usage_json text", []); } catch (e) { }

	// Last measured VRAM per profile (or per shared-server member set), so
	// the layout planner can size a service it is about to start from what
	// it actually used last time instead of the GGUF estimate (which
	// overestimates hybrid models). Keyed by name; valid for the profile
	// fingerprint it was measured under (agent/fingerprint.hml). The
	// largest value seen for the same fingerprint + GPU set is kept
	// (compute buffers can grow after load, e.g. sd-server).
	exec(db, "create table if not exists profile_vram ("
		+ "key text primary key,"            // profile name | shared:<group>|<member fps>
		+ "fp text not null,"                // fingerprint the numbers are valid for
		+ "node_id text,"
		+ "gpus_json text,"                  // GPU set it was measured on
		+ "vram_json text not null,"         // { "<gpu>": MB }
		+ "total_mb integer not null,"
		+ "startup_s real,"                  // last measured time-to-healthy (layout apply)
		+ "est_mb real,"                     // GGUF estimate for the measured profile (scaling)
		+ "measured_at text not null"
		+ ")", []);

	try { exec(db, "alter table profile_vram add column est_mb real", []); } catch (e) { }

	// Last good GET /services answer per node. When an agent can't be
	// reached (restarting, busy) GET /services serves these entries marked
	// stale instead of silently dropping the node's services.
	exec(db, "create table if not exists node_services_cache ("
		+ "node_id text primary key,"
		+ "body text not null,"
		+ "fetched_at text not null"
		+ ")", []);

	// Layout apply runs (POST /api/layout/apply): request, status, step log.
	exec(db, "create table if not exists layout_runs ("
		+ "id text primary key,"
		+ "status text not null,"            // running | done | noop | failed | rolled_back
		+ "request_json text not null,"
		+ "plan_json text,"
		+ "log_json text,"
		+ "result_json text,"
		+ "started_at text not null,"
		+ "finished_at text"
		+ ")", []);
	// Per-node GGUF catalog. Replaced wholesale on each /register so we
	// don't accumulate stale entries when an operator deletes a model
	// from disk. Indexed on alias for the placement-time "which nodes
	// have this model?" lookup.
	exec(db, "create table if not exists node_models ("
		+ "node_id text not null,"
		+ "alias text not null,"
		+ "path text not null,"
		+ "size_mb integer not null,"
		+ "architecture text,"
		+ "n_layers integer,"
		+ "n_heads integer,"
		+ "n_kv_heads integer,"
		+ "embedding_length integer,"
		+ "claimed_context integer,"
		+ "general_name text,"
		+ "source_url text,"
		+ "primary key (node_id, alias)"
		+ ")", []);
	exec(db, "create index if not exists ix_node_models_alias on node_models(alias)", []);

	// Hardware time-series for sparklines. One row per (metric, series)
	// per heartbeat. Pruned to last 1hr each ingest. Tiny table —
	// 1 node × (4 GPUs + 1 RAM + N disks) × 120 samples ≈ 700 rows.
	//
	//   metric: 'gpu_free_mb' | 'gpu_power_w' | 'gpu_temp_c'
	//         | 'ram_free_mb' | 'cpu_temp_c' | 'disk_free_mb'
	//   series: gpu_index as text, disk path, or null for ram/cpu
	exec(db, "create table if not exists node_samples ("
		+ "node_id text not null,"
		+ "metric text not null,"
		+ "series text,"
		+ "value integer not null,"
		+ "sampled_at text not null"
		+ ")", []);
	exec(db, "create index if not exists ix_samples_lookup "
		+ "on node_samples(node_id, metric, series, sampled_at)", []);

	// Unmanaged GPU processes (slice C5). Replace-all-per-node every
	// heartbeat — same model as node_models. These are processes
	// nvidia-smi sees holding vram that witchgrid did NOT spawn
	// (e.g. another user's llama-server, jupyter). Surfaced in the
	// dashboard so operators understand "free vram" properly.
	exec(db, "create table if not exists node_unmanaged_procs ("
		+ "node_id text not null,"
		+ "pid integer not null,"
		+ "process_name text not null,"
		+ "vram_mb integer not null,"
		+ "gpu_index integer,"
		+ "owner_uid integer,"
		+ "owner_name text,"
		+ "ports text,"               // JSON array of listening ports (newer agents)
		+ "cmdline text,"             // full argv (newer agents)
		+ "observed_at text not null,"
		+ "primary key (node_id, pid)"
		+ ")", []);
	// Migrate pre-existing DBs: add the ports/cmdline columns if absent.
	// sqlite errors when the column already exists — swallow that.
	try { exec(db, "alter table node_unmanaged_procs add column ports text", []); } catch (e) { }
	try { exec(db, "alter table node_unmanaged_procs add column cmdline text", []); } catch (e) { }

	// Profiles. CP-owned now (was baked into agent binaries pre-v0.7).
	// CRUD via /api/profiles[/{name}]; spawns get the full profile JSON
	// inline so agents don't need to know what profiles exist.
	// version bumps on every PUT; agents tag their service rows with
	// the version that was current at spawn time.
	// Bench runs. CP-orchestrated benchmarks of (node × profile ×
	// build) combos. Each run pin-spawns the profile on a target
	// node, fires N timed completion requests, records aggregate
	// stats, stops the service. Results live forever (operator can
	// purge manually) — disk cost is rounding error.
	exec(db, "create table if not exists bench_runs ("
		+ "id text primary key,"
		+ "node_id text not null,"
		+ "profile_name text not null,"
		+ "build_hash text,"                     // captured at spawn time from /nodes
		+ "prompt text not null,"
		+ "n_predict integer not null,"
		+ "repetitions integer not null,"
		+ "ttft_ms_median real,"                 // time-to-first-token median across reps
		+ "tok_per_sec_median real,"             // tokens/sec median across reps
		+ "total_ms_median real,"
		+ "tokens_predicted_median integer,"
		+ "output_excerpt text,"                 // first rep's output, first 500 chars
		+ "status text not null,"                // queued|spawning|running|complete|error
		+ "error text,"
		+ "started_at text not null,"
		+ "completed_at text"
		+ ")", []);

	exec(db, "create table if not exists profiles ("
		+ "name text primary key,"
		+ "profile_json text not null,"
		+ "version integer not null default 1,"
		+ "created_at text not null,"
		+ "updated_at text not null"
		+ ")", []);

	// Profile aliases — public-facing names that resolve to a real
	// profile. Lets operators rename profiles without breaking
	// consumer URLs (e.g. FlameWorker pointing at
	// /v1/llama/flame-chat/completion). The alias is the URL token,
	// the target is the actual profiles.name. Many aliases can point
	// at one profile; one alias points at one profile (it's not a
	// fan-out / load-balancer).
	exec(db, "create table if not exists profile_aliases ("
		+ "alias_name text primary key,"
		+ "target_profile text not null,"
		+ "created_at text not null,"
		+ "updated_at text not null"
		+ ")", []);

	// Runtime-tunable settings — config that an operator should be
	// able to flip without restarting CP (or even SSHing). Single
	// table, key/value, all values stored as strings; consumers
	// parse to the type they want.
	exec(db, "create table if not exists cp_settings ("
		+ "key text primary key,"
		+ "value text not null,"
		+ "updated_at text not null"
		+ ")", []);

	// Cache of scraped HF model cards (metadata + validated image URL), so
	// browsing/expanding the same repo doesn't re-hit HuggingFace each time.
	// Keyed by repo; refreshed when older than the TTL (see handle_hf_card).
	exec(db, "create table if not exists hf_card_cache ("
		+ "repo text primary key,"
		+ "card_json text not null,"
		+ "fetched_at text not null"
		+ ")", []);

	seed_default_profiles(db);
	seed_default_settings(db);
	reap_stale_bench_runs(db);
	return null;
}

// Settings defaults. Insert-or-ignore so an operator's prior edits
// survive a CP upgrade — only fills in keys that don't exist yet.
fn seed_default_settings(db): null {
	let now = iso_now();
	let defaults = [
		// 0 disables backups. Reasonable production value: 60 (hourly).
		{ k: "db_backup_interval_min", v: "0" },
		// Where backups land. Path is relative to CP's working dir
		// (next to witchgrid.db) so it works without changes when
		// the operator hasn't thought about storage layout.
		{ k: "db_backup_dir",          v: "./backups" },
		// How many .bak files to keep. Older ones get pruned after
		// each new backup. Default 24 = one day at hourly cadence.
		{ k: "db_backup_keep",         v: "24" },
		// Stamped after each successful backup; surfaced in the
		// dashboard so operators can see the loop is alive.
		{ k: "db_backup_last_at",      v: "" },
		{ k: "db_backup_last_path",    v: "" },
		// Trusted HuggingFace quant authors — drives the catalog discovery
		// filter. Comma-separated org/user handles.
		{ k: "hf_trusted_authors",     v: "bartowski,mradermacher,TheBloke,unsloth,QuantFactory,lmstudio-community" },
	];
	for (d in defaults) {
		exec(db,
			"insert or ignore into cp_settings (key, value, updated_at) "
			+ "values (?, ?, ?)",
			[d.k, d.v, now]);
	}
	return null;
}

// ── profile aliases (consumer-facing name indirection) ─────────────
//
// Resolves a public-facing name to a real profile. If the name is
// in profile_aliases, returns the target_profile. Otherwise returns
// the name unchanged so direct profile names still work — aliases
// are additive, never replace the "look up by literal name" path.

fn resolve_profile_name(name: string): string {
	let r = query(DB,
		"select target_profile from profile_aliases where alias_name = ?",
		[name]);
	if (r.length == 0) { return name; }
	return r[0].target_profile;
}

fn handle_list_profile_aliases(req): object {
	let rows = query(DB,
		"select alias_name, target_profile, created_at, updated_at "
		+ "from profile_aliases order by alias_name", []);
	let out = [];
	for (r in rows) { out.push(r); }
	return { status: 200, body: stringify(out) };
}

// PUT /api/profile-aliases — body { alias_name, target_profile }.
// Upsert by alias_name. Validates that target_profile actually
// exists; returns 422 otherwise so the operator catches typos
// before consumers start hitting 503s.
fn handle_upsert_profile_alias(req): object {
	let payload = parse(req?.body ?? "{}");
	let alias = payload?.alias_name;
	let target = payload?.target_profile;
	if (alias == null || alias == "" || target == null || target == "") {
		return { status: 400, body: stringify({
			error: "alias_name + target_profile required" })};
	}
	let exists_p = query(DB, "select 1 from profiles where name = ?", [target]);
	if (exists_p.length == 0) {
		return { status: 422, body: stringify({
			error: "no profile named '" + target + "' — alias must "
				+ "point at an existing profile" })};
	}
	// Reject self-aliases (trivially confusing) and aliases that
	// shadow an existing profile name (would never be hit since
	// resolve_profile_name only fires when name is in the alias
	// table — but easier to just refuse than explain later).
	if (alias == target) {
		return { status: 422, body: stringify({
			error: "alias_name == target_profile is a no-op" })};
	}
	let exists_a = query(DB, "select 1 from profiles where name = ?", [alias]);
	if (exists_a.length > 0) {
		return { status: 422, body: stringify({
			error: "alias '" + alias + "' shadows an existing profile name" })};
	}
	let now = iso_now();
	exec(DB,
		"insert into profile_aliases (alias_name, target_profile, created_at, updated_at) "
		+ "values (?, ?, ?, ?) "
		+ "on conflict(alias_name) do update set "
		+ "target_profile=excluded.target_profile, "
		+ "updated_at=excluded.updated_at",
		[alias, target, now, now]);
	return { status: 200, body: stringify({
		alias_name: alias, target_profile: target })};
}

fn handle_delete_profile_alias(req): object {
	let prefix = "/api/profile-aliases/";
	let alias = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (alias.length == 0) {
		return { status: 400, body: "{\"error\":\"alias name required\"}" };
	}
	exec(DB, "delete from profile_aliases where alias_name = ?", [alias]);
	return { status: 204, body: "" };
}

// ── settings (cp_settings table) ────────────────────────────────────

fn setting_get(key: string, default_value: string): string {
	let r = query(DB, "select value from cp_settings where key = ?", [key]);
	if (r.length == 0) { return default_value; }
	return r[0].value;
}

fn setting_set(key: string, value: string): null {
	exec(DB,
		"insert into cp_settings (key, value, updated_at) values (?, ?, ?) "
		+ "on conflict(key) do update set value=excluded.value, updated_at=excluded.updated_at",
		[key, value, iso_now()]);
	return null;
}

fn handle_list_settings(req): object {
	let rows = query(DB, "select key, value, updated_at from cp_settings order by key", []);
	let out = {};
	for (r in rows) {
		out[r.key] = { value: r.value, updated_at: r.updated_at };
	}
	return { status: 200, body: stringify(out),
		headers: { "content-type": "application/json" } };
}

// GET /api/config — unified config snapshot for the settings page:
// the editable cp_settings plus the read-only, env-derived runtime knobs
// (bind, auth posture, stale threshold, version). The secret itself is
// never exposed — only whether auth is on.
fn handle_get_config(req): object {
	let settings = {};
	let rows = query(DB, "select key, value from cp_settings order by key", []);
	for (r in rows) { settings[r.key] = r.value; }
	let cfg = {
		version:            WITCHGRID_VERSION,
		host:               HOST,
		port:               PORT,
		auth_enabled:       shared_secret().length > 0,
		auth_protect_read:      auth_protect_read(),
		auth_protect_inference: auth_protect_inference(),
		stale_node_seconds: STALE_NODE_SECONDS,
		hf_trusted_authors: setting_get("hf_trusted_authors", ""),
		settings:           settings,
	};
	return { status: 200, body: stringify(cfg),
		headers: { "content-type": "application/json" } };
}

// PUT /api/settings — body is { key1: value1, key2: value2 }. All
// values stored as strings; consumers parse to their own type.
// Allowed keys gated by an explicit allowlist so the operator can't
// accidentally set arbitrary keys (and to make removal safe later).
let SETTING_KEYS_ALLOWED = ["db_backup_interval_min", "db_backup_dir", "db_backup_keep", "hf_trusted_authors"];

fn handle_update_settings(req): object {
	let payload = parse(req?.body ?? "{}");
	let updated = [];
	for (k in payload.keys()) {
		let allowed = false;
		for (a in SETTING_KEYS_ALLOWED) { if (a == k) { allowed = true; } }
		if (!allowed) { continue; }
		setting_set(k, "" + payload[k]);
		updated.push(k);
	}
	return { status: 200, body: stringify({ updated: updated }) };
}

// ── sqlite auto-backup ──────────────────────────────────────────────
//
// Background task that VACUUMs CP's sqlite into a fresh .bak file
// every db_backup_interval_min minutes. 0 disables the loop. Runs on
// CP boot; reads settings each tick so live edits take effect on
// the next interval boundary. Pruning keeps the most recent
// db_backup_keep files; older ones get unlinked.
//
// VACUUM INTO is atomic from SQLite's POV — produces a clean copy
// of the DB at a consistent point in time, no torn pages even if
// CP is mid-write. The dest file must NOT exist (sqlite refuses to
// overwrite), so each backup gets a unique unix-ms suffix.

fn safe_dir_path(d: string): bool {
	// Only allow paths made of alphanumerics, /, ., -, _ to keep
	// SQL injection out of the VACUUM INTO statement (which can't
	// be parameterized). Operator-controlled but operator-trusted —
	// this is defence-in-depth, not a security boundary.
	if (d.length == 0 || d.length > 256) { return false; }
	let i = 0;
	while (i < d.length) {
		let c = d[i];
		let ok = (c >= 'a' && c <= 'z')
			|| (c >= 'A' && c <= 'Z')
			|| (c >= '0' && c <= '9')
			|| c == '/' || c == '.' || c == '-' || c == '_';
		if (!ok) { return false; }
		i = i + 1;
	}
	return true;
}

async fn db_backup_loop(): null {
	loop {
		// Read settings every tick so changes apply on the next
		// boundary without bouncing CP.
		let interval_str = setting_get("db_backup_interval_min", "0");
		let interval_min: i32 = i32(interval_str);
		if (interval_min < 1) {
			// Disabled. Poll the setting once a minute so an
			// operator flipping it on doesn't have to wait the
			// previous interval to elapse.
			sleep(60.0);
			continue;
		}

		sleep(f64(interval_min) * 60.0);

		let dir = setting_get("db_backup_dir", "./backups");
		if (!safe_dir_path(dir)) {
			eprint("[backup] refused: db_backup_dir contains unsafe chars: " + dir);
			continue;
		}
		// Ensure the dir exists (mkdir -p style).
		try { make_dirs(dir); } catch (e) {
			eprint("[backup] mkdir " + dir + " failed: " + e);
			continue;
		}

		let stamp_str = "" + unix_ms();
		let dest = dir + "/witchgrid.db.bak." + stamp_str;
		try {
			exec(DB, "vacuum into '" + dest + "'", []);
			print("[backup] wrote " + dest);
			setting_set("db_backup_last_at", iso_now());
			setting_set("db_backup_last_path", dest);
		} catch (e) {
			eprint("[backup] vacuum failed: " + e);
			continue;
		}

		// Prune oldest beyond keep. Scan dir, filter to our prefix,
		// sort by name (timestamp suffix sorts correctly), drop tail.
		let keep_str = setting_get("db_backup_keep", "24");
		let keep: i32 = i32(keep_str);
		if (keep < 1) { keep = 1; }
		try {
			let entries = list_dir(dir);
			let baks = [];
			let prefix = "witchgrid.db.bak.";
			for (e in entries) {
				if (e.starts_with(prefix)) { baks.push(e); }
			}
			// Sort lexicographically — timestamps are zero-padded
			// unix millis so newest = highest. After sort, oldest
			// at index 0.
			baks.sort();
			let to_drop: i32 = baks.length - keep;
			let i: i32 = 0;
			while (i < to_drop) {
				try { remove_file(dir + "/" + baks[i]); }
				catch (e) { eprint("[backup] prune failed: " + e); }
				i = i + 1;
			}
			if (to_drop > 0) {
				print("[backup] pruned " + to_drop + " old backup(s)");
			}
		} catch (e) {
			eprint("[backup] prune scan failed: " + e);
		}
	}
}

// Bench reaper. Anything left in 'running' for >10 min is almost
// certainly the victim of a CP restart (or an agent that vanished
// mid-bench), not an actively-progressing run. Mark it errored so
// the dashboard doesn't show phantom in-flight rows. Cosmetic but
// closes the "is this still going or did CP eat it?" question.
//
// Threshold: 10 min covers the longest realistic bench (e.g. 10
// repetitions × 30s/each + spawn overhead) with headroom. Real
// in-flight runs that briefly exceed it get marked errored on
// restart but their output_excerpt + medians stay populated if the
// task did get partway — operator can rerun.
fn reap_stale_bench_runs(db): null {
	let r = query(db,
		"select count(*) as n from bench_runs "
		+ "where status = 'running' "
		+ "and started_at < datetime('now', '-10 minutes')", []);
	let stale = r[0].n;
	if (stale > 0) {
		exec(db,
			"update bench_runs "
			+ "set status = 'error', "
			+ "    error = 'crashed mid-run during CP restart', "
			+ "    completed_at = datetime('now') "
			+ "where status = 'running' "
			+ "and started_at < datetime('now', '-10 minutes')", []);
		print("[cp] reaped " + stale + " stale bench_runs row(s)");
	}
	return null;
}

// Built-in profile defaults. Seeded into the profiles table on first
// CP boot (when the table is empty). After that, the operator owns
// the set — edits via the dashboard don't get clobbered by a CP
// restart. To re-seed, drop the rows manually and restart.
fn seed_default_profiles(db): null {
	// insert-or-ignore per name (see the loop below) rather than an
	// all-or-nothing "skip if any profile exists" guard. This means a CP
	// upgrade picks up newly-curated default profiles without clobbering
	// any an operator has edited (name is the PK; ON CONFLICT DO NOTHING
	// leaves an existing row untouched). Same precedent as
	// seed_default_settings. Trade-off: a default an operator deliberately
	// deleted reappears on the next boot — re-delete it, or set its
	// visibility to taste.
	let now = iso_now();
	let defaults = [
		{
			name: "chat-mahou",
			profile: {
				binary: "llama-server",
				intent: {
					context: 131072,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18080,
				context: 131072,
				kv_type: "q4_0",
				model_alias: "mahou-1.5-mistral-nemo-12b.q5_k_m",
				hf_source: {
					repo: "flammenai/Mahou-1.5-mistral-nemo-12B-GGUF",
					file: "Mahou-1.5-mistral-nemo-12b.Q5_K_M.gguf",
				},
				// default_model intentionally null — the path is
				// deployment-specific. Operators set it via the
				// dashboard editor if they want a legacy-path
				// fallback; model_alias + catalog resolution is the
				// modern path that doesn't pin to a filesystem
				// layout.
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// FlameGen designer profile. Tuned to match flammen.ai
			// production: CPU-only (gpu_layers: 0) so it can share a
			// box with chat without competing for VRAM, --jinja flag
			// required because FlameGen calls /v1/chat/completions
			// (not raw /completion) so llama-server needs to apply
			// the model's chat template server-side. ~38s per design
			// at Q8_0 on 8 threads — fine for the async creation
			// pipeline, would need GPU placement for sub-10s latency.
			name: "designer-cpu",
			profile: {
				binary: "llama-server",
				intent: {
					context: 4096,
					kv_cache_k: "q8_0",
					kv_cache_v: "q8_0",
					parallel_slots: 1,
					gpu_layers: 0,
				},
				extra_flags: ["--jinja"],
				default_port: 18081,
				context: 4096,
				kv_type: "q8_0",
				model_alias: "flamedesigner-qwen2.5-3b-v1.q8_0",
				hf_source: {
					repo: "mradermacher/FlameDesigner-Qwen2.5-3B-v1-GGUF",
					file: "FlameDesigner-Qwen2.5-3B-v1.Q8_0.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// Match flammen.ai production: CPU memory summarizer, q3_k_m
			// to keep RAM use reasonable, 16k context (the summary windows
			// are short — 32k was overkill). Pairs with chat-mahou via
			// the match_memories ingest path; runs on the same box as
			// designer-cpu so memory summarization doesn't compete with
			// chat for VRAM.
			name: "memory-phoenix",
			profile: {
				binary: "llama-server",
				intent: {
					context: 16384,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 0,
				},
				extra_flags: [],
				default_port: 18085,
				context: 16384,
				kv_type: "q4_0",
				model_alias: "phoenix-qwen2.5-7b-v1.q3_k_m",
				hf_source: {
					repo: "mradermacher/Phoenix-Qwen2.5-7B-v1-GGUF",
					file: "Phoenix-Qwen2.5-7B-v1.Q3_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// FlameGen image profile — stable-diffusion.cpp serving the
			// NikuMixXL4 SDXL anime checkpoint (converted to q8_0 GGUF).
			// sd-server has no context/kv/gpu-layers concepts so intent
			// is empty; --diffusion-fa enables flash attention. FlameGen
			// talks the A1111-compatible /sdapi/v1/txt2img on the
			// resolved base_url (resolve-then-connect, like designer).
			// context/kv_type are harmless scalars for CP code paths
			// that read profile.context / profile.kv_type.
			name: "image-niku",
			profile: {
				binary: "sd-server",
				intent: {},
				extra_flags: ["--diffusion-fa"],
				default_port: 19080,
				context: 0,
				kv_type: "f16",
				model_alias: "nikumixxl4.q8_0",
				hf_source: null,
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// Text-to-speech starter — piper serving an English voice.
			// Counterpart to audio-whisper-base; together they close the
			// audio loop (STT in / chat / TTS out). piper's HTTP server
			// expects --model <abs path to .onnx> at spawn (model files
			// aren't catalog-able, like sd-cpp/whisper-cpp); clone this
			// profile and point at a different rhasspy/piper-voices
			// model for a different voice/language.
			name: "tts-piper-en",
			profile: {
				binary: "piper",
				intent: {},
				extra_flags: ["--http"],
				default_port: 19095,
				context: 0,
				kv_type: "f16",
				model_alias: "piper-en_US-lessac-medium",
				hf_source: {
					repo: "rhasspy/piper-voices",
					file: "en/en_US/lessac/medium/en_US-lessac-medium.onnx",
				},
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// Speech-to-text starter — whisper.cpp serving the base.en
			// GGUF (~150 MB, fast on CPU and tiny on a GPU). Consumers
			// hit the OpenAI-compatible /v1/audio/transcriptions on the
			// resolved base_url. Whisper model files aren't catalog-able
			// (no LLM arch metadata, same situation as the SDXL GGUF in
			// image-niku) — spawn with the explicit `model: <abs path>`
			// pin or override default_model. Operators wanting a bigger
			// model duplicate this profile and point at e.g.
			// whisper-medium-q5_1.gguf or whisper-large-v3.gguf.
			name: "audio-whisper-base",
			profile: {
				binary: "whisper-server",
				intent: {},
				extra_flags: [],
				default_port: 19090,
				context: 0,
				kv_type: "f16",
				model_alias: "whisper-base-en.q5_1",
				hf_source: {
					repo: "ggml-org/whisper.cpp",
					file: "ggml-base.en-q5_1.bin",
				},
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// Embedding server — pure llama-server config, no engine
			// code. --embeddings flips the server into embedding mode;
			// --pooling mean suits sentence-embedding models. CPU
			// (gpu_layers 0) like designer/phoenix — embeddings are
			// cheap and shouldn't compete for VRAM. Consumers hit
			// /v1/embeddings on the resolved base_url (resolve-then-
			// connect, same as chat).
			name: "embed-nomic",
			profile: {
				binary: "llama-server",
				intent: {
					context: 8192,
					parallel_slots: 1,
					gpu_layers: 0,
				},
				extra_flags: ["--embeddings", "--pooling", "mean"],
				default_port: 18090,
				context: 8192,
				kv_type: "f16",
				model_alias: "nomic-embed-text-v1.5.q8_0",
				hf_source: {
					repo: "nomic-ai/nomic-embed-text-v1.5-GGUF",
					file: "nomic-embed-text-v1.5.Q8_0.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},
		{
			// Multimodal (vision) — also just a llama-server profile
			// pointed at a VL GGUF. No special flag: the agent
			// autoloads the model's co-located mmproj projector at
			// spawn (prefers the f16 projector). Consumers send
			// image_url content to /v1/chat/completions.
			name: "vision-qwen",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "f16",
					kv_cache_v: "f16",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18095,
				context: 32768,
				kv_type: "f16",
				model_alias: "qwen2.5-vl-7b-instruct.q8_0",
				hf_source: {
					repo: "ggml-org/Qwen2.5-VL-7B-Instruct-GGUF",
					file: "Qwen2.5-VL-7B-Instruct-Q8_0.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// ─── General-purpose starter profiles ─────────────────────────
		// Vendor-neutral, broadly-useful llama-server configs pointed at
		// well-known GGUFs from bartowski (a default-trusted quanter). The
		// flammen.ai profiles above are real production config kept as
		// worked examples; these are the "what would I actually run"
		// starters: VRAM tiers for general chat, a reasoning model, a
		// coding model, plus two trade-off variants on the 8B workhorse.
		// All default_device "auto" (GPU when present; clone with
		// device=cpu for a CPU-only node). All Q4_K_M unless the name says
		// otherwise — the quality/size sweet spot. VRAM figures in the
		// comments are weights + a modest KV at the stated context.

		// Small chat — ~2 GB weights. Runs on a CPU box or any 8 GB GPU,
		// fast. The "always fits" baseline. q8_0 KV (cheap at 3B) keeps
		// quality high.
		{
			name: "chat-llama3.2-3b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "q8_0",
					kv_cache_v: "q8_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18100,
				context: 32768,
				kv_type: "q8_0",
				model_alias: "llama-3.2-3b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Llama-3.2-3B-Instruct-GGUF",
					file: "Llama-3.2-3B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Mid chat — ~5 GB weights, the default workhorse. Comfortable on
		// a 12-16 GB GPU at 32k context with q4_0 KV + flash attention.
		{
			name: "chat-llama3.1-8b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18101,
				context: 32768,
				kv_type: "q4_0",
				model_alias: "meta-llama-3.1-8b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Meta-Llama-3.1-8B-Instruct-GGUF",
					file: "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Large chat — ~9 GB weights. A clear quality step up from 8B;
		// targets a 24 GB GPU at 32k context.
		{
			name: "chat-qwen2.5-14b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18102,
				context: 32768,
				kv_type: "q4_0",
				model_alias: "qwen2.5-14b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Qwen2.5-14B-Instruct-GGUF",
					file: "Qwen2.5-14B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// XL chat — ~20 GB weights, trades speed for quality. Tight on a
		// single 24 GB card (drop context if it won't place), comfortable
		// on 32-48 GB. Context kept at 16k so the KV cache fits alongside.
		{
			name: "chat-qwen2.5-32b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 16384,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18103,
				context: 16384,
				kv_type: "q4_0",
				model_alias: "qwen2.5-32b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Qwen2.5-32B-Instruct-GGUF",
					file: "Qwen2.5-32B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Same 8B, tuned for QUALITY over speed: Q6_K weights (~6.6 GB,
		// near-lossless vs Q4_K_M) and an f16-class q8_0 KV cache. Slower
		// and hungrier than chat-llama3.1-8b; reach for it when answer
		// fidelity matters more than tokens/sec or context length.
		{
			name: "chat-llama3.1-8b-quality",
			profile: {
				binary: "llama-server",
				intent: {
					context: 16384,
					kv_cache_k: "q8_0",
					kv_cache_v: "q8_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18104,
				context: 16384,
				kv_type: "q8_0",
				model_alias: "meta-llama-3.1-8b-instruct-q6_k",
				hf_source: {
					repo: "bartowski/Meta-Llama-3.1-8B-Instruct-GGUF",
					file: "Meta-Llama-3.1-8B-Instruct-Q6_K.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Same 8B, tuned for THROUGHPUT: 4 parallel slots so the server
		// handles concurrent requests, with an 8k window per slot (32k of
		// KV total). Trades single-request latency for aggregate
		// tokens/sec across users — the config for a shared serving box.
		// Reuses the Q4_K_M file (shares the alias with chat-llama3.1-8b,
		// so one pull covers both).
		{
			name: "chat-llama3.1-8b-serving",
			profile: {
				binary: "llama-server",
				intent: {
					context: 8192,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 4,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18105,
				context: 8192,
				kv_type: "q4_0",
				model_alias: "meta-llama-3.1-8b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Meta-Llama-3.1-8B-Instruct-GGUF",
					file: "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Reasoning — DeepSeek-R1 distilled into Qwen 14B (~9 GB weights).
		// Emits <think>…</think> chains, so give it room: 32k context.
		// Consumers should strip/handle the thinking block. Targets 24 GB.
		{
			name: "reason-deepseek-r1-14b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18110,
				context: 32768,
				kv_type: "q4_0",
				model_alias: "deepseek-r1-distill-qwen-14b-q4_k_m",
				hf_source: {
					repo: "bartowski/DeepSeek-R1-Distill-Qwen-14B-GGUF",
					file: "DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Coding (accessible) — Qwen2.5-Coder 7B (~4.7 GB weights). Strong
		// code model that fits a 12 GB GPU. 32k context for whole-file work;
		// q8_0 KV to keep code tokens crisp.
		{
			name: "code-qwen2.5-7b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 32768,
					kv_cache_k: "q8_0",
					kv_cache_v: "q8_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18120,
				context: 32768,
				kv_type: "q8_0",
				model_alias: "qwen2.5-coder-7b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Qwen2.5-Coder-7B-Instruct-GGUF",
					file: "Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},

		// Coding (quality) — Qwen2.5-Coder 32B (~20 GB weights). The
		// near-frontier local coding model; targets 32-48 GB. Context at
		// 16k so the KV cache fits beside the weights.
		{
			name: "code-qwen2.5-32b",
			profile: {
				binary: "llama-server",
				intent: {
					context: 16384,
					kv_cache_k: "q4_0",
					kv_cache_v: "q4_0",
					parallel_slots: 1,
					gpu_layers: 99,
					flash_attention: true,
				},
				extra_flags: [],
				default_port: 18121,
				context: 16384,
				kv_type: "q4_0",
				model_alias: "qwen2.5-coder-32b-instruct-q4_k_m",
				hf_source: {
					repo: "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
					file: "Qwen2.5-Coder-32B-Instruct-Q4_K_M.gguf",
				},
				default_model: null,
				default_device: "auto",
			},
		},
	];
	for (d in defaults) {
		// insert-or-ignore: only fills in default profiles whose name
		// doesn't already exist, so operator edits to a same-named profile
		// survive upgrades. See the note at the top of this function.
		exec(db,
			"insert or ignore into profiles (name, profile_json, version, created_at, updated_at) "
			+ "values (?, ?, 1, ?, ?)",
			[d.name, stringify(d.profile), now, now]);
	}
	print("[cp] ensured " + defaults.length + " default profiles (insert-or-ignore)");
	return null;
}

// How long we keep hardware samples. 1 hour at 30s heartbeat = 120
// samples per (node, metric, series) — tiny on disk, plenty for the
// dashboard's 30-min sparkline window with headroom.
let SAMPLE_RETENTION_SECONDS = 3600;

fn iso_now(): string {
	let r = query(DB, "select datetime('now') as ts", []);
	return r[0].ts;
}

// ── node registry ────────────────────────────────────────────────────

// Keep only the well-formed entries of an agent's local_services list,
// reduced to the fields the CP uses (placement, health, display). Agent
// data, but it lands in placement decisions and dashboard HTML, so shape
// it here once. Returns the JSON to store, or null when absent.
let MAX_LOCAL_SERVICES_PER_NODE = 256;

fn sanitize_local_services(list) {
	if (list == null || typeof(list) != "array") { return null; }
	let out = [];
	for (e in list) {
		if (out.length >= MAX_LOCAL_SERVICES_PER_NODE) { break; }
		if (e == null || typeof(e) != "object") { continue; }
		let name = e?.name;
		if (name == null || typeof(name) != "string" || !valid_local_name(name)) { continue; }
		let port = e?.port;
		if (!is_int_value(port) || port < 1 || port > 65535) { continue; }
		let hp = e?.health_path;
		if (hp == null || typeof(hp) != "string" || hp.length > 256 || !hp.starts_with("/")
			|| hp.find(" ") >= 0 || hp.find("\r") >= 0 || hp.find("\n") >= 0) { hp = "/health"; }
		let vram = e?.vram_mb ?? 0;
		if (!is_int_value(vram) || vram < 0 || vram > 1048576) { vram = 0; }
		let tmo = e?.startup_timeout_s ?? AUTOSPAWN_READY_TIMEOUT_SECONDS;
		if (!is_int_value(tmo) || tmo < 1 || tmo > 3600) { tmo = AUTOSPAWN_READY_TIMEOUT_SECONDS; }
		out.push({
			name:              name,
			description:       "" + (e?.description ?? ""),
			program:           "" + (e?.program ?? ""),
			port:              i32(port),
			health_path:       hp,
			vram_mb:           i32(vram),
			startup_timeout_s: i32(tmo),
		});
	}
	return stringify(out);
}

fn is_int_value(v): bool {
	let t = typeof(v);
	return t == "i32" || t == "i64" || t == "i16" || t == "i8"
		|| t == "u8" || t == "u16" || t == "u32" || t == "u64";
}

// Same rule as the agent's local_services.valid_service_name.
fn valid_local_name(name): bool {
	if (name == null || typeof(name) != "string") { return false; }
	if (name.length == 0 || name.length > 63) { return false; }
	let i = 0;
	while (i < name.length) {
		let c = name.substr(i, 1);
		let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9");
		if (i > 0 && (c == "-" || c == "_" || c == ".")) { ok = true; }
		if (!ok) { return false; }
		i = i + 1;
	}
	return true;
}

fn handle_register(req): object {
	let payload = parse(req.body);
	let node_id = payload?.node_id;
	let hostname = payload?.hostname;
	if (node_id == null || hostname == null) {
		return { status: 400, body: "{\"error\":\"node_id+hostname required\"}" };
	}

	let hw_json = stringify(payload?.hardware ?? {});
	let runtime_json = null;
	if (payload?.runtime != null) { runtime_json = stringify(payload.runtime); }
	let agent_url = payload?.agent_url;
	// agent_url is where every CP→agent call (spawn, stop, fan-outs) gets
	// sent — refuse anything that isn't a plain http(s) URL so a bogus
	// register can't point the CP's outbound RPC at an arbitrary scheme.
	if (agent_url != null && agent_url != "") {
		let u = "" + agent_url;
		if (!(u.starts_with("http://") || u.starts_with("https://"))
			|| u.length > 2048 || u.find(" ") >= 0
			|| u.find("\r") >= 0 || u.find("\n") >= 0) {
			return { status: 400,
				body: "{\"error\":\"agent_url must be a plain http(s) URL\"}" };
		}
		// The CP issues bearer-authenticated RPC to this host; refuse a
		// public/off-LAN target so a crafted register can't redirect that
		// traffic (and the shared secret) off-network. See host_is_lan.
		if (!host_is_lan(extract_host(u))) {
			return { status: 400,
				body: "{\"error\":\"agent_url host must be a LAN address (private or loopback)\"}" };
		}
	}
	let now = iso_now();

	// Note: we deliberately do NOT touch `state` on update — that's
	// operator-owned (set via PATCH /api/nodes/{id}). A heartbeat
	// shouldn't undo a manual disable. Insert path defaults to 'active'
	// via the column default.
	// auto_restart: null when the agent is too old to report it, so the
	// upsert coalesces to keep any previously-known value rather than
	// clobbering it to null on every heartbeat.
	let ar = payload?.auto_restart;
	let ar_val = (ar == null) ? null : (ar == true ? 1 : 0);
	let agent_ver = payload?.agent_version;
	let local_json = sanitize_local_services(payload?.local_services);
	let svram_json = null;
	if (payload?.service_vram != null && typeof(payload.service_vram) == "array") {
		svram_json = stringify(json_tree(payload.service_vram));
	}
	let gusage_json = null;
	if (payload?.gpu_usage != null && typeof(payload.gpu_usage) == "array") {
		gusage_json = stringify(json_tree(payload.gpu_usage));
	}
	exec(DB,
		"insert into nodes (node_id, hostname, role, hardware_json, agent_url, registered_at, last_seen_at, runtime_json, auto_restart, agent_version, local_services_json) "
		+ "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) "
		+ "on conflict(node_id) do update set "
		+ "hostname=excluded.hostname, role=excluded.role, "
		+ "hardware_json=excluded.hardware_json, agent_url=excluded.agent_url, "
		+ "last_seen_at=excluded.last_seen_at, "
		+ "runtime_json=excluded.runtime_json, "
		+ "auto_restart=coalesce(excluded.auto_restart, nodes.auto_restart), "
		+ "agent_version=coalesce(excluded.agent_version, nodes.agent_version), "
		+ "local_services_json=excluded.local_services_json",
		[node_id, hostname, payload?.role ?? "worker", hw_json, agent_url, now, now, runtime_json, ar_val, agent_ver, local_json]
	);
	if (svram_json != null || gusage_json != null) {
		exec(DB, "update nodes set service_vram_json = ?, gpu_usage_json = ? where node_id = ?",
			[svram_json, gusage_json, node_id]);
		if (payload?.service_vram != null) {
			try { record_measurements(node_id, payload.service_vram); } catch (e) {
				eprint("[vram] recording measurements from " + node_id + " failed: " + e);
			}
		}
	}

	// Catalog ingest. Replace-all-for-this-node so deleted models drop
	// out automatically — no separate /unregister-model bookkeeping.
	// Skipping silently when the field is absent keeps us compatible
	// with older agents that haven't been rebuilt yet.
	let models = payload?.models;
	if (models != null) {
		exec(DB, "delete from node_models where node_id = ?", [node_id]);
		for (m in models) {
			exec(DB,
				"insert into node_models (node_id, alias, path, size_mb, "
				+ "architecture, n_layers, n_heads, n_kv_heads, embedding_length, "
				+ "claimed_context, general_name, source_url) "
				+ "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
				[node_id, m.alias, m.path, m.size_mb,
				 m?.architecture, m?.n_layers, m?.n_heads, m?.n_kv_heads,
				 m?.embedding_length, m?.claimed_context,
				 m?.general_name, m?.source_url]);
		}
	}

	// Unmanaged-process ingest (slice C5). Replace-all-for-this-node
	// so a process that died between heartbeats drops out automatically.
	// Skipping silently when the field is absent keeps us compatible
	// with older agents that haven't been rebuilt yet.
	let unmanaged = payload?.unmanaged_processes;
	if (unmanaged != null) {
		exec(DB, "delete from node_unmanaged_procs where node_id = ?",
			[node_id]);
		for (u in unmanaged) {
			// ports comes as an array from newer agents; persist as JSON.
			// Older agents omit ports/cmdline → store null (rendered as "—").
			let ports_json = null;
			if (u?.ports != null) { ports_json = stringify(u.ports); }
			// nvidia-smi lists a process once PER GPU it uses (a tensor-split
			// server on 2-4 cards): one row per pid with the memory summed —
			// a plain insert hit the (node_id, pid) key and failed the whole
			// register, which then made the node go stale.
			exec(DB,
				"insert into node_unmanaged_procs "
				+ "(node_id, pid, process_name, vram_mb, gpu_index, "
				+ " owner_uid, owner_name, ports, cmdline, observed_at) "
				+ "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) "
				+ "on conflict(node_id, pid) do update set vram_mb = vram_mb + excluded.vram_mb",
				[node_id, u.pid, u.process_name, u.vram_mb,
				 u?.gpu_index, u?.owner_uid, u?.owner_name,
				 ports_json, u?.cmdline, now]);
		}
	}

	// Hardware time-series ingest. One row per metric per heartbeat;
	// the dashboard renders sparklines from these. Prune > 1hr at the
	// same time so the table stays bounded without a separate cron.
	let hw = payload?.hardware ?? {};
	if (hw?.gpus != null) {
		for (g in hw.gpus) {
			exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
				+ "values (?, 'gpu_free_mb', ?, ?, ?)",
				[node_id, "" + g.index, g.free_mb, now]);
			// power.draw is per-GPU watts; null for cards without a
			// power sensor (most consumer Apple GPUs, some old Teslas).
			if (g?.power_draw_w != null) {
				exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
					+ "values (?, 'gpu_power_w', ?, ?, ?)",
					[node_id, "" + g.index, g.power_draw_w, now]);
			}
			// temp °C per GPU; null on sensorless / Apple Metal cards.
			if (g?.temp_c != null) {
				exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
					+ "values (?, 'gpu_temp_c', ?, ?, ?)",
					[node_id, "" + g.index, g.temp_c, now]);
			}
		}
	}
	if (hw?.ram_free_mb != null) {
		exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
			+ "values (?, 'ram_free_mb', null, ?, ?)",
			[node_id, hw.ram_free_mb, now]);
	}
	// CPU package temp °C; null on macOS / sensorless boxes.
	if (hw?.cpu_temp_c != null) {
		exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
			+ "values (?, 'cpu_temp_c', null, ?, ?)",
			[node_id, hw.cpu_temp_c, now]);
	}
	if (hw?.disks != null) {
		for (d in hw.disks) {
			exec(DB, "insert into node_samples (node_id, metric, series, value, sampled_at) "
				+ "values (?, 'disk_free_mb', ?, ?, ?)",
				[node_id, d.path, d.free_mb, now]);
		}
	}
	exec(DB, "delete from node_samples where node_id = ? "
		+ "and sampled_at < datetime('now', ?)",
		[node_id, "-" + SAMPLE_RETENTION_SECONDS + " seconds"]);

	return { status: 200, body: stringify({
		node_id: node_id, registered_at: now, welcome: "joined the grid",
		catalog_count: (models != null ? models.length : 0),
	})};
}

// ── measured VRAM bookkeeping ────────────────────────────────────────

// A service has to be up this long before its measurement is trusted as
// "what this profile uses" (model + KV + compute buffers are allocated at
// load; a just-spawned process is still loading).
// WITCHGRID_MEASURE_MIN_UPTIME_S overrides it (tests).
let _mmu_env = getenv("WITCHGRID_MEASURE_MIN_UPTIME_S");
let MEASURE_MIN_UPTIME_S = (_mmu_env == null || _mmu_env.length == 0) ? 45 : i32(_mmu_env);

// profile_vram key + fingerprint for a measured service entry. A shared
// server's memory is keyed by its member set ("shared:<group>|a=fp,b=fp").
fn measurement_key(e) {
	let prof = "" + (e?.profile ?? "");
	if (prof.starts_with("shared:")) {
		let parts = [];
		for (m in (e?.members ?? [])) { parts.push(m.profile + "=" + m.fp); }
		if (parts.length == 0) { return null; }
		parts.sort();
		let k = prof + "|" + parts.join(",");
		return { key: k, fp: k };
	}
	return { key: prof, fp: "" + (e?.profile_fp ?? "") };
}

fn record_measurements(node_id: string, entries): null {
	for (e in entries) {
		if (e?.state != "running") { continue; }
		let total = i32(e?.vram_total_mb ?? 0);
		if (total <= 0) { continue; }
		if (i32(e?.uptime_s ?? 0) < MEASURE_MIN_UPTIME_S) { continue; }
		let mk = measurement_key(e);
		if (mk == null || mk.fp == "") { continue; }
		record_profile_vram(mk.key, mk.fp, node_id, e?.gpus ?? [], e?.vram_mb ?? {}, total);
		// The GGUF estimate for the profile this was measured under, so a
		// later version (e.g. half the context) can be sized by ratio.
		if (!("" + e.profile).starts_with("shared:")) {
			let p = fetch_profile_by_name(e.profile);
			if (p != null && profile_fp_of(p) == mk.fp) {
				let est = catalog_estimate_mb(node_id, p, profile_ctx(p), (e?.gpus ?? []).length);
				if (est > 0) {
					exec(DB, "update profile_vram set est_mb = ? where key = ?", [f64(est), mk.key]);
				}
			}
		}
	}
	return null;
}

// Keep the largest measurement for the same fingerprint + GPU set; a new
// fingerprint or GPU set replaces it.
fn record_profile_vram(key: string, fp: string, node_id: string, gpus, vram, total: i32): null {
	let gj = stringify(gpus);
	let ex = query(DB, "select fp, gpus_json, total_mb from profile_vram where key = ?", [key]);
	if (ex.length > 0 && ex[0].fp == fp && ex[0].gpus_json == gj && ex[0].total_mb >= total) {
		return null;
	}
	exec(DB,
		"insert into profile_vram (key, fp, node_id, gpus_json, vram_json, total_mb, measured_at) "
		+ "values (?, ?, ?, ?, ?, ?, datetime('now')) on conflict(key) do update set "
		+ "fp = excluded.fp, node_id = excluded.node_id, gpus_json = excluded.gpus_json, "
		+ "vram_json = excluded.vram_json, total_mb = excluded.total_mb, "
		+ "measured_at = excluded.measured_at",
		[key, fp, node_id, gj, stringify(vram), total]);
	return null;
}

fn record_startup_s(key: string, secs: f64): null {
	exec(DB,
		"insert into profile_vram (key, fp, vram_json, total_mb, startup_s, measured_at) "
		+ "values (?, '', '{}', 0, ?, datetime('now')) "
		+ "on conflict(key) do update set startup_s = excluded.startup_s",
		[key, secs]);
	return null;
}

fn profile_vram_row(key: string) {
	let r = query(DB, "select key, fp, node_id, gpus_json, vram_json, total_mb, startup_s, "
		+ "est_mb, measured_at from profile_vram where key = ?", [key]);
	if (r.length == 0) { return null; }
	let row = r[0];
	try { row["gpus"] = parse(row.gpus_json); } catch (e) { row["gpus"] = []; }
	try { row["vram"] = parse(row.vram_json); } catch (e) { row["vram"] = {}; }
	return row;
}

// Per-GPU view for /nodes: total/used/free plus which services hold what
// (from the last heartbeat's measurements). gpus: hardware.gpus.
fn gpus_with_usage(gpus, gusage, svram) {
	let out = [];
	for (g in (gpus ?? [])) {
		let used = g?.used_mb ?? (g.total_mb - g.free_mb);
		let svcs = [];
		let svc_mb = 0;
		for (e in (svram ?? [])) {
			let mb = e?.vram_mb?["" + g.index];
			if (mb == null || i32(mb) <= 0) { continue; }
			svcs.push({ id: e.id, profile: e.profile, port: e.port, mb: i32(mb),
				state: e?.state });
			svc_mb = svc_mb + i32(mb);
		}
		let other = used - svc_mb;
		if (other < 0) { other = 0; }
		g["used_mb"] = used;
		if (gusage != null) {
			g["services"] = svcs;
			g["services_mb"] = svc_mb;
			g["other_mb"] = other;
		}
		out.push(g);
	}
	return out;
}

fn handle_list_nodes(req): object {
	let rows = query(DB,
		"select node_id, hostname, role, hardware_json, agent_url, "
		+ "registered_at, last_seen_at, state, runtime_json, auto_restart, agent_version, "
		+ "local_services_json, service_vram_json, gpu_usage_json "
		+ "from nodes order by registered_at desc", []);
	let out = [];
	for (row in rows) {
		let hwobj = parse(row.hardware_json);
		let svram = null;
		let gusage = null;
		try { if (row?.service_vram_json != null) { svram = parse(row.service_vram_json); } } catch (e) { }
		try { if (row?.gpu_usage_json != null) { gusage = parse(row.gpu_usage_json); } } catch (e) { }
		if (hwobj?.gpus != null) { hwobj["gpus"] = gpus_with_usage(hwobj.gpus, gusage, svram); }
		let runtime = null;
		if (row?.runtime_json != null) {
			try { runtime = parse(row.runtime_json); } catch (e) { }
		}
		let local_services = [];
		if (row?.local_services_json != null) {
			try { local_services = parse(row.local_services_json); } catch (e) { }
		}
		out.push({
			node_id: row.node_id,
			hostname: row.hostname,
			role: row.role,
			hardware: hwobj,
			agent_url: row.agent_url,
			registered_at: row.registered_at,
			last_seen_at: row.last_seen_at,
			state: row?.state ?? "active",
			runtime: runtime,
			// tri-state: true/false from the agent, null when the agent
			// predates auto_restart reporting.
			auto_restart: (row?.auto_restart == null) ? null : (row.auto_restart == 1),
			agent_version: row?.agent_version,
			// `local` engine services this node declares (public view).
			local_services: local_services,
		});
	}
	return { status: 200, body: stringify(json_tree(out)) };
}

// PATCH /api/nodes/{node_id}  body: {state: "active"|"disabled"|"draining"}
//
// State semantics:
//   active    — placement targets this node normally
//   disabled  — placement skips entirely; existing services keep running
//               but operator should stop them; node still appears in
//               dashboard (with disabled badge) so operator can re-enable
//   draining  — placement skips for new spawns; existing services keep
//               running so in-flight requests finish; meant to be used
//               briefly before disable + restart for upgrades
//
// Disabled / draining nodes still serve catalog blobs + accept stop
// commands. The state only gates NEW spawn placement.
// ── llama_cpp proxies ────────────────────────────────────────────
//
// CP owns no state for llama_cpp installs — each agent does. These
// handlers forward to the chosen agent's /llama_cpp/* endpoints so
// the dashboard can drive them through one URL space (no need for
// the browser to know each agent's bind address).
//
// URL: /api/nodes/{node_id}/llama_cpp/{install,installed,activate}

fn parse_node_lcpp_path(path: string) {
	// path = "/api/nodes/<node_id>/llama_cpp/<action>"
	let prefix = "/api/nodes/";
	if (!path.starts_with(prefix)) { return null; }
	let rest = path.substr(prefix.length, path.length - prefix.length);
	let slash = rest.find("/");
	if (slash < 0) { return null; }
	let node_id = rest.substr(0, slash);
	let after = rest.substr(slash + 1, rest.length - slash - 1);
	if (!after.starts_with("llama_cpp/")) { return null; }
	let action = after.substr(10, after.length - 10);
	return { node_id: node_id, action: action };
}

fn handle_node_llama_cpp(req): object {
	let parsed = parse_node_lcpp_path(req.path);
	if (parsed == null) {
		return { status: 404, body: "{\"error\":\"expected /api/nodes/{id}/llama_cpp/{action}\"}" };
	}
	let agent_url = lookup_agent(parsed.node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + parsed.node_id }) };
	}
	let target = agent_url + "/llama_cpp/" + parsed.action;
	try {
		let resp = null;
		if (req.method == "GET") {
			resp = cp_get(target);
		} else {
			resp = cp_post_json(target, parse(req?.body ?? "{}"));
		}
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// PUT /api/nodes/{node_id}/auto-restart  body: { auto_restart: bool }
//
// Proxies to the agent's PUT /settings (the agent is the source of
// truth — it owns the watchdog), then mirrors the confirmed value onto
// the nodes row so the dashboard updates immediately instead of waiting
// for the next heartbeat. Returns the agent's response verbatim.
fn handle_node_auto_restart(req): object {
	let prefix = "/api/nodes/";
	let rest = req.path.substr(prefix.length, req.path.length - prefix.length);
	let slash = rest.find("/");
	if (slash < 0) {
		return { status: 404, body: "{\"error\":\"expected /api/nodes/{id}/auto-restart\"}" };
	}
	let node_id = rest.substr(0, slash);
	let payload = null;
	try { payload = parse(req?.body ?? "{}"); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	let ar = payload?.auto_restart;
	if (ar == null) {
		return { status: 400, body: "{\"error\":\"auto_restart (bool) required\"}" };
	}
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}
	try {
		let resp = cp_put_json(agent_url + "/settings", { auto_restart: ar == true });
		if (resp.status_code >= 200 && resp.status_code < 300) {
			exec(DB, "update nodes set auto_restart = ? where node_id = ?",
				[ar == true ? 1 : 0, node_id]);
		}
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

fn handle_patch_node(req): object {
	let prefix = "/api/nodes/";
	let node_id = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (node_id.length == 0) {
		return { status: 400, body: "{\"error\":\"node_id required\"}" };
	}
	let payload = null;
	try { payload = parse(req.body); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	let state = payload?.state;
	if (state != "active" && state != "disabled" && state != "draining") {
		return { status: 400, body: stringify({
			error: "state must be one of: active, disabled, draining",
		})};
	}
	let existing = query(DB, "select node_id from nodes where node_id = ?", [node_id]);
	if (existing.length == 0) {
		return { status: 404, body: stringify({ error: "no such node: " + node_id }) };
	}
	exec(DB, "update nodes set state = ? where node_id = ?", [state, node_id]);
	return { status: 200, body: stringify({ node_id: node_id, state: state }) };
}

fn handle_health(req): object {
	return { status: 200, body: stringify({ status: "ok", version: WITCHGRID_VERSION }) };
}

// GET /metrics — Prometheus text exposition. Built purely from the node
// data CP already collects each heartbeat (nodes_for_dashboard reads the
// DB), so a scrape never fans out to agents and stays fast + reliable
// regardless of agent reachability. Public, like /healthz — a scrape
// target, not a secret; lets Prometheus/Grafana watch the fleet's VRAM,
// node liveness, and the auto-restart watchdog state.
fn handle_metrics(req): object {
	let nodes = nodes_for_dashboard();

	// One accumulator per metric so we emit each HELP/TYPE block once and
	// stream all its series under it (Prometheus requires series of the
	// same name to be contiguous). Single pass over nodes/gpus.
	let m_node_up    = "";
	let m_last_seen  = "";
	let m_auto       = "";
	let m_ram_free   = "";
	let m_ram_total  = "";
	let m_cpu_cores  = "";
	let m_gpu_free   = "";
	let m_gpu_total  = "";
	let m_gpu_used   = "";
	let m_gpu_power  = "";
	let m_gpu_temp   = "";
	let m_cpu_temp   = "";

	for (n in nodes) {
		let nl = "{node=\"" + n.node_id + "\"}";
		let up = (n.age_seconds < STALE_NODE_SECONDS) ? "1" : "0";
		m_node_up   = m_node_up   + "witchgrid_node_up" + nl + " " + up + "\n";
		m_last_seen = m_last_seen + "witchgrid_node_last_seen_seconds" + nl + " " + n.age_seconds + "\n";

		let ar = n?.auto_restart;
		if (ar != null) {
			m_auto = m_auto + "witchgrid_node_auto_restart" + nl + " " + (ar == true ? "1" : "0") + "\n";
		}

		let hw = n?.hardware ?? {};
		if (hw?.ram_free_mb != null) {
			m_ram_free = m_ram_free + "witchgrid_node_ram_free_mb" + nl + " " + hw.ram_free_mb + "\n";
		}
		if (hw?.ram_total_mb != null) {
			m_ram_total = m_ram_total + "witchgrid_node_ram_total_mb" + nl + " " + hw.ram_total_mb + "\n";
		}
		if (hw?.cpu_cores != null) {
			m_cpu_cores = m_cpu_cores + "witchgrid_node_cpu_cores" + nl + " " + hw.cpu_cores + "\n";
		}
		if (hw?.cpu_temp_c != null) {
			m_cpu_temp = m_cpu_temp + "witchgrid_node_cpu_temp_celsius" + nl + " " + hw.cpu_temp_c + "\n";
		}

		let gpus = hw?.gpus ?? [];
		for (g in gpus) {
			let gl = "{node=\"" + n.node_id + "\",gpu=\"" + g.index + "\"}";
			m_gpu_free  = m_gpu_free  + "witchgrid_gpu_free_mb"  + gl + " " + g.free_mb + "\n";
			m_gpu_total = m_gpu_total + "witchgrid_gpu_total_mb" + gl + " " + g.total_mb + "\n";
			m_gpu_used  = m_gpu_used  + "witchgrid_gpu_used_mb"  + gl + " " + (g.total_mb - g.free_mb) + "\n";
			if (g?.power_draw_w != null) {
				m_gpu_power = m_gpu_power + "witchgrid_gpu_power_watts" + gl + " " + g.power_draw_w + "\n";
			}
			if (g?.temp_c != null) {
				m_gpu_temp = m_gpu_temp + "witchgrid_gpu_temp_celsius" + gl + " " + g.temp_c + "\n";
			}
		}
	}

	let out = ""
		+ "# HELP witchgrid_build_info Witchgrid version, value always 1\n"
		+ "# TYPE witchgrid_build_info gauge\n"
		+ "witchgrid_build_info{version=\"" + WITCHGRID_VERSION + "\"} 1\n"
		+ "# HELP witchgrid_up 1 if the control plane is serving requests\n"
		+ "# TYPE witchgrid_up gauge\n"
		+ "witchgrid_up 1\n"
		+ "# HELP witchgrid_nodes_total Number of registered nodes (fresh or stale)\n"
		+ "# TYPE witchgrid_nodes_total gauge\n"
		+ "witchgrid_nodes_total " + nodes.length + "\n"
		+ "# HELP witchgrid_node_up 1 if the node's last heartbeat is within " + STALE_NODE_SECONDS + "s\n"
		+ "# TYPE witchgrid_node_up gauge\n" + m_node_up
		+ "# HELP witchgrid_node_last_seen_seconds Seconds since the node's last heartbeat\n"
		+ "# TYPE witchgrid_node_last_seen_seconds gauge\n" + m_last_seen
		+ "# HELP witchgrid_node_auto_restart 1 if the agent's auto-restart watchdog is enabled\n"
		+ "# TYPE witchgrid_node_auto_restart gauge\n" + m_auto
		+ "# HELP witchgrid_node_cpu_cores CPU cores reported by the node\n"
		+ "# TYPE witchgrid_node_cpu_cores gauge\n" + m_cpu_cores
		+ "# HELP witchgrid_node_ram_free_mb Free system RAM (MB)\n"
		+ "# TYPE witchgrid_node_ram_free_mb gauge\n" + m_ram_free
		+ "# HELP witchgrid_node_ram_total_mb Total system RAM (MB)\n"
		+ "# TYPE witchgrid_node_ram_total_mb gauge\n" + m_ram_total
		+ "# HELP witchgrid_gpu_free_mb Free VRAM per GPU (MB)\n"
		+ "# TYPE witchgrid_gpu_free_mb gauge\n" + m_gpu_free
		+ "# HELP witchgrid_gpu_total_mb Total VRAM per GPU (MB)\n"
		+ "# TYPE witchgrid_gpu_total_mb gauge\n" + m_gpu_total
		+ "# HELP witchgrid_gpu_used_mb Used VRAM per GPU (MB)\n"
		+ "# TYPE witchgrid_gpu_used_mb gauge\n" + m_gpu_used
		+ "# HELP witchgrid_gpu_power_watts Current GPU power draw (W)\n"
		+ "# TYPE witchgrid_gpu_power_watts gauge\n" + m_gpu_power
		+ "# HELP witchgrid_gpu_temp_celsius Current GPU temperature (C)\n"
		+ "# TYPE witchgrid_gpu_temp_celsius gauge\n" + m_gpu_temp
		+ "# HELP witchgrid_node_cpu_temp_celsius Current CPU package temperature (C)\n"
		+ "# TYPE witchgrid_node_cpu_temp_celsius gauge\n" + m_cpu_temp;

	return { status: 200, body: out,
		headers: { "content-type": "text/plain; version=0.0.4; charset=utf-8" } };
}

// ── agent lookup ─────────────────────────────────────────────────────

// Returns the agent_url for node_id, or null if the node isn't registered
// or registered without an agent_url. Caller must check for null.
fn lookup_agent(node_id: string) {
	let rows = query(DB, "select agent_url from nodes where node_id = ?", [node_id]);
	if (rows.length == 0 || rows[0].agent_url == null) {
		return null;
	}
	return rows[0].agent_url;
}

// 90s = 3x the agent's 30s heartbeat interval. Gives one missed
// heartbeat of slack so a transient network blip doesn't drop a node
// out of placement, but a genuinely-dead agent falls out within a
// minute and a half. Override via WITCHGRID_STALE_NODE_SECONDS (tuning,
// or tests that need fast eviction); keep it ≳ 3x the agent's
// WITCHGRID_HEARTBEAT_SECONDS so a single missed beat doesn't flap.
let _stale_env = getenv("WITCHGRID_STALE_NODE_SECONDS");
let STALE_NODE_SECONDS = (_stale_env == null || _stale_env.length == 0) ? 90 : i32(_stale_env);

// Heartbeating, active, has an agent_url.
fn node_is_live(node_id): bool {
	if (node_id == null) { return false; }
	let r = query(DB,
		"select node_id from nodes where node_id = ? and agent_url is not null "
		+ "and state = 'active' and last_seen_at > datetime('now', ?)",
		["" + node_id, "-" + STALE_NODE_SECONDS + " seconds"]);
	return r.length > 0;
}

fn list_all_agents(): array {
	let rows = query(DB,
		"select node_id, agent_url from nodes "
		+ "where agent_url is not null "
		+ "and last_seen_at > datetime('now', ?)",
		["-" + STALE_NODE_SECONDS + " seconds"]);
	return rows;
}

// ── placement ────────────────────────────────────────────────────────
// First-fit. Walks every registered agent and every GPU on it, picks the
// first GPU whose free_mb ≥ required_mb. No bin-packing across multiple
// GPUs yet (single-GPU spawn only); we'll add tensor-parallel split when
// flammen.ai actually has a model that needs more VRAM than any single
// card on the fleet.

// fetch_profile: pre-v0.7 fan-out across agents (asking each agent's
// /profiles endpoint) is gone. Profiles live in CP's table now.
// Use fetch_profile_by_name() instead — it queries our own DB and
// returns the profile object with __name + __version stamped.
//
// Kept as a thin alias so existing callers don't all need touching.
fn fetch_profile(profile_name: string) {
	return fetch_profile_by_name(profile_name);
}

// Tensor-parallel overhead headroom. llama.cpp spreads weights across
// GPUs but each card still needs its own activation buffer + cuBLAS
// workspace, so the SUM of free VRAM across the chosen subset has to
// exceed the model's needed VRAM by a margin. 10% empirically covers
// the worst case I've seen on a 4-card box (Mahou-12B at 128K wants
// ~17 GB; 2× 4060 Ti split takes ~19 GB sum to be safe).
let MULTI_GPU_OVERHEAD_FRACTION: f64 = 0.10;

// Picks the smallest GPU subset whose summed free VRAM covers needed_mb
// + overhead. Within a given subset size, prefers the one with the most
// total_free as a tiebreaker (more headroom = less risk of OOM during
// tensor-parallel allocation).
//
// gpus: [{index, free_mb, total_mb, ...}]   (the node's full GPU list)
// needed_mb: f64                            (estimated VRAM the model needs)
//
// Returns null if no subset of any size fits, otherwise:
//   {
//     indices:      [i32, ...]   (gpu indices in sorted order)
//     tensor_split: [i32, ...]   (free_mb per gpu, in same order — passed
//                                 verbatim to llama-server's --tensor-split,
//                                 which interprets as relative weights)
//     total_free:   i32          (diagnostic)
//   }
//
// Bitmask enumeration: at N=4 we walk 15 subsets, at N=8 we'd walk 255.
// Both trivial. If we ever care about much larger fleets per box we'd
// switch to a smarter knapsack, but no homelab box has that many GPUs.
fn pick_gpu_subset(gpus, needed_mb: f64) {
	let n = gpus.length;
	if (n == 0) { return null; }
	let needed_with_overhead: f64 = needed_mb * (1.0 + MULTI_GPU_OVERHEAD_FRACTION);

	// Try subset sizes 1..n. Within each size pick the one with most
	// total_free (best headroom). Smallest-set-first dodges the
	// degenerate case where the algorithm spreads a small model across
	// every GPU — one card is cheaper than four.
	let target_size = 1;
	while (target_size <= n) {
		let best_indices = null;
		let best_split = null;
		let best_total: i32 = -1;

		// Walk every bitmask of length n; keep only those with the right
		// popcount AND enough summed free.
		let mask = 1;
		let max_mask = 1;
		let i = 0;
		while (i < n) { max_mask = max_mask * 2; i = i + 1; }

		while (mask < max_mask) {
			// Count bits and collect indices for this mask
			let bit = 0;
			let popcount = 0;
			let indices = [];
			let split = [];
			let total_free: i32 = 0;
			while (bit < n) {
				let m = 1;
				let j = 0;
				while (j < bit) { m = m * 2; j = j + 1; }
				if ((mask & m) != 0) {
					popcount = popcount + 1;
					indices.push(gpus[bit].index);
					split.push(gpus[bit].free_mb);
					total_free = total_free + gpus[bit].free_mb;
				}
				bit = bit + 1;
			}
			if (popcount == target_size && f64(total_free) >= needed_with_overhead) {
				if (total_free > best_total) {
					best_indices = indices;
					best_split = split;
					best_total = total_free;
				}
			}
			mask = mask + 1;
		}

		if (best_indices != null) {
			return {
				indices:      best_indices,
				tensor_split: best_split,
				total_free:   best_total,
			};
		}
		target_size = target_size + 1;
	}
	return null;
}

// Catalog-driven placement. Walks every node that advertises this alias,
// computes VRAM cost from the catalog row's ingredients (no file read on
// CP's side), picks the smallest GPU subset that fits.
//
// Returns:
//   { node_id, agent_url, gpu_indices: [...], tensor_split: [...] | null,
//     est_mb, model_path }                                 -- a placement
//   null                                                    -- alias not in
//                                                              any node's
//                                                              catalog OR no
//                                                              GPU subset fits
//
// gpu_indices is always non-empty. tensor_split is null for single-GPU
// placements (no -ts needed) and an array of relative weights for
// multi-GPU splits. model_path comes back so the spawn proxy knows the
// agent-local path without the caller needing to keep separate state.
fn pick_placement_via_alias(alias: string, profile) {
	let candidates = nodes_with_alias(alias);
	if (candidates.length == 0) { return null; }

	// CPU-only intent: gpu_layers=0 means llama-server runs entirely on
	// CPU (no offload). Skip the GPU-fit search and just take the first
	// active candidate — RAM is plentiful and we don't track per-process
	// RAM accounting today. Returned with empty gpu_indices so the agent
	// spawn doesn't set CUDA_VISIBLE_DEVICES or --tensor-split.
	let cpu_only = (profile?.intent?.gpu_layers == 0);

	for (cand in candidates) {
		// Only consider nodes that have heartbeated recently and exposed
		// an agent_url. Stale nodes shouldn't drive placement decisions.
		// Disabled / draining nodes also drop out (operator-set state
		// in the dashboard or via PATCH /api/nodes/{id}).
		let nodes = query(DB,
			"select agent_url, hardware_json from nodes "
			+ "where node_id = ? "
			+ "and agent_url is not null "
			+ "and state = 'active' "
			+ "and last_seen_at > datetime('now', ?)",
			[cand.node_id, "-" + STALE_NODE_SECONDS + " seconds"]);
		if (nodes.length == 0) { continue; }
		let n = nodes[0];

		let est = estimate_vram_from_ingredients(cand,
			i32(profile.context), profile.kv_type);
		let needed_mb = est.total_mb;

		if (cpu_only) {
			return {
				node_id:      cand.node_id,
				agent_url:    n.agent_url,
				gpu_indices:  [],
				tensor_split: null,
				est_mb:       needed_mb,
				model_path:   cand.path,
			};
		}

		let hw = parse(n.hardware_json);
		let gpus = hw?.gpus ?? [];
		let subset = pick_gpu_subset(gpus, needed_mb);
		if (subset != null) {
			let split = null;
			if (subset.indices.length > 1) { split = subset.tensor_split; }
			return {
				node_id:      cand.node_id,
				agent_url:    n.agent_url,
				gpu_indices:  subset.indices,
				tensor_split: split,
				est_mb:       needed_mb,
				model_path:   cand.path,
			};
		}
	}
	return null;
}

// Returns one of:
//   { node_id, agent_url, gpu_index, est_mb }   -- a placement
//   { error: "...", status: 4xx|5xx }           -- a structured error
//   null                                         -- no fit found, retry later
//
// model_path is the path AS THE AGENT'S BOX SEES IT. For multi-box setups
// where the operator hasn't shared the model directory across all agents,
// CP can't read the file directly. We pre-check `exists` and bail out with
// a structured error rather than calling read_metadata — the runtime's
// file_stat does `exit(1)` on missing files (Hemlock parity gap; interp
// throws catchable, compiled binary doesn't), so a `try` around
// read_metadata wouldn't actually catch the crash.
//
// Long-term fix (mostly delivered by the catalog — see
// pick_placement_via_alias above): push model introspection to the
// agent. This path-based placement remains as the fallback for profiles
// without a model_alias and for explicit operator-supplied paths.
fn pick_placement(model_path: string, profile) {
	if (!exists(model_path)) {
		return { error: "CP cannot read model file at '" + model_path + "'. "
			+ "This usually means the path exists on the agent's box but not on "
			+ "CP's box. Until agent-side model introspection lands, either "
			+ "(a) make the model accessible at the same path on CP's box "
			+ "(NFS / bind mount / scp), or (b) pin placement explicitly with "
			+ "node_id + gpus + port and skip auto-placement.",
			status: 422 };
	}
	let g = read_metadata(model_path);
	let est = estimate_vram_mb(g, i32(profile.context), profile.kv_type);
	let needed_mb = est.total_mb;

	// CPU-only intent: gpu_layers=0 means llama-server runs entirely on
	// CPU (no offload). Skip the GPU-fit search and take the first
	// active node — same rule pick_placement_via_alias applies. Without
	// this, an explicit-model spawn of a CPU profile (e.g. designer-cpu)
	// is wrongly rejected with "no GPU has enough free VRAM" even though
	// it needs zero VRAM. Returned with empty gpu_indices so the agent
	// doesn't set CUDA_VISIBLE_DEVICES / --tensor-split.
	let cpu_only = (profile?.intent?.gpu_layers == 0);

	let rows = query(DB,
		"select node_id, agent_url, hardware_json from nodes "
		+ "where agent_url is not null "
		+ "and state = 'active' "
		+ "and last_seen_at > datetime('now', ?) "
		+ "order by registered_at desc",
		["-" + STALE_NODE_SECONDS + " seconds"]);

	for (row in rows) {
		if (cpu_only) {
			return {
				node_id:      row.node_id,
				agent_url:    row.agent_url,
				gpu_indices:  [],
				tensor_split: null,
				est_mb:       needed_mb,
			};
		}
		let hw = parse(row.hardware_json);
		let gpus = hw?.gpus ?? [];
		let subset = pick_gpu_subset(gpus, needed_mb);
		if (subset != null) {
			let split = null;
			if (subset.indices.length > 1) { split = subset.tensor_split; }
			return {
				node_id:      row.node_id,
				agent_url:    row.agent_url,
				gpu_indices:  subset.indices,
				tensor_split: split,
				est_mb:       needed_mb,
			};
		}
	}
	return null;
}

// ── shared-base LoRA placement ───────────────────────────────────────
// A profile with `share_group` (see agent/lora_share.hml) is served by one
// llama-server per (group, base model, settings, GPU set) on a node; the
// agent does the joining. The CP's part is placement: before the normal
// "fit a whole new server" search, look for a RUNNING shared server of the
// same group whose base model is this profile's model on that node, and
// join it when its GPUs have room for what the join adds. No room → normal
// placement (which may start a second shared server elsewhere).

// Per-new-adapter VRAM allowance when the profile doesn't say (`lora_mb`).
// The adapters in use are 58-640 MB f16 files; llama.cpp keeps them on
// the GPU at that size.
let SHARED_LORA_DEFAULT_MB: f64 = 512.0;

// Sum of current free VRAM over a node's GPU indices (latest heartbeat).
fn gpu_free_mb(node_id: string, indices): i32 {
	let rows = query(DB, "select hardware_json from nodes where node_id = ?", [node_id]);
	if (rows.length == 0) { return 0; }
	let hw = null;
	try { hw = parse(rows[0].hardware_json); } catch (e) { return 0; }
	let total = 0;
	for (g in (hw?.gpus ?? [])) {
		for (i in indices) { if (g.index == i) { total = total + g.free_mb; } }
	}
	return total;
}

// What joining adds to a running shared server, in MB: nothing when the
// server already covers the member (adapter loaded, spare slots/context);
// otherwise the KV growth from the restart config plus an allowance per
// adapter it has to load. `cand` is the node's catalog row for the base
// model (ingredients for the KV math); without it only adapters count.
fn shared_join_cost_mb(profile, sh, cand): f64 {
	let mine = [];
	try { for (a in profile_adapters(profile)) { mine.push(a.path); } } catch (e) { }
	let loaded = sh?.adapters ?? [];
	let new_adapters = 0;
	for (p in mine) { if (!loaded.contains(p)) { new_adapters = new_adapters + 1; } }
	let m_slots = member_slots(profile);
	let m_cps = member_ctx_per_slot(profile);
	let want_slots = (sh?.slots_in_use ?? 0) + m_slots;
	let want_cps = sh?.ctx_per_slot_in_use ?? 0;
	if (m_cps > want_cps) { want_cps = m_cps; }
	if (new_adapters == 0 && want_slots <= (sh?.slots ?? 0) && want_cps <= (sh?.ctx_per_slot ?? 0)) {
		return 0.0;
	}
	let per_adapter = SHARED_LORA_DEFAULT_MB;
	if (profile?.lora_mb != null) { per_adapter = f64(profile.lora_mb); }
	let kv_delta: f64 = 0.0;
	if (cand != null) {
		try {
			let kv = profile?.kv_type ?? "f16";
			let new_ctx = i32(want_cps * want_slots);
			let cur_ctx = i32(sh?.context ?? 0);
			kv_delta = estimate_vram_from_ingredients(cand, new_ctx, kv).kv_total_mb
				- estimate_vram_from_ingredients(cand, cur_ctx, kv).kv_total_mb;
		} catch (e) { kv_delta = 0.0; }
	}
	if (kv_delta < 0.0) { kv_delta = 0.0; }
	return kv_delta + per_adapter * f64(new_adapters);
}

// A running shared server this profile can join, as a placement pick
// ({ node_id, agent_url, gpu_indices, tensor_split, est_mb, model_path,
// joined, share_key }), or null.
fn find_shared_join(profile_name: string, profile, explicit_model) {
	if (!is_sharing_profile(profile)) { return null; }
	let group = "" + profile.share_group;
	let pin = profile?.pin;
	for (a in list_all_agents()) {
		// Pinned: only the server on the pinned node + GPU set qualifies.
		if (pin != null && a.node_id != pin.node_id) { continue; }
		let entries = null;
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code < 200 || resp.status_code >= 300) { continue; }
			entries = parse(resp.body);
		} catch (e) { continue; }
		for (s in entries) {
			let sh = s?.shared;
			if (sh?.role != "server" || sh?.group != group || s?.alive != true) { continue; }
			let model = explicit_model;
			let cand = null;
			if (model == null && profile?.model_alias != null) {
				let rows = query(DB,
					"select node_id, path, size_mb, architecture, n_layers, n_heads, "
					+ "n_kv_heads, embedding_length, claimed_context "
					+ "from node_models where alias = ? and node_id = ?",
					[profile.model_alias, a.node_id]);
				if (rows.length > 0) { model = rows[0].path; cand = rows[0]; }
			}
			if (model == null) { model = profile?.default_model; }
			if (model == null || model != s.model_path) { continue; }
			if (cand == null) {
				// explicit/default path: the node's catalog row for that file
				let rows = query(DB,
					"select node_id, path, size_mb, architecture, n_layers, n_heads, "
					+ "n_kv_heads, embedding_length, claimed_context "
					+ "from node_models where path = ? and node_id = ?", [model, a.node_id]);
				if (rows.length > 0) { cand = rows[0]; }
			}
			let gpus = s?.gpus ?? [];
			if (pin != null && stringify(gpus) != stringify(pin.gpus)) { continue; }
			let need = shared_join_cost_mb(profile, sh, cand);
			if (gpus.length > 0 && need > 0.0) {
				let free = gpu_free_mb(a.node_id, gpus);
				if (f64(free) < need * (1.0 + MULTI_GPU_OVERHEAD_FRACTION)) {
					print("[share] " + profile_name + ": shared server " + sh.key + " on "
						+ a.node_id + " lacks headroom (join needs ~" + i32(need)
						+ " MB, " + free + " MB free) — placing normally");
					continue;
				}
			}
			print("[share] " + profile_name + " → joins " + sh.key + " on " + a.node_id
				+ " (adds ~" + i32(need) + " MB)");
			return {
				node_id:      a.node_id,
				agent_url:    a.agent_url,
				gpu_indices:  gpus,
				tensor_split: null,
				est_mb:       need,
				model_path:   model,
				joined:       s.id,
				share_key:    sh.key,
			};
		}
	}
	return null;
}

// ── local engine placement ───────────────────────────────────────────
// A `local` profile ({ binary: "local", local_service: "<name>" }) runs
// a command the agent declares on its own disk; the CP never sees or
// sends the command. Placement therefore only answers: which live node
// declares <name>, and (if it declares vram_mb > 0) which ONE GPU there
// has that much free. No tensor split — an arbitrary process can't be
// sharded the way llama-server can.

// The declaration <name> as advertised by node_id, or null.
fn local_decl_on_node(node_id: string, name) {
	let rows = query(DB, "select local_services_json from nodes where node_id = ?", [node_id]);
	if (rows.length == 0 || rows[0]?.local_services_json == null) { return null; }
	let list = [];
	try { list = parse(rows[0].local_services_json); } catch (e) { return null; }
	for (e in list) { if (e?.name == name) { return e; } }
	return null;
}

// First declaration of <name> on any node (fresh or not) — for the
// readiness probe's health path / timeout, where any copy will do.
fn local_decl_any(name) {
	let rows = query(DB,
		"select node_id from nodes where local_services_json is not null "
		+ "order by last_seen_at desc", []);
	for (r in rows) {
		let d = local_decl_on_node(r.node_id, name);
		if (d != null) { return d; }
	}
	return null;
}

// Health path a profile's service answers on: per engine, or the
// declared one for a local service.
fn health_path_for_profile(profile): string {
	if (profile?.binary == "local") {
		return local_decl_any(profile?.local_service)?.health_path ?? "/health";
	}
	return health_path_for(profile?.binary);
}

// Returns a placement { node_id, agent_url, gpu_indices, tensor_split:
// null, est_mb, model_path, decl } or { error, status }. Device: the
// profile has already been through apply_device, so gpu_layers == 0
// means "cpu" was asked for — no GPU even if the service declares VRAM.
fn pick_placement_local(profile) {
	let name = profile?.local_service;
	let rows = query(DB,
		"select node_id, agent_url, hardware_json from nodes "
		+ "where agent_url is not null "
		+ "and state = 'active' "
		+ "and last_seen_at > datetime('now', ?) "
		+ "order by registered_at desc",
		["-" + STALE_NODE_SECONDS + " seconds"]);
	let declared_somewhere = false;
	let need = 0;
	for (row in rows) {
		let decl = local_decl_on_node(row.node_id, name);
		if (decl == null) { continue; }
		declared_somewhere = true;
		need = decl?.vram_mb ?? 0;
		let cpu = (profile?.intent?.gpu_layers == 0) || need <= 0;
		if (cpu) {
			return { node_id: row.node_id, agent_url: row.agent_url,
				gpu_indices: [], tensor_split: null, est_mb: 0,
				model_path: "local:" + name, decl: decl };
		}
		// One GPU, the one with the most free VRAM that covers the
		// declared need (headroom for whatever loads next).
		let hw = parse(row.hardware_json);
		let best = null;
		for (g in (hw?.gpus ?? [])) {
			if (g.free_mb >= need && (best == null || g.free_mb > best.free_mb)) { best = g; }
		}
		if (best != null) {
			return { node_id: row.node_id, agent_url: row.agent_url,
				gpu_indices: [best.index], tensor_split: null, est_mb: need,
				model_path: "local:" + name, decl: decl };
		}
	}
	if (!declared_somewhere) {
		return { status: 503, error: "no live node declares local service '" + name
			+ "' (add " + name + ".json to an agent's WITCHGRID_LOCAL_SERVICES dir)" };
	}
	return { status: 503, error: "no single GPU has " + need
		+ " MB free for local service '" + name + "'" };
}

// Extract the port number from an agent_url like "http://host:8766" or
// "http://host:8766/". Returns 0 if not parseable.
fn extract_port(agent_url: string): i32 {
	let rest = agent_url;
	let scheme = rest.find("://");
	if (scheme >= 0) { rest = rest.substr(scheme + 3, rest.length - scheme - 3); }
	let slash = rest.find("/");
	if (slash >= 0) { rest = rest.substr(0, slash); }
	let colon = rest.find(":");
	if (colon < 0) { return 0; }
	let port_str = rest.substr(colon + 1, rest.length - colon - 1);
	return i32(port_str);
}

// Cap on how many ports we probe before giving up. 50 is plenty —
// realistic usage has at most ~5 collisions before finding a free
// slot. Beyond 50, something's badly wrong and the operator should
// know; we return the default and let the agent's own EADDRINUSE
// surface the real problem.
let PORT_PROBE_MAX_ATTEMPTS = 50;

// Ask the agent's OS whether a port is actually bindable. Used to
// catch non-Witchgrid services (kobold, ooba, sd-webui, etc.) that
// the /services walk wouldn't see. The agent does the bind probe
// from its own host — that's the OS we care about.
//
// Returns true on confirmed-free, false on confirmed-in-use, true
// on probe failure (better to let the spawn try and fail loudly than
// to dance forever past unprobeable ports).
fn port_free_on_agent(agent_url: string, port: i32): bool {
	try {
		let resp = cp_post_json(agent_url + "/port_check", { port: port });
		if (resp.status_code >= 200 && resp.status_code < 300) {
			let body = parse(resp.body);
			return body?.available == true;
		}
		// 404 → old agent without the endpoint. Trust = optimistic.
		return true;
	} catch (e) {
		return true;
	}
}

// Pick a port the chosen agent isn't already using AND that doesn't
// collide with the agent's own listen port AND isn't taken by some
// non-Witchgrid process (kobold, ooba, etc.). Walks ports upward from
// default until we find one that passes both checks.
fn pick_port(agent_url: string, default_port: i32): i32 {
	let used = {};
	let agent_port = extract_port(agent_url);
	if (agent_port > 0) { used["" + agent_port] = true; }
	try {
		let resp = cp_get(agent_url + "/services");
		if (resp.status_code >= 200 && resp.status_code < 300) {
			let services = parse(resp.body);
			for (s in services) { used["" + s.port] = true; }
		}
	} catch (e) { }

	let port = default_port;
	let attempts = 0;
	while (attempts < PORT_PROBE_MAX_ATTEMPTS) {
		if (!used.has("" + port) && port_free_on_agent(agent_url, port)) {
			return port;
		}
		port = port + 1;
		attempts = attempts + 1;
	}
	return default_port;
}

// ── device (CPU/GPU) selection ───────────────────────────────────────
// First-class CPU/GPU toggle. CPU vs GPU is otherwise implicit in a
// profile's intent.gpu_layers (0 = CPU, >0 = offload). Rather than add a
// parallel placement path, we resolve a device choice and OVERRIDE
// gpu_layers before placement + spawn — both pick_placement*() and the
// agent's spawn_service() already branch on gpu_layers == 0, so the
// override flows through end to end.
//
// Resolution order: explicit spawn-request `device` > profile.default_device
// > "auto". "auto" respects the profile's declared gpu_layers (legacy
// behavior). Returns "cpu" | "gpu" | "auto".
fn resolve_device(req_device, profile): string {
	let d = req_device;
	if (d == null || d == "") { d = profile?.default_device; }
	if (d == null || d == "") { d = "auto"; }
	return d;
}

// True for an accepted device token. Used to 400 on garbage from the API.
fn is_valid_device(d): bool {
	return d == "cpu" || d == "gpu" || d == "auto";
}

// Returns a profile with intent.gpu_layers forced per the chosen device.
// fetch_profile_by_name() hands back a fresh parse each call, so mutating
// in place is safe (no shared/cached object to corrupt).
//   cpu  → 0          (no offload; placement skips GPU fit, CVD="")
//   gpu  → keep the profile's layers if it already offloads, else 99
//   auto → unchanged
fn apply_device(profile, device) {
	if (device == "auto" || device == null) { return profile; }
	let intent = profile?.intent;
	if (intent == null) { intent = {}; }
	let layers = intent?.gpu_layers ?? 0;
	if (device == "cpu") {
		intent["gpu_layers"] = 0;
	} else {
		intent["gpu_layers"] = (layers > 0) ? layers : 99;
	}
	profile["intent"] = intent;
	return profile;
}

// Where a profile will actually run, given its (already device-applied)
// intent: "cpu" if no offload, else "gpu". Used to surface placement to
// clients/dashboard without re-deriving from gpu_indices.
fn device_label(profile): string {
	let layers = profile?.intent?.gpu_layers ?? 0;
	if (layers == 0) { return "cpu"; }
	return "gpu";
}

// ── service proxy ────────────────────────────────────────────────────

fn handle_spawn_proxy(req): object {
	let payload = parse(req.body);
	let profile_name = payload?.profile;
	let model = payload?.model;
	if (profile_name == null) {
		return { status: 400, body: "{\"error\":\"profile required\"}" };
	}

	// Model can come from three places, in priority order:
	//   1. Operator-supplied `model:` in the request (explicit override).
	//   2. Catalog lookup via the profile's model_alias.
	//   3. Profile's default_model (legacy escape hatch).
	// We don't resolve here — pick_placement_via_alias does it inline so
	// the same node that wins placement also reports the path. For the
	// explicit model: case, we pass through to the path-based placement.
	let node_id = payload?.node_id;
	let gpus = payload?.gpus;
	let port = payload?.port;
	let tensor_split = payload?.tensor_split;

	// Profile is needed in both branches (placement reads context/
	// kv_type/default_port/etc., and we need to inline the full thing
	// into the agent_payload regardless). Fetch once.
	let profile = fetch_profile_by_name(profile_name);
	if (profile == null) {
		return { status: 400, body: stringify({
			error: "unknown profile: " + profile_name
				+ " (PUT /api/profiles/" + profile_name + " to create)",
		})};
	}

	// First-class CPU/GPU override. Resolve (request > profile default >
	// auto) and rewrite intent.gpu_layers so placement + the agent spawn
	// both honor it. Reject garbage device tokens up front.
	let req_device = payload?.device;
	if (req_device != null && req_device != "" && !is_valid_device(req_device)) {
		return { status: 400, body: stringify({
			error: "invalid device '" + req_device + "' (expected auto|cpu|gpu)",
		})};
	}
	let device = resolve_device(req_device, profile);
	profile = apply_device(profile, device);

	// profile.pin: a request that doesn't place the service itself (no
	// node_id/gpus) goes where the pin says. ignore_pin: true opts out.
	let pinned_by_profile = false;
	if (node_id == null && gpus == null && profile?.pin != null && payload?.ignore_pin != true) {
		node_id = profile.pin.node_id;
		gpus = profile.pin.gpus;
		if (port == null) { port = profile.pin?.port; }
		pinned_by_profile = true;
		if (!node_is_live(node_id)) {
			return { status: 503, body: stringify({
				error: "profile " + profile_name + " is pinned to node " + node_id
					+ " which is not live (stale, disabled or unknown); "
					+ "pass ignore_pin: true to place it elsewhere",
			})};
		}
	}

	if (profile?.binary == "local") {
		// local engine: placement by declaration, no model. A request
		// `model` is ignored — the agent's declaration is the command.
		let name = profile?.local_service;
		if (node_id == null || gpus == null) {
			let lp = pick_placement_local(profile);
			if (lp?.error != null) {
				return { status: lp.status, body: stringify({ error: lp.error }) };
			}
			node_id = lp.node_id;
			gpus = lp.gpu_indices;
			if (port == null) {
				port = pick_port(lp.agent_url, profile?.default_port ?? lp.decl.port);
			}
		} else if (port == null) {
			// Pinned: the agent refuses a name it doesn't declare; default
			// the port from what the node advertised (else the agent's own
			// declaration decides).
			port = profile?.default_port ?? local_decl_on_node(node_id, name)?.port;
		}
		tensor_split = null;
		model = "local:" + name;
	} else if (node_id == null || gpus == null) {
		// If the operator didn't pin (node_id, gpus), do capacity-aware
		// placement. Try alias-driven first (catalog → no FS access on CP);
		// fall back to path-driven if no alias resolves.

		let pick = null;
		// Prefer explicit model: from the request, then alias, then default_model.
		let resolved_model = model;
		// share_group: join a running shared server first (no new base copy).
		if (is_sharing_profile(profile)) {
			pick = find_shared_join(profile_name, profile, resolved_model);
			if (pick != null) { resolved_model = pick.model_path; }
		}
		if (pick == null && resolved_model == null && profile?.model_alias != null) {
			pick = pick_placement_via_alias(profile.model_alias, profile);
			if (pick != null) { resolved_model = pick.model_path; }
		}
		if (pick == null) {
			if (resolved_model == null) { resolved_model = profile?.default_model; }
			if (resolved_model == null) {
				return { status: 400, body: stringify({
					error: "no model resolved for " + profile_name
						+ " (request had no model, profile has no model_alias "
						+ "in catalog, and no default_model)",
				})};
			}
			let path_pick = pick_placement(resolved_model, profile);
			if (path_pick?.error != null) {
				return { status: path_pick.status, body: stringify({ error: path_pick.error }) };
			}
			pick = path_pick;
		}
		if (pick == null) {
			return { status: 503, body: stringify({
				error: "no GPU has enough free VRAM for " + profile_name
					+ " + this model at context " + profile.context,
			})};
		}
		node_id = pick.node_id;
		gpus = pick.gpu_indices;
		tensor_split = pick.tensor_split;
		model = resolved_model;
		if (port == null) { port = pick_port(pick.agent_url, profile.default_port); }
	} else {
		// Pinned (node_id + gpus): no placement, but the model still
		// resolves the same way — request, then the profile's model_alias
		// on the pinned node, then default_model — so a pinned respawn
		// doesn't need the operator to dig up a host-specific path.
		if (model == null && profile?.model_alias != null) {
			let rows = query(DB,
				"select path from node_models where alias = ? and node_id = ?",
				[profile.model_alias, node_id]);
			if (rows.length > 0) { model = rows[0].path; }
		}
		if (model == null) { model = profile?.default_model; }
		if (model == null) {
			return { status: 400, body: stringify({
				error: "no model resolved for " + profile_name + " on node " + node_id
					+ " (request had no model, profile's model_alias isn't in that "
					+ "node's catalog, and no default_model)",
			})};
		}
	}

	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}

	// Forward to the agent (which doesn't need node_id; it knows it's local).
	// `profile` is the inline JSON object — agents don't have their own
	// PROFILES map anymore (since v0.7), they just run what we hand them.
	// `profile_name` is kept on the wire so service rows / logs / dashboard
	// show the human-friendly identifier.
	let agent_payload = {
		profile_name: profile_name,
		profile:      profile,
		model:        model,
		port:         port,
		gpus:         gpus,
		tensor_split: tensor_split,
	};
	try {
		let resp = cp_post_json(agent_url + "/services", agent_payload);
		// Tag the placement decision into the response body so the client
		// can see what CP picked. Only do this on success.
		if (resp.status_code >= 200 && resp.status_code < 300) {
			let body = parse(resp.body);
			body["node_id"] = node_id;
			body["placed_by"] = pinned_by_profile ? "pin" : "cp";
			body["gpus"] = gpus ?? [];
			body["device"] = device_label(profile);
			if (profile?.binary == "local") {
				body["device"] = (gpus != null && gpus.length > 0) ? "gpu" : "cpu";
			}
			return { status: resp.status_code, body: stringify(body) };
		}
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

fn handle_stop_proxy(req): object {
	let payload = parse(req.body);
	let id = payload?.id;
	let node_id = payload?.node_id;
	if (id == null || node_id == null) {
		return { status: 400, body: "{\"error\":\"id+node_id required\"}" };
	}
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}
	try {
		let resp = cp_post_json(agent_url + "/services/stop", { id: id });
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// POST /unmanaged/kill { node_id, pid } → proxy to the node's agent to
// SIGTERM an unmanaged process. Best-effort (cross-user kills hit EPERM).
fn handle_kill_unmanaged_proxy(req): object {
	let payload = parse(req.body);
	let pid = payload?.pid;
	let node_id = payload?.node_id;
	if (pid == null || node_id == null) {
		return { status: 400, body: "{\"error\":\"pid+node_id required\"}" };
	}
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}
	try {
		let resp = cp_post_json(agent_url + "/unmanaged/kill", { pid: pid });
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// POST /api/scan-dirs { node_id, extra? } → proxy to the node's agent.
// With `extra` (array) it sets the editable scan dirs (+ rescans); without
// it, returns the current dirs. (No query-string parsing in the router,
// so GET-as-POST.)
fn handle_scan_dirs_proxy(req): object {
	let payload = parse(req?.body ?? "{}");
	let node_id = payload?.node_id;
	if (node_id == null) {
		return { status: 400, body: "{\"error\":\"node_id required\"}" };
	}
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}
	try {
		if (payload.has("extra")) {
			let resp = cp_post_json(agent_url + "/scan-dirs", { extra: payload.extra });
			return { status: resp.status_code, body: resp.body };
		}
		let resp = cp_get(agent_url + "/scan-dirs");
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// POST /models/delete { node_id, path } → proxy to the node's agent to
// delete a GGUF from disk (agent guards: .gguf + under a scan dir).
fn handle_model_delete_proxy(req): object {
	let payload = parse(req?.body ?? "{}");
	let node_id = payload?.node_id;
	let path = payload?.path;
	if (node_id == null || path == null) {
		return { status: 400, body: "{\"error\":\"node_id+path required\"}" };
	}
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node_id: " + node_id }) };
	}
	try {
		let resp = cp_post_json(agent_url + "/models/delete", { path: path });
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// Aggregate from every registered agent. Each service is tagged with
// its owning node_id so subsequent stop calls know where to route.
// An agent that doesn't answer (down, or busy past cp_get_fast's 6s —
// e.g. re-probing a freshly activated engine) contributes no services,
// so its node_id goes in `unreachable`: without that, a busy agent looked
// exactly like a node with nothing running.
fn collect_services(): object {
	let agents = list_all_agents();
	let merged = [];
	let unreachable = [];
	let stale = [];
	for (a in agents) {
		let ok = false;
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				let entries = parse(resp.body);
				for (e in entries) {
					e["node_id"] = a.node_id;
					merged.push(e);
				}
				ok = true;
				cache_node_services(a.node_id, resp.body);
			}
		} catch (e) { }
		if (!ok) {
			unreachable.push(a.node_id);
			// Serve the node's last good answer, marked stale, instead of
			// dropping its services: an agent that is restarting (or busy
			// past the 6 s fan-out budget) still has its services running —
			// they're setsid children that outlive it.
			let cached = cached_node_services(a.node_id);
			if (cached != null) {
				for (e in cached.entries) {
					e["node_id"] = a.node_id;
					e["stale"] = true;
					e["stale_as_of"] = cached.fetched_at;
					merged.push(e);
				}
				stale.push(a.node_id);
			}
		}
	}
	return { services: merged, unreachable: unreachable, stale: stale };
}

fn cache_node_services(node_id: string, body: string): null {
	try {
		exec(DB,
			"insert into node_services_cache (node_id, body, fetched_at) values (?, ?, datetime('now')) "
			+ "on conflict(node_id) do update set body = excluded.body, fetched_at = excluded.fetched_at",
			[node_id, body]);
	} catch (e) { }
	return null;
}

fn cached_node_services(node_id: string) {
	let r = query(DB, "select body, fetched_at from node_services_cache where node_id = ?", [node_id]);
	if (r.length == 0) { return null; }
	let entries = null;
	try { entries = parse(r[0].body); } catch (e) { return null; }
	return { entries: entries, fetched_at: r[0].fetched_at };
}

// GET /services. The body stays a plain array for existing clients. Nodes
// whose agent didn't answer are listed in the x-witchgrid-unreachable
// header (comma-separated node_ids) so a client can tell "no services"
// from "couldn't ask"; their last known services are still in the body,
// each marked "stale": true with "stale_as_of" (x-witchgrid-stale lists
// those nodes).
fn handle_list_services(req): object {
	let c = collect_services();
	let headers = { "content-type": "application/json" };
	if (c.unreachable.length > 0) {
		headers["x-witchgrid-unreachable"] = c.unreachable.join(",");
	}
	if (c.stale.length > 0) {
		headers["x-witchgrid-stale"] = c.stale.join(",");
	}
	return { status: 200, body: stringify(c.services), headers: headers };
}

// ── inference routing ────────────────────────────────────────────────
// /v1/llama/{profile}/{...} → http://{agent_host}:{service_port}/{...}
//
// CP looks up a running service by profile, derives the llama-server URL
// from the agent's host (we already store agent_url) and the service's
// port, then forwards the request directly. Agents stay off the data path
// — every chat reply going through the agent just to reach llama-server
// would tax latency for no architectural benefit.

let LLAMA_PREFIX = "/v1/llama/";

// Strip the URL scheme + port off agent_url, leaving just the host.
//   "http://10.0.0.20:8766" → "10.0.0.20"
//   "http://localhost:8766"     → "localhost"
fn extract_host(agent_url: string): string {
	let rest = agent_url;
	let scheme = rest.find("://");
	if (scheme >= 0) { rest = rest.substr(scheme + 3, rest.length - scheme - 3); }
	let slash = rest.find("/");
	if (slash >= 0) { rest = rest.substr(0, slash); }
	let colon = rest.find(":");
	if (colon >= 0) { rest = rest.substr(0, colon); }
	return rest;
}

// LAN-only target guard for a registered agent_url. Every CP->agent call
// (spawn/stop/fan-outs) is issued to this host WITH the shared bearer
// attached, so a register that points it at a public host would exfiltrate
// the secret and turn the CP into an SSRF proxy. Allow private/loopback IPv4
// literals; reject public IPv4 and 169.254/16 link-local (cloud metadata).
// Hostnames pass (LAN-first, no resolver here) — mirrors agent transfers.host_is_lan.
fn host_is_lan(host): bool {
	if (host == null || host.length == 0) { return false; }
	let i = 0;
	let ipish = true;
	while (i < host.length) {
		let c = host.substr(i, 1);
		if (!((c >= "0" && c <= "9") || c == ".")) { ipish = false; break; }
		i = i + 1;
	}
	if (!ipish) { return true; }
	let parts = host.split(".");
	if (parts.length != 4) { return false; }
	let a = 0; let b = 0; let c2 = 0; let d = 0;
	try {
		a = i32(parts[0]); b = i32(parts[1]);
		c2 = i32(parts[2]); d = i32(parts[3]);
	} catch (e) { return false; }
	if (a < 0 || a > 255 || b < 0 || b > 255
		|| c2 < 0 || c2 > 255 || d < 0 || d > 255) { return false; }
	if (a == 127) { return true; }
	if (a == 10) { return true; }
	if (a == 192 && b == 168) { return true; }
	if (a == 172 && b >= 16 && b <= 31) { return true; }
	return false;
}

// Pick the first running service matching this profile. Returns
// { agent_host, port } or null. Round-robin / placement is a later slice.
fn find_service_for_profile(profile_name: string) {
	let agents = list_all_agents();
	for (a in agents) {
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code < 200 || resp.status_code >= 300) { continue; }
			let entries = parse(resp.body);
			for (e in entries) {
				if (e?.profile == profile_name && e?.alive == true) {
					return {
						agent_host: extract_host(a.agent_url),
						port: e.port,
					};
				}
			}
		} catch (err) {
			// Agent unreachable; try next.
		}
	}
	return null;
}

// GET /resolve/{profile-or-alias} — control-plane location lookup.
//
// The data-plane counterpart of the /v1/llama proxy: instead of
// forwarding the inference request, just return WHERE the live
// llama-server is, so a consumer (FlameWorker/FlameGen) can connect
// directly and keep the CP out of the inference hot path entirely.
// Side-effect-free and cheap: alias-resolve + one /services scan, no
// proxying, no auto-spawn (spawn stays an explicit POST /services).
//
// 200 { profile, alias, host, port, base_url } when a matching
// service is running; 404 { error, profile } when it isn't (the
// consumer then decides: spawn via POST /services, or back off and
// re-resolve). Public — it's a location, not a secret, and workers
// must reach it before any bearer is provisioned.
fn handle_resolve(req): object {
	let prefix = "/resolve/";
	if (req.path.length <= prefix.length) {
		return { status: 400,
			body: "{\"error\":\"profile required: /resolve/{profile-or-alias}\"}" };
	}
	let raw = req.path.substr(prefix.length, req.path.length - prefix.length);
	// Tolerate a trailing slash and ignore any extra path segments.
	let slash = raw.find("/");
	let alias = raw;
	if (slash >= 0) { alias = raw.substr(0, slash); }
	if (alias.length == 0) {
		return { status: 400,
			body: "{\"error\":\"profile required: /resolve/{profile-or-alias}\"}" };
	}

	let profile_name = resolve_profile_name(alias);
	let target = find_service_for_profile(profile_name);
	if (target == null) {
		return { status: 404, body: stringify({
			error: "no running service for profile",
			profile: profile_name,
			alias: alias,
		}) };
	}

	let base = "http://" + target.agent_host + ":" + target.port;
	return { status: 200, body: stringify({
		profile:  profile_name,
		alias:    alias,
		host:     target.agent_host,
		port:     target.port,
		base_url: base,
	}) };
}

// GET /api/ready/{profile-or-alias} — one-shot readiness probe so the spawn
// UI can show "loading model… → ready" instead of a bare "spawned" while a
// freshly-spawned model is still loading (POST /services returns once the
// process is up, ~10–15s before the model answers /health). Resolves the
// live service and does a single health probe (path per binary). Public —
// it's a status, not a secret.
fn handle_service_ready(req): object {
	let prefix = "/api/ready/";
	if (req.path.length <= prefix.length) {
		return { status: 400, body: "{\"error\":\"profile required: /api/ready/{profile}\"}" };
	}
	let raw = req.path.substr(prefix.length, req.path.length - prefix.length);
	let slash = raw.find("/");
	let alias = raw;
	if (slash >= 0) { alias = raw.substr(0, slash); }
	let profile_name = resolve_profile_name(alias);
	let target = find_service_for_profile(profile_name);
	if (target == null) {
		return { status: 200, body: stringify({ ready: false, phase: "no-service" }) };
	}
	let profile = fetch_profile_by_name(profile_name);
	let url = "http://" + target.agent_host + ":" + target.port
		+ health_path_for_profile(profile);
	let ready = false;
	try { let r = get(url, null); if (r.status_code == 200) { ready = true; } } catch (e) { }
	return { status: 200, body: stringify({
		ready: ready,
		phase: (ready ? "ready" : "loading"),
		host:  target.agent_host,
		port:  target.port,
	}) };
}

// Wait for a freshly-spawned llama-server to flip from "Loading model" to
// 200 on /health. Returns true on ready, false on timeout. 60s ceiling
// covers a 12B model on a fast GPU; bigger models on slower disks may
// need more — make configurable when that bites.
let AUTOSPAWN_READY_TIMEOUT_SECONDS = 60;

// Readiness probe path differs per engine: llama-server exposes
// /health; stable-diffusion.cpp's server has no /health — its
// lightest always-available GET once the model is loaded is
// /sdapi/v1/options (returns the loaded checkpoint stem). Caller
// passes the right path based on the profile's binary.
fn health_path_for(binary): string {
	if (binary == "sd-server")      { return "/sdapi/v1/options"; }
	// whisper-server / piper: minimal HTTP surfaces, both return 200
	// on `/` once the listener is bound. piper's model is loaded on
	// first request; whisper's is loaded eagerly when --model is
	// passed at spawn time.
	if (binary == "whisper-server") { return "/"; }
	if (binary == "piper")          { return "/"; }
	return "/health";
}

// timeout_seconds is passed by the caller rather than read from a
// module constant: autospawn blocks a client request (60s), while a
// bench deliberately allows longer (120s) for a cold model load. Both
// used to land on AUTOSPAWN_READY_TIMEOUT_SECONDS, which silently
// capped benches at 60s and left BENCH_READY_TIMEOUT_SECONDS dead.
fn wait_for_service_ready(host: string, port: i32, health_path: string,
                          timeout_seconds: i32): bool {
	let url = "http://" + host + ":" + port + health_path;
	let waited = 0;
	while (waited < timeout_seconds) {
		try {
			let r = get(url, null);
			if (r.status_code == 200) { return true; }
			// 503 with "Loading model" body is the normal in-flight state;
			// keep polling. Any other status is a real problem but we'll
			// keep trying until timeout to ride out transient issues.
		} catch (e) {
			// Connection refused while llama-server's still binding the
			// socket. Same — keep polling.
		}
		sleep(1.0);
		waited = waited + 1;
	}
	return false;
}

// Triggered when handle_llama_proxy gets a request for a profile that
// has no running service. Looks up the profile's default_model, runs
// the same placement path as explicit POST /services, posts the spawn
// to the chosen agent, then blocks on /health until the new instance
// answers (or we hit the timeout).
//
// Returns { agent_host, port } on success, or an HTTP-shaped error
// object {status, body} the caller should propagate to the client.
//
// NOTE: this blocks CP's accept loop for the load-time of the model
// (10-15s for 12B-class). Single-threaded HTTP means no other requests
// get served during that window. Acceptable for v1 since auto-spawn
// fires rarely (only on first request after agent restart). When this
// becomes a problem, the fix is to make CP's accept loop spawn each
// request handler on a worker thread.
fn auto_spawn(profile_name: string) {
	let profile = fetch_profile(profile_name);
	if (profile == null) {
		return { error: { status: 503, body: stringify({
			error: "no agent advertises profile: " + profile_name,
		})}};
	}

	// Honor the profile's default_device on the auto-spawn path (no request
	// override exists here — /v1/llama/* is profile-derived).
	profile = apply_device(profile, resolve_device(null, profile));

	// A pinned profile auto-spawns exactly where its pin says (never
	// "wherever fits"), through the same path as POST /services.
	if (profile?.pin != null) { return auto_spawn_pinned(profile_name, profile); }

	if (profile?.binary == "local") { return auto_spawn_local(profile_name, profile); }

	// Same priority ladder as handle_spawn_proxy: alias-driven first,
	// then default_model fallback. The /v1/llama/* path has no operator-
	// supplied override; it's all profile-derived.
	let pick = null;
	let resolved_model = null;
	if (is_sharing_profile(profile)) {
		pick = find_shared_join(profile_name, profile, null);
		if (pick != null) { resolved_model = pick.model_path; }
	}
	if (pick == null && profile?.model_alias != null) {
		pick = pick_placement_via_alias(profile.model_alias, profile);
		if (pick != null) { resolved_model = pick.model_path; }
	}
	if (pick == null) {
		if (profile?.default_model == null) {
			let alias = profile?.model_alias;
			let body = {
				error: "no running service for profile " + profile_name
					+ " and no model resolvable (alias '"
					+ (alias ?? "<none>")
					+ "' not in any node's catalog and no default_model)",
			};
			// Enrich with hunt hints when we have an alias to look up.
			// Operator sees "here's the HF coords / here's a peer that
			// has it" right in the error and can POST /models/distribute.
			if (alias != null) {
				body["alias"] = alias;
				body["known_sources"] = known_sources_for(alias, null);
				body["hint"] = "POST /models/distribute "
					+ "{alias, target_node, source_kind?} to fetch it";
			}
			return { error: { status: 503, body: stringify(body) }};
		}
		resolved_model = profile.default_model;
		let path_pick = pick_placement(profile.default_model, profile);
		if (path_pick?.error != null) {
			return { error: { status: path_pick.status,
				body: stringify({ error: path_pick.error }) }};
		}
		pick = path_pick;
	}
	if (pick == null) {
		return { error: { status: 503, body: stringify({
			error: "auto-spawn declined: no GPU has free VRAM for "
				+ profile_name + " at context " + profile.context,
		})}};
	}
	let port = pick_port(pick.agent_url, profile.default_port);
	let agent_payload = {
		profile_name: profile_name,
		profile:      profile,
		model:        resolved_model,
		port:         port,
		gpus:         pick.gpu_indices,
		tensor_split: pick.tensor_split,
	};

	let gpu_csv = "";
	let gi = 0;
	while (gi < pick.gpu_indices.length) {
		if (gi > 0) { gpu_csv = gpu_csv + ","; }
		gpu_csv = gpu_csv + pick.gpu_indices[gi];
		gi = gi + 1;
	}
	print("[autospawn] " + profile_name + " on " + pick.node_id
		+ " gpus=" + gpu_csv + " port=" + port);

	let spawn_resp = null;
	try {
		spawn_resp = cp_post_json(pick.agent_url + "/services", agent_payload);
	} catch (e) {
		return { error: { status: 502, body: stringify({
			error: "auto-spawn: agent unreachable: " + e,
		})}};
	}
	if (spawn_resp.status_code < 200 || spawn_resp.status_code >= 300) {
		return { error: { status: spawn_resp.status_code, body: spawn_resp.body }};
	}

	let host = extract_host(pick.agent_url);
	if (!wait_for_service_ready(host, port, health_path_for(profile?.binary),
	                            AUTOSPAWN_READY_TIMEOUT_SECONDS)) {
		return { error: { status: 503, body: stringify({
			error: "auto-spawned service did not become ready in "
				+ AUTOSPAWN_READY_TIMEOUT_SECONDS + "s",
		})}};
	}
	print("[autospawn] " + profile_name + " ready on " + host + ":" + port);
	return { agent_host: host, port: port };
}

// auto_spawn for a pinned profile: POST /services semantics (the pin
// places it), then wait for health on the pinned node.
fn auto_spawn_pinned(profile_name: string, profile) {
	let resp = handle_spawn_proxy({ method: "POST", path: "/services", headers: {},
		body: stringify({ profile: profile_name }) });
	if (resp.status < 200 || resp.status >= 300) {
		return { error: { status: resp.status, body: resp.body }};
	}
	let svc = parse(resp.body);
	let agent_url = lookup_agent(svc.node_id);
	let host = extract_host(agent_url ?? "");
	let timeout = AUTOSPAWN_READY_TIMEOUT_SECONDS;
	if (profile?.binary == "local") {
		timeout = local_decl_on_node(svc.node_id, profile?.local_service)?.startup_timeout_s ?? timeout;
	}
	print("[autospawn] " + profile_name + " (pinned) on " + svc.node_id + " port=" + svc.port);
	if (!wait_for_service_ready(host, svc.port, health_path_for_profile(profile), timeout)) {
		return { error: { status: 503, body: stringify({
			error: "auto-spawned (pinned) service did not become ready in " + timeout + "s",
		})}};
	}
	return { agent_host: host, port: svc.port };
}

// auto_spawn for a `local` profile: declaration-driven placement, then
// wait on the DECLARED health path for the declared startup timeout
// (a venv loading TTS/RVC weights is slower than the 60s llama default).
fn auto_spawn_local(profile_name: string, profile) {
	let lp = pick_placement_local(profile);
	if (lp?.error != null) {
		return { error: { status: lp.status, body: stringify({ error: lp.error }) }};
	}
	let port = pick_port(lp.agent_url, profile?.default_port ?? lp.decl.port);
	print("[autospawn] local " + profile_name + " (" + profile.local_service + ") on "
		+ lp.node_id + " gpus=" + lp.gpu_indices.join(",") + " port=" + port);
	let spawn_resp = null;
	try {
		spawn_resp = cp_post_json(lp.agent_url + "/services", {
			profile_name: profile_name,
			profile:      profile,
			model:        lp.model_path,
			port:         port,
			gpus:         lp.gpu_indices,
			tensor_split: null,
		});
	} catch (e) {
		return { error: { status: 502, body: stringify({
			error: "auto-spawn: agent unreachable: " + e,
		})}};
	}
	if (spawn_resp.status_code < 200 || spawn_resp.status_code >= 300) {
		return { error: { status: spawn_resp.status_code, body: spawn_resp.body }};
	}
	let host = extract_host(lp.agent_url);
	let timeout = lp.decl?.startup_timeout_s ?? AUTOSPAWN_READY_TIMEOUT_SECONDS;
	if (!wait_for_service_ready(host, port, lp.decl?.health_path ?? "/health", timeout)) {
		return { error: { status: 503, body: stringify({
			error: "auto-spawned local service did not become ready in " + timeout + "s",
		})}};
	}
	print("[autospawn] " + profile_name + " ready on " + host + ":" + port);
	return { agent_host: host, port: port };
}

fn handle_llama_proxy(req): object {
	// req.path is "/v1/llama/chat-mahou/completion"; split off the profile
	// and the suffix that goes to llama-server.
	let after = req.path.substr(LLAMA_PREFIX.length,
		req.path.length - LLAMA_PREFIX.length);
	let slash = after.find("/");
	let profile_name = "";
	let suffix = "";
	if (slash < 0) {
		profile_name = after;
		suffix = "/";
	} else {
		profile_name = after.substr(0, slash);
		suffix = after.substr(slash, after.length - slash);
	}
	if (profile_name.length == 0) {
		return { status: 400, body: "{\"error\":\"profile required: /v1/llama/{profile}/{path}\"}" };
	}

	// Resolve aliases so a public-facing URL like /v1/llama/flame-chat/...
	// can map to an internal profile (e.g. chat-mahou). When no alias
	// matches, returns the name unchanged so direct profile names
	// continue to work without setup.
	profile_name = resolve_profile_name(profile_name);

	let target = find_service_for_profile(profile_name);
	if (target == null) {
		// Auto-spawn path. Either succeeds (target gets a value), or hands
		// back a {status, body} we propagate to the client unchanged.
		let result = auto_spawn(profile_name);
		if (result?.error != null) {
			return result.error;
		}
		target = result;
	}

	let target_url = "http://" + target.agent_host + ":" + target.port + suffix;
	// Forward as JSON for now — every llama-server endpoint we care about
	// (completion, chat/completions, embeddings) takes JSON. Generalize when
	// we add image gen / multipart paths.
	let headers = ["Content-Type: application/json"];

	// Detect stream:true in the body. llama-server returns SSE
	// (text/event-stream) when stream is true; we need to forward
	// chunks straight through to the client without buffering, so the
	// caller sees tokens as they're produced. Otherwise we buffer
	// (single JSON object response) — same as before.
	//
	// Body parse cost: chat completion bodies are typically <100KB,
	// most under 10KB. Single JSON parse per request is noise vs the
	// inference cost.
	let want_stream = false;
	if (req.body != null && req.body.length > 0) {
		try {
			let payload = parse(req.body);
			if (payload?.stream == true) { want_stream = true; }
		} catch (e) {
			// Non-JSON body — treat as buffered. llama-server only
			// accepts JSON for the endpoints we care about, so a
			// malformed body will fail upstream with a useful error.
		}
	}

	if (want_stream) {
		let s = null;
		try {
			s = http_stream(req.method, target_url, req.body, headers, 600000);
		} catch (e) {
			return { status: 502, body: stringify({
				error: "llama-server unreachable at " + target_url + ": " + e,
			})};
		}
		return {
			status: s.status_code,
			stream_upstream: s,
			headers: { "content-type": "text/event-stream" },
		};
	}

	try {
		// 10-minute budget matches the streaming path. Hemlock 2.4.0
		// dropped the default lws timeout to 5s, which is fine for CP
		// internal calls but kills long buffered generations (a
		// 1000-token completion easily exceeds 30s on a 12B model).
		// Use the explicit-timeout variant to opt back into the longer
		// budget for inference forwarding only.
		let resp = http_request_timeout(req.method, target_url, req.body, headers, 600000);
		// Body might be JSON or text — pass through unchanged. Status from
		// llama-server is the final word.
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({
			error: "llama-server unreachable at " + target_url + ": " + e,
		})};
	}
}

// ── dashboard data fetchers ─────────────────────────────────────────
// Thin wrappers that pull live data the dashboard fragments need.
// Kept here (rather than in dashboard.hml) because they touch the DB
// and the cross-agent fan-out — concerns that belong with CP.

fn nodes_for_dashboard(): array {
	let rows = query(DB,
		"select node_id, hostname, role, hardware_json, agent_url, "
		+ "registered_at, last_seen_at, state, runtime_json, auto_restart, agent_version, "
		+ "cast((julianday('now') - julianday(last_seen_at)) * 86400 as integer) as age_seconds "
		+ "from nodes order by registered_at desc", []);
	let out = [];
	for (row in rows) {
		let runtime = null;
		if (row?.runtime_json != null) {
			try { runtime = parse(row.runtime_json); } catch (e) { }
		}
		out.push({
			node_id: row.node_id,
			hostname: row.hostname,
			role: row.role,
			hardware: parse(row.hardware_json),
			agent_url: row.agent_url,
			last_seen_at: row.last_seen_at,
			age_seconds: row.age_seconds,
			state: row?.state ?? "active",
			runtime: runtime,
			auto_restart: (row?.auto_restart == null) ? null : (row.auto_restart == 1),
			agent_version: row?.agent_version,
		});
	}
	return out;
}

// Fan out to every agent's /services and group the live list by node, so
// the node cards can show each box's managed services inline under its
// hardware. Same source the fleet-wide /ui/services panel uses; a dead
// agent just contributes no entry (its services show as none).
fn services_by_node(): object {
	let agents = list_all_agents();
	let out = {};
	for (a in agents) {
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				let entries = parse(resp.body);
				let host = extract_host(a.agent_url);
				let list = [];
				for (e in entries) {
					// Enrich each service with what the dashboard's "connect"
					// modal needs but the agent doesn't carry: the host CP
					// reaches the agent at (→ the service's direct base_url is
					// http://{agent_host}:{port}) and the profile's engine
					// binary (→ which API + example to show). Best-effort: a
					// service whose profile was deleted just renders generic.
					e["agent_host"] = host;
					let prof = fetch_profile(e?.profile);
					e["binary"] = prof?.binary ?? "llama-server";
					list.push(e);
				}
				out[a.node_id] = list;
			}
		} catch (e) { }
	}
	return out;
}

fn handle_ui_nodes(req): object {
	let nodes = nodes_for_dashboard();
	let samples = samples_for_dashboard(nodes);
	let unmanaged = unmanaged_by_node();
	let svcs = services_by_node();
	let body = render_nodes(nodes, samples, unmanaged, svcs, STALE_NODE_SECONDS);
	return { status: 200, body: body,
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// Group rows of node_unmanaged_procs by (node_id, gpu_index) so the
// renderer can drop the relevant entries under the matching GPU row
// without filtering inline. Shape:
//   { node_id → { gpu_index_str → [{pid, process_name, vram_mb, owner_name}, ...] } }
fn unmanaged_by_node(): object {
	let rows = query(DB,
		"select node_id, pid, process_name, vram_mb, gpu_index, owner_name, "
		+ "owner_uid, ports, cmdline "
		+ "from node_unmanaged_procs order by vram_mb desc", []);
	let out = {};
	for (r in rows) {
		if (!out.has(r.node_id)) { out[r.node_id] = {}; }
		let key = "" + (r?.gpu_index ?? -1);
		if (!out[r.node_id].has(key)) { out[r.node_id][key] = []; }
		// ports stored as JSON text by newer agents; null/garbage → [].
		let ports = [];
		if (r?.ports != null) { try { ports = parse(r.ports); } catch (e) { ports = []; } }
		out[r.node_id][key].push({
			pid:          r.pid,
			process_name: r.process_name,
			vram_mb:      r.vram_mb,
			owner_name:   r?.owner_name,
			owner_uid:    r?.owner_uid,
			ports:        ports,
			cmdline:      r?.cmdline,
		});
	}
	return out;
}

// GET /ui/layout — per-GPU bars from the last heartbeat's measurements
// (no agent calls: cheap enough to poll).
fn handle_ui_layout(req): object {
	let rows = query(DB,
		"select node_id, hardware_json, service_vram_json, gpu_usage_json from nodes "
		+ "where last_seen_at > datetime('now', ?) order by node_id asc",
		["-" + STALE_NODE_SECONDS + " seconds"]);
	let view = [];
	for (r in rows) {
		let hw = null;
		let sv = null;
		let gu = null;
		try { hw = parse(r.hardware_json); } catch (e) { hw = {}; }
		try { if (r?.service_vram_json != null) { sv = parse(r.service_vram_json); } } catch (e) { }
		try { if (r?.gpu_usage_json != null) { gu = parse(r.gpu_usage_json); } } catch (e) { }
		if ((hw?.gpus ?? []).length == 0) { continue; }
		let gl = gpus_with_usage(hw.gpus, gu ?? [], sv ?? []);
		// shared servers: label with their members
		for (g in gl) {
			for (s in (g?.services ?? [])) {
				for (e in (sv ?? [])) {
					if (e?.id == s.id && e?.members != null) {
						let ms = [];
						for (m in e.members) { ms.push(m.profile); }
						s["members"] = ms;
					}
				}
			}
		}
		view.push({ node_id: r.node_id, gpus: gl });
	}
	return { status: 200, body: render_layout(view),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

fn handle_ui_services(req): object {
	// Reuse the JSON aggregator's logic — call the agents, build the
	// merged list, hand to the renderer. Also fetch the current
	// profiles map so the renderer can flag a "stale" badge on
	// services whose profile_version is older than the live profile.
	let c = collect_services();
	let live_profiles = all_profiles_map();
	return { status: 200, body: render_services(c.services, live_profiles, c.unreachable),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// ── live state stream (SSE) ──────────────────────────────────────────
// /events holds a connection open and pushes a compact snapshot of fleet
// state (services + nodes) whenever it changes, so the dashboard updates
// in near-real-time instead of polling every 5s. serve() runs each
// connection in its own detached task, so this loop doesn't block other
// requests; a failed write (client/tab gone) ends the loop and frees the
// task. Cheap by design: re-snapshot every SSE_POLL_SECONDS, push only on
// change, keepalive comment otherwise.
let SSE_POLL_SECONDS: f64 = 2.0;
let SSE_KEEPALIVE_TICKS = 8;            // ~16s without a change → keepalive

// Compact, hashable view of what the dashboard renders: per-service
// (id, profile, node, port, alive, device) and per-node (id, role, up).
fn events_snapshot(): object {
	let agents = list_all_agents();
	let svcs = [];
	for (a in agents) {
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				for (e in parse(resp.body)) {
					svcs.push({ id: e.id, profile: e.profile, node: a.node_id,
						port: e.port, alive: e.alive, device: e?.device,
						state: e?.state });
				}
			}
		} catch (e) { }
	}
	let nrows = query(DB,
		"select node_id, role, (last_seen_at > datetime('now', ?)) as up from nodes",
		["-" + STALE_NODE_SECONDS + " seconds"]);
	let nodes = [];
	for (r in nrows) {
		nodes.push({ node_id: r.node_id, role: r.role, up: (r.up == 1) });
	}
	return { services: svcs, nodes: nodes };
}

// One-shot snapshot (same shape /events streams). Lets the dashboard paint
// the health banner immediately on load without waiting for the first SSE
// frame; also handy for scripts that want fleet state without a stream.
fn handle_state(req): object {
	return { status: 200, body: stringify(events_snapshot()),
		headers: { "content-type": "application/json" } };
}

fn handle_events(req): object {
	let emit = fn(stream): null {
		// We own the connection: write the SSE preamble ourselves. No
		// Content-Length (open-ended); x-accel-buffering off so reverse
		// proxies don't sit on frames.
		try {
			stream.write("HTTP/1.1 200 OK\r\n");
			stream.write("content-type: text/event-stream\r\n");
			stream.write("cache-control: no-cache\r\n");
			stream.write("connection: keep-alive\r\n");
			stream.write("x-accel-buffering: no\r\n");
			stream.write("\r\n");
			stream.write("retry: 3000\n\n");
		} catch (e) { return null; }

		let last_payload = "";
		let ticks = 0;
		loop {
			let payload = stringify(events_snapshot());
			let ok = true;
			if (payload != last_payload) {
				last_payload = payload;
				ticks = 0;
				try { stream.write("event: state\ndata: " + payload + "\n\n"); }
				catch (e) { ok = false; }
			} else {
				ticks = ticks + 1;
				if (ticks >= SSE_KEEPALIVE_TICKS) {
					ticks = 0;
					try { stream.write(": keepalive\n\n"); } catch (e) { ok = false; }
				}
			}
			if (!ok) { break; }      // client/tab gone
			sleep(SSE_POLL_SECONDS);
		}
		return null;
	};
	return { sse_handler: emit };
}

// Profiles live in CP's table since v0.7. all_profiles_map() (defined
// near the CRUD handlers below) returns the same shape that the
// agent-fan-out used to return — name → profile object.
fn handle_ui_profiles(req): object {
	return { status: 200, body: render_profiles(all_profiles_map()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// Per-node capability map: { node_id → { binary → { flag → flag_info } } }
// Each agent introspects its own binaries at boot; CP just fans out.
fn aggregated_capabilities(): object {
	let agents = list_all_agents();
	let out = {};
	for (a in agents) {
		try {
			let resp = cp_get(a.agent_url + "/capabilities");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				out[a.node_id] = parse(resp.body);
			}
		} catch (e) { }
	}
	return out;
}

fn handle_ui_capabilities(req): object {
	return { status: 200, body: render_capabilities(aggregated_capabilities()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// JSON variant of /ui/capabilities for the profile editor's
// capability-aware warnings. Same aggregated shape, JSON instead of
// rendered HTML. Public so the editor JS can fetch it freely.
fn handle_list_capabilities(req): object {
	return { status: 200, body: stringify(aggregated_capabilities()),
		headers: { "content-type": "application/json" } };
}

// ── catalog ──────────────────────────────────────────────────────────
// Aggregated GGUF catalog across every registered node. Each alias may
// appear on multiple nodes; the operator (or placement) picks where to
// run.

// Look up nodes that have a given alias on disk. Used by placement to
// resolve model_alias → (node, path). Returns rows with the placement
// ingredients pre-extracted so we don't re-parse hardware_json per call.
fn nodes_with_alias(alias: string): array {
	let rows = query(DB,
		"select node_id, path, size_mb, architecture, n_layers, n_heads, "
		+ "n_kv_heads, embedding_length, claimed_context, source_url "
		+ "from node_models where alias = ?", [alias]);
	return rows;
}

// Aggregated catalog grouped by alias, for the dashboard + JSON endpoint.
fn catalog_grouped(): array {
	let rows = query(DB,
		"select alias, node_id, path, size_mb, architecture, "
		+ "claimed_context, general_name, source_url "
		+ "from node_models order by alias asc, node_id asc", []);
	let by_alias = {};
	let order = [];
	for (row in rows) {
		if (!by_alias.has(row.alias)) {
			by_alias[row.alias] = {
				alias: row.alias,
				size_mb: row.size_mb,
				architecture: row.architecture,
				claimed_context: row.claimed_context,
				general_name: row.general_name,
				source_url: row.source_url,
				on_nodes: [],
			};
			order.push(row.alias);
		}
		by_alias[row.alias].on_nodes.push({
			node_id: row.node_id,
			path:    row.path,
		});
	}
	let out = [];
	for (a in order) { out.push(by_alias[a]); }
	return out;
}

fn handle_list_catalog(req): object {
	return { status: 200, body: stringify(catalog_grouped()) };
}

fn handle_ui_catalog(req): object {
	return { status: 200,
		body: render_catalog(catalog_grouped(), nodes_for_dashboard()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

fn handle_ui_transfers(req): object {
	return { status: 200, body: render_transfers(aggregated_transfers()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// Build the missing-models list: aliases that any profile names but
// no node has on disk. Each row carries known_sources + the profiles
// that reference it so the UI can render an actionable hint.
fn missing_models(): array {
	let profiles = all_profiles_map();
	let names = profiles.keys();
	let aliases_to_profiles = {};
	for (n in names) {
		let p = profiles[n];
		let alias = p?.model_alias;
		if (alias == null) { continue; }
		if (!aliases_to_profiles.has(alias)) {
			aliases_to_profiles[alias] = [];
		}
		aliases_to_profiles[alias].push(n);
	}

	let out = [];
	let alias_keys = aliases_to_profiles.keys();
	for (alias in alias_keys) {
		let on = nodes_with_alias(alias);
		if (on.length > 0) { continue; }  // someone has it; not missing
		out.push({
			alias:         alias,
			profiles:      aliases_to_profiles[alias],
			known_sources: known_sources_for(alias, null),
		});
	}
	return out;
}

fn handle_ui_missing(req): object {
	return { status: 200,
		body: render_missing(missing_models(), nodes_for_dashboard()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// ── distribution ─────────────────────────────────────────────────────
//
// Resolve known sources for an alias: peer (any node that has it on
// disk EXCEPT the target node itself) + hf (any profile with this
// model_alias and an hf_source). Used both by /models/distribute (to
// auto-pick a source) and by routing 404s (to enrich the error body
// with hunt hints).
fn known_sources_for(alias: string, target_node) {
	let out = { peer: [], hf: [] };

	// Peer: every other node that has the alias on disk, paired with
	// its agent_url so the target can hit /models/{alias}/blob there.
	let rows = query(DB,
		"select nm.node_id as node_id, nm.path as path, n.agent_url as agent_url "
		+ "from node_models nm "
		+ "join nodes n on nm.node_id = n.node_id "
		+ "where nm.alias = ? "
		+ "and n.agent_url is not null "
		+ "and n.last_seen_at > datetime('now', ?)",
		[alias, "-" + STALE_NODE_SECONDS + " seconds"]);
	for (row in rows) {
		if (row.node_id == target_node) { continue; }  // can't pull from self
		out.peer.push({
			node_id:   row.node_id,
			agent_url: row.agent_url,
			blob_url:  row.agent_url + "/models/" + alias + "/blob",
		});
	}

	// HF: scan aggregated profiles for any that name this alias and
	// include an hf_source. Same alias may show up in multiple
	// profiles; first match wins.
	let profiles = all_profiles_map();
	let names = profiles.keys();
	for (n in names) {
		let p = profiles[n];
		if (p?.model_alias == alias && p?.hf_source != null) {
			out.hf.push({
				profile: n,
				repo:    p.hf_source.repo,
				file:    p.hf_source.file,
			});
		}
	}
	return out;
}

fn handle_distribute(req): object {
	let payload = parse(req.body);
	let alias = payload?.alias;
	let target_node = payload?.target_node;
	if (alias == null || target_node == null) {
		return { status: 400, body: stringify({
			error: "alias + target_node required",
		})};
	}
	// alias becomes a filename on the target node — validate at the edge.
	if (!valid_pull_alias(alias)) {
		return { status: 400, body: stringify({
			error: "invalid alias: single segment of [A-Za-z0-9._-], no '..'",
		})};
	}
	let target_url = lookup_agent(target_node);
	if (target_url == null) {
		return { status: 404, body: stringify({
			error: "no agent for target_node: " + target_node,
		})};
	}

	let sources = known_sources_for(alias, target_node);
	let source_kind = payload?.source_kind;
	let pull_body = null;

	// Operator-supplied source_kind narrows; absence means "auto-pick".
	// Auto-pick prefers peer (LAN, faster) over HF (internet).
	if (source_kind == "peer" || (source_kind == null && sources.peer.length > 0)) {
		if (sources.peer.length == 0) {
			return { status: 422, body: stringify({
				error: "no peer source for alias '" + alias + "'",
				known_sources: sources,
			})};
		}
		pull_body = { alias: alias, source: { kind: "peer",
			url: sources.peer[0].blob_url } };
	} else if (source_kind == "huggingface" || source_kind == null) {
		if (sources.hf.length == 0) {
			return { status: 422, body: stringify({
				error: "no source available for alias '" + alias
					+ "' (no peer has it on disk and no profile names "
					+ "an hf_source for this alias)",
				known_sources: sources,
			})};
		}
		pull_body = { alias: alias, source: { kind: "huggingface",
			repo: sources.hf[0].repo, file: sources.hf[0].file } };
	} else {
		return { status: 400, body: stringify({
			error: "unknown source_kind: " + source_kind
				+ " (expected 'peer' or 'huggingface')",
		})};
	}

	try {
		let resp = cp_post_json(target_url + "/models/pull", pull_body);
		// Enrich the response with what we picked so the UI can show
		// "pulling from {repo} via HF" or "pulling from schneewolf via peer".
		if (resp.status_code >= 200 && resp.status_code < 300) {
			let body = parse(resp.body);
			body["target_node"] = target_node;
			body["source"] = pull_body.source;
			return { status: resp.status_code, body: stringify(body) };
		}
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({
			error: "target agent unreachable: " + e,
		})};
	}
}

// ── HuggingFace search + pull (v0.7+ slice C4) ───────────────────────
//
// CP-side proxies for the HF public API so the dashboard can let an
// operator type a name → pick a repo → pick a quant file → pull it
// onto a node. The agent already knows how to do `kind=huggingface`
// downloads; this just resolves the (repo, file) pair from a search
// query and brokers a single round-trip.
//
// All three endpoints take JSON bodies via POST rather than query
// strings because the router does exact path matching and HF repo
// IDs contain '/' which makes path-segment encoding awkward.

let HF_API_BASE = "https://huggingface.co/api";

// HF API fetches go through curl rather than the in-process http client:
// lws's TLS client wedges after the first HTTPS request in a process
// (first request 200, every subsequent one fails instantly), which broke
// repeated catalog searches. curl opens a fresh connection per call.
// Args pass via exec_argv (array form, no shell) so the URL can't inject.
// -w appends "\n<http_code>" so the last line is the status; everything
// before the final newline is the response body.
fn hf_get(url: string): object {
	let r = exec_argv(["curl", "-sSL", "--max-time", "30",
		"-w", "\n%{http_code}", url]);
	if (r.exit_code != 0) {
		throw "curl exit " + r.exit_code + ": " + r.output;
	}
	let out = r.output;
	let nl = -1;
	let i = 0;
	while (i < out.length) { if (out.substr(i, 1) == "\n") { nl = i; } i = i + 1; }
	let body = (nl >= 0) ? out.substr(0, nl) : out;
	let code_str = (nl >= 0) ? out.substr(nl + 1, out.length - nl - 1).trim() : "";
	let code = 0;
	try { code = i32(code_str); } catch (e) { code = 0; }
	return { status_code: code, body: body };
}

fn handle_hf_search(req): object {
	let payload = parse(req?.body ?? "{}");
	let q = payload?.q;
	if (q == null || q == "") {
		return { status: 400, body: stringify({ error: "q required" })};
	}
	// HF supports search + filter=gguf to narrow to GGUF-bearing repos.
	// limit=20 is plenty for a UI picker.
	// URL-encode the query — unencoded spaces/specials make a malformed
	// URL that fails instantly (the "HF unreachable" report). Use the
	// explicit-timeout GET (bare get() carries Hemlock's 5s default).
	let url = HF_API_BASE + "/models?search=" + url_encode(q) + "&filter=gguf&limit=20";
	try {
		let resp = hf_get(url);
		if (resp.status_code != 200) {
			return { status: 502, body: stringify({
				error: "HF search " + resp.status_code, body: resp.body }) };
		}
		let raw = parse(resp.body);
		let slim = [];
		for (m in raw) {
			slim.push({
				id:        m?.id,
				downloads: m?.downloads ?? 0,
				likes:     m?.likes ?? 0,
				updated:   m?.lastModified,
			});
		}
		return { status: 200, body: stringify(slim) };
	} catch (e) {
		return { status: 502, body: stringify({
			error: "HF unreachable: " + e })};
	}
}

fn handle_hf_files(req): object {
	let payload = parse(req?.body ?? "{}");
	let repo = payload?.repo;
	if (repo == null || repo == "") {
		return { status: 400, body: stringify({ error: "repo required" })};
	}
	// repo is "org/name" — slashes are real path separators, so it goes in
	// as-is. Validate first so a crafted repo can't inject extra URL path/
	// query segments against the HF API.
	if (!valid_hf_repo(repo)) {
		return { status: 400, body: stringify({ error: "invalid repo (expected org/name)" })};
	}
	let url = HF_API_BASE + "/models/" + repo + "/tree/main?recursive=true";
	try {
		let resp = hf_get(url);
		if (resp.status_code != 200) {
			return { status: 502, body: stringify({
				error: "HF tree " + resp.status_code, body: resp.body }) };
		}
		let raw = parse(resp.body);
		// Filter to .gguf files only; tag whether the file is sharded
		// so the picker can warn (multi-part GGUFs need all parts +
		// llama.cpp picks them up by base path).
		let ggufs = [];
		for (e in raw) {
			if (e?.type == "file" && e?.path != null
				&& e.path.ends_with(".gguf")) {
				ggufs.push({
					path: e.path,
					size: e?.size ?? 0,
					sharded: e.path.find("-of-") >= 0,
				});
			}
		}
		return { status: 200, body: stringify(ggufs) };
	} catch (e) {
		return { status: 502, body: stringify({
			error: "HF unreachable: " + e })};
	}
}

// ── model-card scrape (album-art metadata) ───────────────────────────
// POST /api/hf/card { repo } → repo metadata + the first model-card image,
// for an "album art" view. SECURITY:
//   - repo is char-validated (org/name only) so it can't smuggle path
//     tricks into the upstream URL.
//   - the image URL must resolve to a HuggingFace host AND a raster
//     extension — no SVG (no script-in-image), no arbitrary remote hosts
//     (no SSRF / tracking pixels). Anything else is dropped to "".
//   - all text is returned as plain text; the UI renders it via x-text
//     (textContent), so there's no HTML/script injection path.

fn valid_hf_repo(repo): bool {
	if (repo == null || repo.length == 0 || repo.length > 120) { return false; }
	if (repo.substr(0, 1) == "-") { return false; }   // no flag injection downstream
	let slashes = 0;
	let i = 0;
	while (i < repo.length) {
		let c = repo.substr(i, 1);
		let ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z")
			|| (c >= "0" && c <= "9") || c == "/" || c == "-" || c == "_" || c == ".";
		if (!ok) { return false; }
		if (c == "/") { slashes = slashes + 1; }
		i = i + 1;
	}
	if (slashes != 1) { return false; }
	// Both segments must be non-empty and not dot-only — "org/.." would
	// otherwise pass the char filter and traverse the upstream URL path.
	let sl = repo.find("/");
	let org = repo.substr(0, sl);
	let name = repo.substr(sl + 1, repo.length - sl - 1);
	if (org.length == 0 || name.length == 0) { return false; }
	if (org == "." || org == ".." || name == "." || name == "..") { return false; }
	return true;
}

// A pull alias becomes a filename component on the target node
// (canonical/<alias>.gguf). Mirror the agent's valid_alias() so a bad
// alias is rejected at the CP edge too. Single safe segment only.
fn valid_pull_alias(alias): bool {
	if (alias == null || alias.length == 0 || alias.length > 128) { return false; }
	if (alias.find("/") >= 0) { return false; }
	if (alias.find("..") >= 0) { return false; }
	if (alias.substr(0, 1) == "-") { return false; }
	let i = 0;
	while (i < alias.length) {
		let c = alias.substr(i, 1);
		let ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z")
			|| (c >= "0" && c <= "9") || c == "." || c == "_" || c == "-";
		if (!ok) { return false; }
		i = i + 1;
	}
	return true;
}

// A repo-relative file path inside an HF tree (may be nested). Same
// charset as a repo, plus must reject '..' anywhere and a leading '-'.
fn valid_hf_file(file): bool {
	if (file == null || file.length == 0 || file.length > 256) { return false; }
	if (file.substr(0, 1) == "-") { return false; }
	if (file.find("..") >= 0) { return false; }
	let i = 0;
	while (i < file.length) {
		let c = file.substr(i, 1);
		let ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z")
			|| (c >= "0" && c <= "9") || c == "/" || c == "-" || c == "_" || c == ".";
		if (!ok) { return false; }
		i = i + 1;
	}
	return true;
}

fn hf_host_ok(url): bool {
	if (url == null || url.find("https://") != 0) { return false; }
	let rest = url.substr(8, url.length - 8);
	let slash = rest.find("/");
	let host = (slash < 0) ? rest : rest.substr(0, slash);
	let colon = host.find(":");
	if (colon >= 0) { host = host.substr(0, colon); }
	if (host == "huggingface.co") { return true; }
	let suf = ".huggingface.co";
	if (host.length > suf.length
		&& host.substr(host.length - suf.length, suf.length) == suf) { return true; }
	return false;
}

fn raster_ext_ok(url): bool {
	let u = url.to_lower();
	let qm = u.find("?");
	if (qm >= 0) { u = u.substr(0, qm); }
	return u.ends_with(".png") || u.ends_with(".jpg") || u.ends_with(".jpeg")
		|| u.ends_with(".webp") || u.ends_with(".gif");
}

// First markdown ![](url) or HTML <img src> in the README (earliest wins).
fn readme_first_image(readme): string {
	let md = "";
	let a = readme.find("![");
	if (a >= 0) {
		let r = readme.substr(a, readme.length - a);
		let op = r.find("](");
		if (op >= 0) {
			let after = r.substr(op + 2, r.length - op - 2);
			let cp = after.find(")");
			let sp = after.find(" ");
			let e = cp;
			if (sp >= 0 && (cp < 0 || sp < cp)) { e = sp; }
			if (e > 0) { md = after.substr(0, e).trim(); }
		}
	}
	let html = "";
	let b = readme.find("<img");
	if (b >= 0) {
		let r = readme.substr(b, readme.length - b);
		let s = r.find("src=");
		if (s >= 0) {
			let after = r.substr(s + 4, r.length - s - 4);
			let q = after.substr(0, 1);
			if (q == "\"" || q == "'") {
				let inner = after.substr(1, after.length - 1);
				let eq = inner.find(q);
				if (eq > 0) { html = inner.substr(0, eq).trim(); }
			}
		}
	}
	if (md != "" && html != "") { return (a <= b) ? md : html; }
	if (md != "") { return md; }
	return html;
}

fn resolve_card_image(raw, repo): string {
	if (raw == null || raw == "") { return ""; }
	let url = raw;
	if (url.find("http") != 0) {
		let rel = url;
		if (rel.find("/") == 0) { rel = rel.substr(1, rel.length - 1); }
		url = "https://huggingface.co/" + repo + "/resolve/main/" + rel;
	}
	if (!hf_host_ok(url)) { return ""; }
	if (!raster_ext_ok(url)) { return ""; }
	return url;
}

fn card_summary(readme): string {
	let body = readme;
	if (body.find("---") == 0) {
		let after = body.substr(3, body.length - 3);
		let end = after.find("\n---");
		if (end >= 0) { body = after.substr(end + 4, after.length - end - 4); }
	}
	let lines = body.split("\n");
	let pick = "";
	for (line in lines) {
		let t = line.trim();
		if (t.length < 40) { continue; }
		let c0 = t.substr(0, 1);
		if (c0 == "#" || c0 == "!" || c0 == "[" || c0 == "<" || c0 == "|"
			|| c0 == "-" || c0 == "`" || c0 == ">" || c0 == "*") { continue; }
		pick = t; break;
	}
	// drop any HTML tags (defence-in-depth; UI also escapes via x-text)
	let out = "";
	let depth = 0;
	let i = 0;
	while (i < pick.length) {
		let c = pick.substr(i, 1);
		if (c == "<") { depth = depth + 1; }
		else if (c == ">") { if (depth > 0) { depth = depth - 1; } }
		else if (depth == 0) { out = out + c; }
		i = i + 1;
	}
	out = out.trim();
	if (out.length > 280) { out = out.substr(0, 277) + "..."; }
	return out;
}

fn handle_hf_card(req): object {
	let payload = parse(req?.body ?? "{}");
	let repo = payload?.repo;
	if (!valid_hf_repo(repo)) {
		return { status: 400, body: stringify({ error: "invalid repo" }) };
	}
	// Cache hit (fresh within 14d) → serve the stored card, no HF round-trip.
	let cached = query(DB,
		"select card_json from hf_card_cache where repo = ? "
		+ "and fetched_at > datetime('now', '-14 days')", [repo]);
	if (cached.length > 0) {
		return { status: 200, body: cached[0].card_json,
			headers: { "content-type": "application/json" } };
	}
	let meta = {};
	try {
		let resp = hf_get(HF_API_BASE + "/models/" + repo);
		if (resp.status_code == 200) { meta = parse(resp.body); }
	} catch (e) { }
	let tags = meta?.tags ?? [];
	let license = "";
	let disp_tags = [];
	for (t in tags) {
		let ts = "" + t;
		if (ts.find("license:") == 0) { license = ts.substr(8, ts.length - 8); }
		else if (disp_tags.length < 8) { disp_tags.push(ts); }
	}
	let image = "";
	let summary = "";
	try {
		let rr = hf_get("https://huggingface.co/" + repo + "/raw/main/README.md");
		if (rr.status_code == 200) {
			image = resolve_card_image(readme_first_image(rr.body), repo);
			summary = card_summary(rr.body);
		}
	} catch (e) { }
	let card = stringify({
		id: repo,
		downloads: meta?.downloads ?? 0,
		likes: meta?.likes ?? 0,
		pipeline_tag: meta?.pipeline_tag,
		license: license,
		tags: disp_tags,
		summary: summary,
		image: image,
	});
	exec(DB,
		"insert into hf_card_cache (repo, card_json, fetched_at) values (?, ?, ?) "
		+ "on conflict(repo) do update set card_json=excluded.card_json, fetched_at=excluded.fetched_at",
		[repo, card, iso_now()]);
	return { status: 200, body: card, headers: { "content-type": "application/json" } };
}

fn valid_hf_author(a): bool {
	if (a == null || a.length == 0 || a.length > 60) { return false; }
	let i = 0;
	while (i < a.length) {
		let c = a.substr(i, 1);
		let ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z")
			|| (c >= "0" && c <= "9") || c == "-" || c == "_" || c == ".";
		if (!ok) { return false; }
		i = i + 1;
	}
	return true;
}

// POST /api/hf/discover { sort, author? } → top GGUF repos by trending /
// newest / likes / downloads, optionally scoped to one author. Marks each
// result trusted=true if its author is in the configured trusted list.
// sort + author are allowlisted/char-validated before hitting the API.
fn handle_hf_discover(req): object {
	let payload = parse(req?.body ?? "{}");
	let sort_in = payload?.sort ?? "trending";
	let sort = "trendingScore";
	if (sort_in == "newest") { sort = "createdAt"; }
	else if (sort_in == "likes") { sort = "likes"; }
	else if (sort_in == "downloads") { sort = "downloads"; }
	let url = HF_API_BASE + "/models?filter=gguf&sort=" + sort + "&direction=-1&limit=24";
	let author = payload?.author;
	if (author != null && author != "") {
		if (!valid_hf_author(author)) {
			return { status: 400, body: stringify({ error: "invalid author" }) };
		}
		url = url + "&author=" + author;
	}
	// trusted set from settings
	let trusted = {};
	let csv = setting_get("hf_trusted_authors", "");
	for (a in csv.split(",")) {
		let aa = a.trim().to_lower();
		if (aa != "") { trusted[aa] = true; }
	}
	try {
		let resp = hf_get(url);
		if (resp.status_code != 200) {
			return { status: 502, body: stringify({ error: "HF discover " + resp.status_code }) };
		}
		let raw = parse(resp.body);
		let out = [];
		for (m in raw) {
			let id = m?.id ?? "";
			let auth = "";
			let sl = id.find("/");
			if (sl > 0) { auth = id.substr(0, sl); }
			out.push({
				id:        id,
				author:    auth,
				downloads: m?.downloads ?? 0,
				likes:     m?.likes ?? 0,
				updated:   m?.lastModified,
				trusted:   trusted.has(auth.to_lower()),
			});
		}
		return { status: 200, body: stringify(out) };
	} catch (e) {
		return { status: 502, body: stringify({ error: "HF unreachable: " + e }) };
	}
}

// Default alias for a freshly-pulled HF file: filename minus `.gguf`,
// lowercased, dashes for underscores. Operator can override in the
// pull body. Sharded files (`…-00001-of-00003.gguf`) lose the shard
// suffix so all parts share an alias.
fn default_alias_for_hf(file: string): string {
	let base = file;
	let slash = base.find("/");
	while (slash >= 0) {
		base = base.substr(slash + 1, base.length - slash - 1);
		slash = base.find("/");
	}
	if (base.ends_with(".gguf")) {
		base = base.substr(0, base.length - 5);
	}
	let shard = base.find("-00001-of-");
	if (shard > 0) { base = base.substr(0, shard); }
	return base.to_lower();
}

fn handle_pull_hf(req): object {
	let payload = parse(req?.body ?? "{}");
	let repo = payload?.repo;
	let file = payload?.file;
	let target_node = payload?.target_node;
	if (repo == null || file == null || target_node == null) {
		return { status: 400, body: stringify({
			error: "repo + file + target_node required" })};
	}
	// Validate here too (belt + suspenders — the agent re-checks at the
	// filesystem boundary, but reject early so a bad request never reaches
	// a node). repo/file flow into `hf download` argv + a local path.
	if (!valid_hf_repo(repo)) {
		return { status: 400, body: stringify({ error: "invalid repo (expected org/name)" })};
	}
	if (!valid_hf_file(file)) {
		return { status: 400, body: stringify({ error: "invalid file path" })};
	}
	let alias = payload?.alias;
	if (alias == null || alias == "") { alias = default_alias_for_hf(file); }
	if (!valid_pull_alias(alias)) {
		return { status: 400, body: stringify({
			error: "invalid alias: single segment of [A-Za-z0-9._-], no '..'" })};
	}

	let target_url = lookup_agent(target_node);
	if (target_url == null) {
		return { status: 404, body: stringify({
			error: "no agent for target_node: " + target_node })};
	}
	let pull_body = { alias: alias,
		source: { kind: "huggingface", repo: repo, file: file } };
	try {
		let resp = cp_post_json(target_url + "/models/pull", pull_body);
		if (resp.status_code >= 200 && resp.status_code < 300) {
			let body = parse(resp.body);
			body["target_node"] = target_node;
			body["alias"] = alias;
			body["source"] = pull_body.source;
			return { status: resp.status_code, body: stringify(body) };
		}
		return { status: resp.status_code, body: resp.body };
	} catch (e) {
		return { status: 502, body: stringify({
			error: "target agent unreachable: " + e })};
	}
}

// ── placement preview ───────────────────────────────────────────────
//
// POST /api/placement_preview { profile_name } → preview of where an
// auto-spawn for this profile WOULD land right now (without spawning).
// Drives the spawn form's "would land on schneewolf GPU 2..." hint.
// Returns one of:
//   { ok: true,  node_id, gpu_indices, est_mb, free_mb_on_picked_gpus, model_path }
//   { ok: false, reason }   -- placement declined; reason is operator-readable
fn handle_placement_preview(req): object {
	let payload = parse(req?.body ?? "{}");
	let profile_name = payload?.profile_name;
	if (profile_name == null || profile_name == "") {
		return { status: 400, body: stringify({ error: "profile_name required" }) };
	}
	let profile = fetch_profile(profile_name);
	if (profile == null) {
		return { status: 404, body: stringify({
			ok: false, reason: "no profile named " + profile_name }) };
	}

	// Honor the device selector so the preview matches what a spawn would do.
	let req_device = payload?.device;
	if (req_device != null && req_device != "" && !is_valid_device(req_device)) {
		return { status: 400, body: stringify({
			error: "invalid device '" + req_device + "' (expected auto|cpu|gpu)" }) };
	}
	profile = apply_device(profile, resolve_device(req_device, profile));

	if (profile?.binary == "local") {
		let lp = pick_placement_local(profile);
		if (lp?.error != null) {
			return { status: 200, body: stringify({ ok: false, reason: lp.error }) };
		}
		return { status: 200, body: stringify({
			ok:          true,
			node_id:     lp.node_id,
			gpu_indices: lp.gpu_indices,
			cpu_only:    lp.gpu_indices.length == 0,
			est_mb:      lp.est_mb,
			model_path:  lp.model_path,
		})};
	}

	// Alias path — same logic as auto_spawn() takes. Only previews the
	// alias case; default_model fallback would need pick_placement which
	// stats the file from CP's box and isn't meaningful as a preview.
	let alias = profile?.model_alias;
	if (alias == null) {
		return { status: 200, body: stringify({
			ok: false,
			reason: "profile has no model_alias; placement preview only "
				+ "covers the catalog path. Spawn will fall back to "
				+ "default_model resolution.",
		})};
	}
	let pick = pick_placement_via_alias(alias, profile);
	if (pick == null) {
		// Why no fit? Either no node has the alias, or no GPU has room.
		let candidates = nodes_with_alias(alias);
		if (candidates.length == 0) {
			return { status: 200, body: stringify({
				ok: false,
				reason: "alias '" + alias + "' is not on any node's disk. "
					+ "Pull it via the catalog page first.",
			})};
		}
		// Have the alias, missing VRAM. Estimate the need.
		let est = estimate_vram_from_ingredients(candidates[0],
			i32(profile.context), profile.kv_type);
		return { status: 200, body: stringify({
			ok: false,
			reason: "no node has free VRAM to fit the model + KV cache "
				+ "(~" + i32(est.total_mb) + " MB needed)",
			est_mb: est.total_mb,
		})};
	}

	// Compute free_mb on the picked GPUs so the dashboard can show
	// the headroom that'd remain after the spawn.
	// Aggregate either free vram on the picked GPUs (normal) or free
	// RAM on the node (cpu_only profiles), so the preview hint shows
	// the right capacity number for each placement mode.
	let nodes = query(DB,
		"select hardware_json from nodes where node_id = ?", [pick.node_id]);
	let free_total: i64 = 0;
	let cpu_only = (pick.gpu_indices.length == 0);
	if (nodes.length > 0) {
		let hw = parse(nodes[0].hardware_json);
		if (cpu_only) {
			free_total = i64(hw?.ram_free_mb ?? 0);
		} else {
			let gpus = hw?.gpus ?? [];
			for (g in gpus) {
				for (idx in pick.gpu_indices) {
					if (g.index == idx) { free_total = free_total + g.free_mb; }
				}
			}
		}
	}

	return { status: 200, body: stringify({
		ok:                    true,
		node_id:               pick.node_id,
		gpu_indices:           pick.gpu_indices,
		cpu_only:              cpu_only,
		est_mb:                pick.est_mb,
		free_mb_on_picked_gpus: free_total,
		model_path:            pick.model_path,
	})};
}

// GET /services/log/{node_id}/{service_id} — proxy the agent's
// /services/log/{id}, returns raw text. Dashboard pulls this into
// a modal for tail-ing without SSH.
fn handle_service_log(req): object {
	let prefix = "/services/log/";
	let rest = req.path.substr(prefix.length, req.path.length - prefix.length);
	let slash = rest.find("/");
	if (slash <= 0) {
		return { status: 400, body: "{\"error\":\"expected /services/log/{node}/{id}\"}" };
	}
	let node_id = rest.substr(0, slash);
	let id = rest.substr(slash + 1, rest.length - slash - 1);
	let agent_url = lookup_agent(node_id);
	if (agent_url == null) {
		return { status: 404, body: stringify({ error: "no agent for node: " + node_id }) };
	}
	try {
		let resp = cp_get(agent_url + "/services/log/" + id);
		return { status: resp.status_code, body: resp.body,
			headers: { "content-type": "text/plain; charset=utf-8" } };
	} catch (e) {
		return { status: 502, body: stringify({ error: "agent unreachable: " + e }) };
	}
}

// ── transfers aggregator ─────────────────────────────────────────────
fn aggregated_transfers(): array {
	let agents = list_all_agents();
	let merged = [];
	for (a in agents) {
		try {
			let resp = cp_get(a.agent_url + "/models/transfers");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				let entries = parse(resp.body);
				for (e in entries) {
					e["node_id"] = a.node_id;
					merged.push(e);
				}
			}
		} catch (e) { }
	}
	return merged;
}

fn handle_list_transfers(req): object {
	return { status: 200, body: stringify(aggregated_transfers()) };
}

// ── bench ────────────────────────────────────────────────────────
//
// Operator-triggered benchmark. Pin-spawn a profile on a target
// node, fire N timed completion requests, record aggregate stats,
// stop the service. All async — POST returns 202 + bench_id, then
// the operator polls /api/bench/{id} for progress.

let BENCH_READY_TIMEOUT_SECONDS = 120;
let BENCH_REQUEST_TIMEOUT_MS    = 120000;

// Median of an array of numbers. Mutates input via sort. Empty array
// → 0. We use median (not mean) because a single slow first request
// — typical when the model is still warming up its sampler state —
// shouldn't dominate the perceived per-token throughput number.
fn median(xs: array): f64 {
	if (xs.length == 0) { return 0.0; }
	xs.sort();
	let n: i32 = i32(xs.length);
	let mid: i32 = n / 2;
	if (n % 2 == 1) { return f64(xs[mid]); }
	return (f64(xs[mid - 1]) + f64(xs[mid])) / 2.0;
}

fn fetch_node_build_hash(node_id: string) {
	let rows = query(DB,
		"select runtime_json from nodes where node_id = ?", [node_id]);
	if (rows.length == 0 || rows[0]?.runtime_json == null) { return null; }
	let rt = parse(rows[0].runtime_json);
	return rt?.llama_server?.build_hash;
}

// The actual bench task. Runs detached on a worker thread.
async fn bench_task(bench_id: string, target_node: string,
                    profile_name: string, prompt: string,
                    n_predict: i32, repetitions: i32): null {
	// Fetch profile so we can do the spawn. fetch_profile is the
	// same lookup the routing proxy uses; null = unknown profile.
	let profile = fetch_profile_by_name(profile_name);
	if (profile == null) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["unknown profile: " + profile_name, bench_id]);
		return null;
	}
	let agent_url = lookup_agent(target_node);
	if (agent_url == null) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["no agent for node: " + target_node, bench_id]);
		return null;
	}

	// Resolve the model. Same priority as handle_spawn_proxy: alias
	// → catalog row's path on this node, else profile.default_model.
	let model_path = null;
	let resolved_gpus = null;
	let resolved_split = null;
	if (profile?.model_alias != null) {
		// Look up the alias on the TARGET node (placement is forced).
		let rows = query(DB,
			"select path from node_models where node_id = ? and alias = ?",
			[target_node, profile.model_alias]);
		if (rows.length > 0) { model_path = rows[0].path; }
	}
	if (model_path == null) { model_path = profile?.default_model; }
	let mp = model_path;
	if (mp == null) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["no model resolvable for profile " + profile_name + " on node " + target_node,
			 bench_id]);
		return null;
	}

	// For multi-GPU placement on this target, defer to pick_gpu_subset
	// like the routing proxy does (operator can pin in a future flag,
	// but for now bench picks intelligently).
	let nodes = query(DB,
		"select hardware_json from nodes where node_id = ?", [target_node]);
	if (nodes.length > 0) {
		let hw = parse(nodes[0].hardware_json);
		let gpus = hw?.gpus ?? [];
		let est = estimate_vram_from_ingredients_or_path(profile, mp, target_node);
		let subset = pick_gpu_subset(gpus, est);
		if (subset != null) {
			resolved_gpus = subset.indices;
			if (subset.indices.length > 1) { resolved_split = subset.tensor_split; }
		}
	}
	if (resolved_gpus == null) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["bench: no GPU subset on " + target_node + " fits this profile",
			 bench_id]);
		return null;
	}

	// Capture build_hash NOW so the bench result is pinned to the
	// exact build that ran it (operator might activate a different
	// build mid-way — we want the recorded one).
	let build_hash = fetch_node_build_hash(target_node);
	db_exec(DB,
		"update bench_runs set status='spawning', build_hash=? where id=?",
		[build_hash, bench_id]);

	let port = pick_port(agent_url, profile.default_port);
	let agent_payload = {
		profile_name: profile_name,
		profile:      profile,
		model:        mp,
		port:         port,
		gpus:         resolved_gpus,
		tensor_split: resolved_split,
	};

	let spawn_resp = null;
	try {
		spawn_resp = cp_post_json(agent_url + "/services", agent_payload);
	} catch (e) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["spawn failed: " + e, bench_id]);
		return null;
	}
	if (spawn_resp.status_code < 200 || spawn_resp.status_code >= 300) {
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["spawn HTTP " + spawn_resp.status_code + ": " + spawn_resp.body, bench_id]);
		return null;
	}
	let svc = parse(spawn_resp.body);
	let svc_id = svc.id;
	let host = extract_host(agent_url);

	if (!wait_for_service_ready(host, port, "/health", BENCH_READY_TIMEOUT_SECONDS)) {
		try { cp_post_json(agent_url + "/services/stop", { id: svc_id }); } catch (e) { }
		db_exec(DB, "update bench_runs set status='error', error=? where id=?",
			["service didn't become ready in " + BENCH_READY_TIMEOUT_SECONDS + "s", bench_id]);
		return null;
	}

	db_exec(DB, "update bench_runs set status='running' where id=?", [bench_id]);

	// Fire repetitions sequentially. Concurrent fire would inflate
	// per-request latency through queueing on the single-slot
	// llama-server we spawned (parallel_slots: 1 in the chat profile);
	// sequential gives us realistic per-request numbers.
	let llama_url = "http://" + host + ":" + port + "/completion";
	let body_json = stringify({
		prompt:    prompt,
		n_predict: n_predict,
		stream:    false,
	});
	let headers = ["Content-Type: application/json"];
	let ttft_samples = [];
	let total_samples = [];
	let tokens_samples = [];
	let toksec_samples = [];
	let first_output = null;
	let r = 0;
	while (r < repetitions) {
		let t0 = unix_ms();
		let resp = null;
		try {
			resp = http_request_timeout("POST", llama_url, body_json, headers, BENCH_REQUEST_TIMEOUT_MS);
		} catch (e) {
			eprint("[bench " + bench_id + "] rep " + r + " failed: " + e);
			r = r + 1;
			continue;
		}
		let t_total = unix_ms() - t0;
		if (resp.status_code < 200 || resp.status_code >= 300) {
			eprint("[bench " + bench_id + "] rep " + r + " HTTP " + resp.status_code);
			r = r + 1;
			continue;
		}
		let body = parse(resp.body);
		// llama-server's /completion response includes a `timings`
		// block with per-token detail. Use it when available; falls
		// back to wall-clock if not.
		let timings = body?.timings;
		let predicted_n = body?.tokens_predicted ?? 0;
		let predicted_ms = (timings?.predicted_ms ?? f64(t_total));
		let prompt_ms = timings?.prompt_ms ?? 0.0;
		// TTFT ≈ time spent processing the prompt before the first
		// output token. With stream:false we don't see real TTFT
		// (the whole response arrives at once) — use prompt_ms as a
		// proxy.
		ttft_samples.push(i32(prompt_ms));
		total_samples.push(t_total);
		tokens_samples.push(predicted_n);
		if (predicted_ms > 0.0 && predicted_n > 0) {
			toksec_samples.push(f64(predicted_n) * 1000.0 / predicted_ms);
		}
		if (first_output == null) {
			let content = body?.content ?? "";
			if (content.length > 500) { content = content.substr(0, 500); }
			first_output = content;
		}
		r = r + 1;
	}

	// Stop the service before recording — we want the row to be
	// final state, not a "complete but service is still draining"
	// confusion.
	try { cp_post_json(agent_url + "/services/stop", { id: svc_id }); } catch (e) { }

	let ttft_med    = median(ttft_samples);
	let total_med   = median(total_samples);
	let tokens_med  = median(tokens_samples);
	let toksec_med  = 0.0;
	if (toksec_samples.length > 0) {
		toksec_med = median(toksec_samples);
	}
	let now = iso_now();
	db_exec(DB,
		"update bench_runs "
		+ "set status='complete', ttft_ms_median=?, tok_per_sec_median=?, "
		+ "total_ms_median=?, tokens_predicted_median=?, output_excerpt=?, "
		+ "completed_at=? "
		+ "where id=?",
		[ttft_med, toksec_med, total_med, i32(tokens_med),
		 (first_output ?? ""), now, bench_id]);
	print("[bench] " + bench_id + " complete: median "
		+ i32(toksec_med) + " tok/s on " + target_node);
	return null;
}

// Compute an estimated VRAM number for this (profile, model) on this
// node. Tries the catalog row's pre-extracted ingredients first; if
// the alias isn't in this node's catalog (e.g. operator passed a
// raw default_model path), falls back to a conservative 1.5x file
// size estimate so we at least pick *some* GPU.
fn estimate_vram_from_ingredients_or_path(profile, model_path, target_node: string): f64 {
	let alias = profile?.model_alias;
	if (alias != null) {
		let rows = query(DB,
			"select size_mb, architecture, n_layers, n_heads, n_kv_heads, embedding_length "
			+ "from node_models where node_id = ? and alias = ?",
			[target_node, alias]);
		if (rows.length > 0) {
			let est = estimate_vram_from_ingredients(rows[0],
				i32(profile.context), profile.kv_type);
			return est.total_mb;
		}
	}
	return 1.5 * 8000.0;  // ~12 GB best-effort fallback
}

fn handle_create_bench(req): object {
	let payload = null;
	try { payload = parse(req.body); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	let target_node  = payload?.target_node;
	let profile_name = payload?.profile_name;
	let prompt       = payload?.prompt;
	let n_predict    = payload?.n_predict ?? 100;
	let repetitions  = payload?.repetitions ?? 3;
	if (target_node == null || profile_name == null || prompt == null) {
		return { status: 400, body: stringify({
			error: "target_node, profile_name, prompt required",
		})};
	}
	let r = query(DB, "select hex(randomblob(8)) as id", []);
	let id = r[0].id;
	let now = iso_now();
	exec(DB,
		"insert into bench_runs "
		+ "(id, node_id, profile_name, prompt, n_predict, repetitions, status, started_at) "
		+ "values (?, ?, ?, ?, ?, ?, 'queued', ?)",
		[id, target_node, profile_name, prompt, n_predict, repetitions, now]);
	let t = spawn(bench_task, id, target_node, profile_name, prompt, n_predict, repetitions);
	detach(t);
	return { status: 202, body: stringify({
		bench_id: id, target_node: target_node, profile_name: profile_name,
	})};
}

fn bench_row_to_obj(row): object {
	return {
		id:                       row.id,
		node_id:                  row.node_id,
		profile_name:             row.profile_name,
		build_hash:               row?.build_hash,
		prompt:                   row.prompt,
		n_predict:                row.n_predict,
		repetitions:              row.repetitions,
		ttft_ms_median:           row?.ttft_ms_median,
		tok_per_sec_median:       row?.tok_per_sec_median,
		total_ms_median:          row?.total_ms_median,
		tokens_predicted_median:  row?.tokens_predicted_median,
		output_excerpt:           row?.output_excerpt,
		status:                   row.status,
		error:                    row?.error,
		started_at:               row.started_at,
		completed_at:             row?.completed_at,
	};
}

fn handle_list_bench(req): object {
	let rows = query(DB,
		"select id, node_id, profile_name, build_hash, prompt, n_predict, "
		+ "repetitions, ttft_ms_median, tok_per_sec_median, total_ms_median, "
		+ "tokens_predicted_median, output_excerpt, status, error, "
		+ "started_at, completed_at "
		+ "from bench_runs order by started_at desc limit 100", []);
	let out = [];
	for (row in rows) { out.push(bench_row_to_obj(row)); }
	return { status: 200, body: stringify(out) };
}

fn handle_get_bench(req): object {
	let prefix = "/api/bench/";
	let id = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (id.length == 0) {
		return { status: 400, body: "{\"error\":\"bench id required\"}" };
	}
	let rows = query(DB,
		"select id, node_id, profile_name, build_hash, prompt, n_predict, "
		+ "repetitions, ttft_ms_median, tok_per_sec_median, total_ms_median, "
		+ "tokens_predicted_median, output_excerpt, status, error, "
		+ "started_at, completed_at "
		+ "from bench_runs where id = ?", [id]);
	if (rows.length == 0) {
		return { status: 404, body: stringify({ error: "no such bench: " + id }) };
	}
	return { status: 200, body: stringify(bench_row_to_obj(rows[0])) };
}

// ── profile CRUD ─────────────────────────────────────────────────
//
// Profiles live in CP's sqlite (since v0.7). Spawn flow inlines the
// full profile JSON into the agent_payload — agents don't need to
// know what profiles exist, they just run what CP tells them.

// Returns the parsed profile object for `name`, or null if absent.
// Used by spawn/auto_spawn to inline profile data into agent calls.
fn fetch_profile_by_name(name: string) {
	let r = query(DB,
		"select profile_json, version from profiles where name = ?",
		[name]);
	if (r.length == 0) { return null; }
	let p = parse(r[0].profile_json);
	p["__name"] = name;
	p["__version"] = r[0].version;
	return p;
}

// Map of name → profile object (with __name + __version stamped),
// for callers that want the full set (dashboard, spawn form).
fn all_profiles_map(): object {
	let rows = query(DB,
		"select name, profile_json, version from profiles order by name asc",
		[]);
	let out = {};
	for (row in rows) {
		let p = parse(row.profile_json);
		p["__name"] = row.name;
		p["__version"] = row.version;
		out[row.name] = p;
	}
	return out;
}

fn handle_list_profiles_v2(req): object {
	return { status: 200, body: stringify(all_profiles_map()) };
}

fn handle_get_profile(req): object {
	// req.path = "/api/profiles/{name}" — strip prefix to get name.
	let prefix = "/api/profiles/";
	let name = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (name.length == 0) {
		return { status: 400, body: "{\"error\":\"profile name required\"}" };
	}
	let p = fetch_profile_by_name(name);
	if (p == null) {
		return { status: 404, body: stringify({ error: "no such profile: " + name }) };
	}
	return { status: 200, body: stringify(p) };
}

// Shape check shared by create + update. Returns an error message, or
// null when the profile is acceptable. Deliberately shallow: fields the
// agent doesn't know are still allowed (profiles carry UI metadata), but
// the two mistakes that silently store a profile no spawn can use are
// refused — a non-object body, and PUT given POST's { name, profile }
// wrapper, which used to be saved verbatim as the profile.
let KNOWN_BINARIES = ["llama-server", "sd-server", "whisper-server", "piper", "local"];

fn validate_profile(profile, is_put: bool) {
	if (profile == null || typeof(profile) != "object") {
		return "profile must be a JSON object";
	}
	if (profile?.binary == null && profile?.intent == null && profile?.profile != null) {
		if (is_put) {
			return "PUT takes the profile object itself, not { profile: {...} }; "
				+ "send the inner object as the body";
		}
		return "profile is nested twice ({ profile: { profile: ... } })";
	}
	if (profile?.binary != null && !KNOWN_BINARIES.contains(profile.binary)) {
		return "unknown binary '" + profile.binary + "'; expected one of "
			+ KNOWN_BINARIES.join(", ");
	}
	if (profile?.intent != null && typeof(profile.intent) != "object") {
		return "intent must be an object";
	}
	if (profile?.extra_flags != null && typeof(profile.extra_flags) != "array") {
		return "extra_flags must be an array of strings";
	}
	let perr = pin_error(profile?.pin);
	if (perr != null) { return perr; }
	if (profile?.vram_mb != null && (!is_int_value(profile.vram_mb) || profile.vram_mb < 0)) {
		return "vram_mb must be a non-negative integer (MB the service needs, summed over its GPUs)";
	}
	if (profile?.share_group != null) {
		if (profile?.binary != null && profile.binary != "llama-server") {
			return "share_group is only for llama-server profiles";
		}
		let serr = sharing_profile_error(profile);
		if (serr != null) { return "share_group: " + serr; }
	}
	if (profile?.binary == "local") {
		// The command lives in the agent's declaration; a profile only
		// names it. Refuse argv-shaped fields outright rather than store
		// something that looks like it does something and is ignored.
		if (!valid_local_name(profile?.local_service)) {
			return "local profiles need local_service: the name of a service an agent "
				+ "declares ([a-z0-9][a-z0-9._-]{0,62})";
		}
		if (profile?.extra_flags != null && profile.extra_flags.length > 0) {
			return "local profiles take no extra_flags — the command line lives in the "
				+ "agent's declaration file, not in the profile";
		}
		if (profile?.default_port != null
			&& (!is_int_value(profile.default_port)
				|| profile.default_port < 1024 || profile.default_port > 65535)) {
			return "default_port must be an integer 1024-65535";
		}
	}
	return null;
}

// profile.pin = { node_id, gpus: [int], port? } — where this profile runs.
// Honoured by POST /services when the request doesn't place it itself,
// by /v1/llama auto-spawn, by the agent watchdog's respawn and by
// shared-group joins (a pinned spawn joins the server on exactly that GPU
// set). Written by POST /api/layout/apply (pin: true). null = unpinned.
fn pin_error(pin) {
	if (pin == null) { return null; }
	if (typeof(pin) != "object") { return "pin must be an object { node_id, gpus, port? } or null"; }
	if (pin?.node_id == null || typeof(pin.node_id) != "string" || pin.node_id.length == 0) {
		return "pin.node_id (string) is required";
	}
	if (pin?.gpus == null || typeof(pin.gpus) != "array") {
		return "pin.gpus must be an array of GPU indices ([] = CPU)";
	}
	for (g in pin.gpus) {
		if (!is_int_value(g) || g < 0 || g > 255) { return "pin.gpus must hold GPU indices (0-255)"; }
	}
	if (pin?.port != null && (!is_int_value(pin.port) || pin.port < 1024 || pin.port > 65535)) {
		return "pin.port must be an integer 1024-65535";
	}
	return null;
}

// POST /api/profiles  body: { name, profile: {...} }
// Refuses if name is taken; use PUT to update.
fn handle_create_profile(req): object {
	let payload = null;
	try { payload = parse(req.body); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	let name = payload?.name;
	let profile = payload?.profile;
	if (name == null || profile == null) {
		return { status: 400, body: "{\"error\":\"name + profile required\"}" };
	}
	let invalid = validate_profile(profile, false);
	if (invalid != null) {
		return { status: 400, body: stringify({ error: invalid }) };
	}
	let existing = query(DB, "select name from profiles where name = ?", [name]);
	if (existing.length > 0) {
		return { status: 409, body: stringify({
			error: "profile '" + name + "' already exists; PUT to update",
		})};
	}
	let now = iso_now();
	exec(DB,
		"insert into profiles (name, profile_json, version, created_at, updated_at) "
		+ "values (?, ?, 1, ?, ?)",
		[name, stringify(profile), now, now]);
	return { status: 201, body: stringify({ name: name, version: 1 }) };
}

// PUT /api/profiles/{name}  body: profile object (the full thing)
// Bumps version. Existing services keep their old profile (no auto-restart);
// next spawn picks up the new version.
fn handle_update_profile(req): object {
	let prefix = "/api/profiles/";
	let name = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (name.length == 0) {
		return { status: 400, body: "{\"error\":\"profile name required\"}" };
	}
	let profile = null;
	try { profile = parse(req.body); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	if (profile == null) {
		return { status: 400, body: "{\"error\":\"profile body required\"}" };
	}
	let invalid = validate_profile(profile, true);
	if (invalid != null) {
		return { status: 400, body: stringify({ error: invalid }) };
	}
	let existing = query(DB,
		"select version from profiles where name = ?", [name]);
	if (existing.length == 0) {
		return { status: 404, body: stringify({ error: "no such profile: " + name }) };
	}
	let new_version = existing[0].version + 1;
	let now = iso_now();
	exec(DB,
		"update profiles set profile_json = ?, version = ?, updated_at = ? "
		+ "where name = ?",
		[stringify(profile), new_version, now, name]);
	return { status: 200, body: stringify({ name: name, version: new_version }) };
}

// DELETE /api/profiles/{name}
// Refuses if any agent has an alive service running this profile —
// avoids leaving running services with no metadata. Operator stops
// the services first.
fn handle_delete_profile(req): object {
	let prefix = "/api/profiles/";
	let name = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (name.length == 0) {
		return { status: 400, body: "{\"error\":\"profile name required\"}" };
	}
	let existing = query(DB, "select name from profiles where name = ?", [name]);
	if (existing.length == 0) {
		return { status: 404, body: stringify({ error: "no such profile: " + name }) };
	}
	// Check fleet for live services using this profile.
	let agents = list_all_agents();
	let in_use = [];
	for (a in agents) {
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				let services = parse(resp.body);
				for (s in services) {
					if (s?.profile == name && s?.alive == true) {
						in_use.push(a.node_id);
					}
				}
			}
		} catch (e) { }
	}
	if (in_use.length > 0) {
		return { status: 409, body: stringify({
			error: "profile '" + name + "' has live services on: "
				+ in_use.join(", ") + ". Stop them first.",
		})};
	}
	exec(DB, "delete from profiles where name = ?", [name]);
	return { status: 204, body: "" };
}

// Fetch the last N samples for one (node, metric, series) ordered
// oldest → newest, for sparkline rendering. Returns an array of i32
// values. Empty array when there's no history yet (just-registered
// node, or before the next heartbeat lands).
fn fetch_samples(node_id: string, metric: string, series, limit: i32): array {
	let rows = null;
	if (series == null) {
		rows = query(DB,
			"select value from node_samples "
			+ "where node_id = ? and metric = ? and series is null "
			+ "order by sampled_at desc limit ?",
			[node_id, metric, limit]);
	} else {
		rows = query(DB,
			"select value from node_samples "
			+ "where node_id = ? and metric = ? and series = ? "
			+ "order by sampled_at desc limit ?",
			[node_id, metric, series, limit]);
	}
	// Reverse to oldest-first for the sparkline path.
	let out = [];
	let i = rows.length - 1;
	while (i >= 0) { out.push(rows[i].value); i = i - 1; }
	return out;
}

// Build the samples-per-node map the dashboard needs to render
// sparklines inline with the nodes table. Shape:
//   { node_id → {
//       gpu: { idx_str → [values...] },
//       ram: [values...],
//       disk: { path → [values...] },
//   }}
// SAMPLE_HISTORY_POINTS is the visual history length. 60 points at
// 30s heartbeat = 30 minutes of context — enough to see a load
// pattern emerge without overwhelming a 200px-wide sparkline.
let SAMPLE_HISTORY_POINTS = 60;

fn samples_for_dashboard(nodes_data): object {
	let out = {};
	for (n in nodes_data) {
		let bundle = { gpu: {}, gpu_power: {}, gpu_temp: {}, ram: [], cpu_temp: [], disk: {} };
		let gpus = n.hardware?.gpus ?? [];
		for (g in gpus) {
			bundle.gpu["" + g.index] = fetch_samples(n.node_id,
				"gpu_free_mb", "" + g.index, SAMPLE_HISTORY_POINTS);
			bundle.gpu_power["" + g.index] = fetch_samples(n.node_id,
				"gpu_power_w", "" + g.index, SAMPLE_HISTORY_POINTS);
			bundle.gpu_temp["" + g.index] = fetch_samples(n.node_id,
				"gpu_temp_c", "" + g.index, SAMPLE_HISTORY_POINTS);
		}
		bundle.ram = fetch_samples(n.node_id, "ram_free_mb", null,
			SAMPLE_HISTORY_POINTS);
		bundle.cpu_temp = fetch_samples(n.node_id, "cpu_temp_c", null,
			SAMPLE_HISTORY_POINTS);
		let disks = n.hardware?.disks ?? [];
		for (d in disks) {
			bundle.disk[d.path] = fetch_samples(n.node_id,
				"disk_free_mb", d.path, SAMPLE_HISTORY_POINTS);
		}
		out[n.node_id] = bundle;
	}
	return out;
}

// ── stats strip ──────────────────────────────────────────────────
// Top-of-page summary tiles. Pure aggregation over the existing
// /nodes + /catalog data, plus a fan-out to agents for service count.
fn compute_stats(): object {
	let agents = list_all_agents();
	let total_gpus = 0;
	let total_vram_free_mb: i64 = 0;
	let total_vram_mb: i64 = 0;
	let nodes = nodes_for_dashboard();
	for (n in nodes) {
		let gpus = n.hardware?.gpus ?? [];
		total_gpus = total_gpus + gpus.length;
		for (g in gpus) {
			total_vram_free_mb = total_vram_free_mb + g.free_mb;
			total_vram_mb = total_vram_mb + g.total_mb;
		}
	}
	let catalog = catalog_grouped();
	let total_catalog_mb: i64 = 0;
	for (e in catalog) { total_catalog_mb = total_catalog_mb + e.size_mb; }

	let running = 0;
	for (a in agents) {
		try {
			let resp = cp_get_fast(a.agent_url + "/services");
			if (resp.status_code >= 200 && resp.status_code < 300) {
				let entries = parse(resp.body);
				for (e in entries) { if (e?.alive == true) { running = running + 1; } }
			}
		} catch (e) { }
	}

	return {
		nodes:            nodes.length,
		nodes_live:       agents.length,
		total_gpus:       total_gpus,
		vram_free_mb:     total_vram_free_mb,
		vram_total_mb:    total_vram_mb,
		catalog_models:   catalog.length,
		catalog_total_mb: total_catalog_mb,
		services_running: running,
	};
}

fn handle_ui_stats(req): object {
	return { status: 200, body: render_stats(compute_stats()),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

// (handle_list_profiles removed — replaced by handle_list_profiles_v2
// which reads from CP's own profiles table since v0.7. Spawn form
// fetches /api/profiles, which routes to v2 directly.)

// Static assets — HTML shell + CSS + JS + logo, all baked into the
// binary at build time via scripts/embed_assets.sh. Served with a
// modest cache lifetime (the only way to change them is to rebuild
// and redeploy, but we still want operators iterating on the dashboard
// to see fresh bytes within seconds, not a day).
let ASSET_CACHE = "public, max-age=60";

fn html_response(body: string): object {
	return { status: 200, body: body,
		headers: { "content-type": "text/html; charset=utf-8",
			"cache-control": ASSET_CACHE } };
}

fn handle_page_overview(req): object  { return html_response(OVERVIEW_HTML); }
fn handle_page_catalog(req): object   { return html_response(PAGE_CATALOG); }
fn handle_page_transfers(req): object { return html_response(PAGE_TRANSFERS); }
fn handle_page_profiles(req): object  { return html_response(PAGE_PROFILES); }
fn handle_page_bench(req): object     { return html_response(PAGE_BENCH); }
fn handle_page_deploy(req): object    { return html_response(PAGE_DEPLOY); }
fn handle_page_settings(req): object  { return html_response(PAGE_SETTINGS); }

// /ui/bench fragment — newest 100 bench rows.
fn handle_ui_bench(req): object {
	let rows = query(DB,
		"select id, node_id, profile_name, build_hash, prompt, n_predict, "
		+ "repetitions, ttft_ms_median, tok_per_sec_median, total_ms_median, "
		+ "tokens_predicted_median, output_excerpt, status, error, "
		+ "started_at, completed_at "
		+ "from bench_runs order by started_at desc limit 100", []);
	return { status: 200, body: render_bench(rows),
		headers: { "content-type": "text/html; charset=utf-8" } };
}

fn handle_dashboard_css(req): object {
	return { status: 200, body: SHELL_CSS,
		headers: { "content-type": "text/css; charset=utf-8",
			"cache-control": ASSET_CACHE } };
}
fn handle_dashboard_js(req): object {
	return { status: 200, body: SHELL_JS,
		headers: { "content-type": "application/javascript; charset=utf-8",
			"cache-control": ASSET_CACHE } };
}
fn handle_logo(req): object {
	return { status: 200, body: LOGO,
		headers: { "content-type": "image/svg+xml",
			"cache-control": ASSET_CACHE } };
}

// ── declarative layout (GET /api/layout, POST /api/layout/plan|apply) ──
//
// The fleet as a document: per node, per GPU, which services hold how much
// (measured), plus a `desired` list in exactly the shape POST
// /api/layout/plan and /apply accept. The planner itself is pure
// (cp/layout.hml); this section builds its inputs from live agents
// (fresh GET /vram + GET /services per node), the profile store and the
// last-measured table, and executes plans step by step.
//
// Request body (plan + apply):
//   { desired: [{ profile, node_id, gpus, port?, vram_mb? }],
//     profile_patches?: { name: <JSON merge patch (RFC 7386) or full profile> },
//     keep_unlisted?: true,     // false: stop running services not listed
//     pin?: true,               // write profile.pin = {node_id, gpus, port}
//     margin_mb?: 512,          // per-GPU headroom kept free at every step
//     confirm: true,            // apply only
//     wait_s?: 900, health_timeout_s?: 300 }   // apply only

let LAYOUT_DEFAULT_MARGIN_MB = 512;
let LAYOUT_HEALTH_TIMEOUT_S = 300;
let LAYOUT_SETTLE_S: f64 = 1.0;
// Replans tolerated per apply before giving up (each step replans once).
let LAYOUT_MAX_ITERATIONS = 60;

// Default seconds to healthy when a profile has never been timed.
fn default_startup_s(profile, node_id): f64 {
	let b = profile?.binary ?? "llama-server";
	if (b == "sd-server") { return 20.0; }
	if (b == "whisper-server" || b == "piper") { return 5.0; }
	if (b == "local") {
		let d = local_decl_on_node(node_id, profile?.local_service);
		if (d?.startup_timeout_s != null) { return f64(d.startup_timeout_s) / 2.0; }
		return 30.0;
	}
	return 30.0;
}

// Object without null-valued keys (recursively): "pin": null and no pin
// are the same profile.
fn drop_nulls(v) {
	if (v == null || typeof(v) != "object") { return v; }
	let o = {};
	for (k in v.keys()) {
		if (v[k] == null) { continue; }
		o[k] = drop_nulls(v[k]);
	}
	return o;
}

fn strip_meta(p) {
	if (p == null) { return null; }
	let o = {};
	for (k in p.keys()) {
		if (k == "__name" || k == "__version") { continue; }
		o[k] = p[k];
	}
	return o;
}

// The profile as a spawn would inline it (device default applied) — what
// the agent fingerprints.
fn spawn_shape(p) {
	let c = parse(stringify(p));
	return apply_device(c, resolve_device(null, c));
}

fn profile_fp_of(p): string {
	if (p == null) { return ""; }
	return profile_fingerprint(spawn_shape(p));
}

// Catalog row for a profile's model on a node (alias first, then path).
fn catalog_row_for(node_id: string, profile) {
	let cols = "select node_id, path, size_mb, architecture, n_layers, n_heads, "
		+ "n_kv_heads, embedding_length, claimed_context from node_models ";
	if (profile?.model_alias != null) {
		let r = query(DB, cols + "where alias = ? and node_id = ?", [profile.model_alias, node_id]);
		if (r.length > 0) { return r[0]; }
	}
	if (profile?.default_model != null) {
		let r = query(DB, cols + "where path = ? and node_id = ?", [profile.default_model, node_id]);
		if (r.length > 0) { return r[0]; }
	}
	return null;
}

fn profile_ctx(p): i32 {
	return i32(p?.intent?.context ?? p?.context ?? 4096);
}

fn profile_kv(p): string {
	return "" + (p?.intent?.kv_cache_k ?? p?.kv_type ?? "f16");
}

// GGUF estimate (MB, whole service) or -1 when there is none. Catalog
// row first; when the node's catalog has no row for the profile's model
// (a default_model outside the agent's scan dirs — spawn uses that path
// as-is, no catalog needed), read the GGUF header directly if the CP can
// see the path, the same fallback path-driven placement (pick_placement)
// uses. Without it the planner counted such a profile as 0 MB.
fn catalog_estimate_mb(node_id: string, profile, ctx: i32, ngpus: i32): i32 {
	if ((profile?.binary ?? "llama-server") != "llama-server") { return -1; }
	if (profile?.intent?.gpu_layers == 0) { return 0; }
	let row = catalog_row_for(node_id, profile);
	let dm = profile?.default_model;
	if (row == null && (dm == null || !exists(dm))) { return -1; }
	try {
		let t = (row != null)
			? estimate_vram_from_ingredients(row, ctx, profile_kv(profile)).total_mb
			: estimate_vram_mb(read_metadata(dm), ctx, profile_kv(profile)).total_mb;
		if (ngpus > 1) { t = t * (1.0 + MULTI_GPU_OVERHEAD_FRACTION); }
		return i32(t);
	} catch (e) { }
	return -1;
}

// { mb: {"<gpu>": MB}, source, note? } for one dedicated service.
fn estimate_service(name: string, profile, entry, node_id: string, gpus): object {
	let g = sorted_ints(gpus);
	if (g.length == 0) { return { mb: {}, source: "cpu (no GPU)" }; }
	let vm = entry?.vram_mb;
	if (vm != null) {
		if (typeof(vm) == "object") { return { mb: vm, source: "request vram_mb" }; }
		return { mb: spread_mb(vm, g), source: "request vram_mb" };
	}
	if (profile?.vram_mb != null) {
		return { mb: spread_mb(profile.vram_mb, g), source: "profile vram_mb" };
	}
	let fp = profile_fp_of(profile);
	let pv = profile_vram_row(name);
	if (pv != null && i32(pv.total_mb) > 0) {
		if (pv.fp == fp) {
			if (same_gpus(pv.gpus, g)) {
				return { mb: pv.vram, source: "measured " + pv.measured_at };
			}
			let t = i32(pv.total_mb);
			if (g.length > pv.gpus.length) { t = i32(f64(t) * (1.0 + MULTI_GPU_OVERHEAD_FRACTION)); }
			return { mb: spread_mb(t, g), source: "measured on GPUs " + pv.gpus_json + ", respread" };
		}
		let est_new = catalog_estimate_mb(node_id, profile, profile_ctx(profile), g.length);
		if (est_new > 0 && pv?.est_mb != null && f64(pv.est_mb) > 0.0) {
			let scaled = i32(f64(pv.total_mb) * f64(est_new) / f64(pv.est_mb));
			return { mb: spread_mb(scaled, g),
				source: "measured under an older profile version, scaled by the GGUF estimate" };
		}
	}
	if (profile?.binary == "local") {
		let d = local_decl_on_node(node_id, profile?.local_service);
		return { mb: spread_mb(d?.vram_mb ?? 0, g), source: "local declaration vram_mb" };
	}
	let est = catalog_estimate_mb(node_id, profile, profile_ctx(profile), g.length);
	if (est >= 0) {
		return { mb: spread_mb(est, g), source: "GGUF estimate (overestimates hybrid models; pass vram_mb)" };
	}
	return { mb: spread_mb(0, g), source: "unknown",
		note: name + ": no measurement or estimate; counted as 0 MB — pass vram_mb" };
}

// Shared-server estimate for a member set.
fn estimate_shared(group: string, members, node_id: string, gpus): object {
	let g = sorted_ints(gpus);
	for (m in members) {
		let vm = m.entry?.vram_mb;
		if (vm != null) {
			if (typeof(vm) == "object") { return { mb: vm, source: "request vram_mb (whole shared server)" }; }
			return { mb: spread_mb(vm, g), source: "request vram_mb (whole shared server)" };
		}
	}
	let parts = [];
	for (m in members) { parts.push(m.name + "=" + profile_fp_of(m.profile)); }
	parts.sort();
	let key = "shared:" + group + "|" + parts.join(",");
	let pv = profile_vram_row(key);
	if (pv != null && i32(pv.total_mb) > 0) {
		if (same_gpus(pv.gpus, g)) { return { mb: pv.vram, source: "measured " + pv.measured_at }; }
		return { mb: spread_mb(pv.total_mb, g), source: "measured on GPUs " + pv.gpus_json + ", respread" };
	}
	let profs = [];
	for (m in members) { profs.push(m.profile); }
	let ctx = 0;
	let nad = 0;
	let per_ad = SHARED_LORA_DEFAULT_MB;
	try {
		let cfg = desired_config(profs);
		ctx = cfg.context;
		nad = cfg.adapters.length;
	} catch (e) { ctx = profile_ctx(profs[0]); }
	for (p in profs) { if (p?.lora_mb != null) { per_ad = f64(p.lora_mb); } }
	let est = catalog_estimate_mb(node_id, profs[0], ctx, g.length);
	if (est < 0) {
		return { mb: spread_mb(0, g), source: "unknown",
			note: "shared:" + group + ": no measurement or estimate; pass vram_mb on a member" };
	}
	let total = i32(f64(est) + per_ad * f64(nad));
	return { mb: spread_mb(total, g),
		source: "GGUF estimate for the shared server (overestimates hybrid models; pass vram_mb)" };
}

// One live node, measured now: GET /vram (fresh nvidia-smi attribution,
// refreshes vram_mb) then GET /services.
fn layout_fetch_node(node_id: string, agent_url: string): object {
	let vram = null;
	try {
		let r = cp_get_fast(agent_url + "/vram");
		if (r.status_code == 200) { vram = parse(r.body); }
	} catch (e) { }
	let services = null;
	try {
		let r = cp_get_fast(agent_url + "/services");
		if (r.status_code >= 200 && r.status_code < 300) {
			services = parse(r.body);
			cache_node_services(node_id, r.body);
		}
	} catch (e) { }
	return { vram: vram, services: services };
}

// Fleet snapshot for the planner + GET /api/layout.
//   { nodes: [{ node_id, agent_url, reachable, stale_services, gpus:
//       [{ index, name, total_mb, used_mb, free_mb, other_mb }], services }] }
fn layout_snapshot(): object {
	let nodes = [];
	let rows = query(DB,
		"select node_id, agent_url, hardware_json, state from nodes where agent_url is not null "
		+ "and last_seen_at > datetime('now', ?) order by node_id asc",
		["-" + STALE_NODE_SECONDS + " seconds"]);
	for (row in rows) {
		let f = layout_fetch_node(row.node_id, row.agent_url);
		let hw = null;
		try { hw = parse(row.hardware_json); } catch (e) { hw = {}; }
		let services = f.services;
		let reachable = (services != null);
		if (services == null) {
			let c = cached_node_services(row.node_id);
			services = (c != null) ? c.entries : [];
		}
		let gpus = [];
		if (f.vram != null && (f.vram?.gpus ?? []).length > 0) {
			for (g in f.vram.gpus) {
				gpus.push({ index: g.index, name: g?.name, total_mb: g.total_mb, used_mb: g.used_mb,
					free_mb: g.free_mb, other_mb: g.other_mb });
			}
		} else {
			for (g in (hw?.gpus ?? [])) {
				let used = g?.used_mb ?? (g.total_mb - g.free_mb);
				let svc_mb = 0;
				for (e in services) { svc_mb = svc_mb + i32(e?.vram_mb?["" + g.index] ?? 0); }
				let oth = used - svc_mb;
				if (oth < 0) { oth = 0; }
				gpus.push({ index: g.index, name: g?.name, total_mb: g.total_mb, used_mb: used,
					free_mb: g.free_mb, other_mb: oth });
			}
		}
		nodes.push({ node_id: row.node_id, agent_url: row.agent_url, state: row?.state,
			reachable: reachable, measured: f.vram != null, gpus: gpus, services: services });
	}
	return { nodes: nodes };
}

fn snap_node(snap, node_id) {
	for (n in snap.nodes) { if (n.node_id == node_id) { return n; } }
	return null;
}

// A running service's memory for planning: what it holds now, raised to
// the largest value recorded for the same profile fingerprint + GPU set
// (an sd-server allocates its VAE/compute buffers on the first image, so
// "now" can be well below what it will hold).
fn with_recorded_peak(profile: string, fp: string, gpus, mb) {
	let pv = profile_vram_row(profile);
	if (pv == null || pv.fp != fp || !same_gpus(pv.gpus, gpus)) { return mb; }
	let out = {};
	for (k in mb.keys()) { out[k] = mb[k]; }
	for (k in pv.vram.keys()) {
		if (i32(pv.vram[k]) > i32(out?[k] ?? 0)) { out[k] = i32(pv.vram[k]); }
	}
	return out;
}

// Planner `current` units + `fixed` memory from a snapshot.
fn current_units_from(snap): object {
	let units = [];
	let fixed = {};
	let by_id = {};
	let gpus = [];
	for (n in snap.nodes) {
		for (g in n.gpus) {
			gpus.push({ node_id: n.node_id, index: g.index, total_mb: g.total_mb });
			fixed[gpu_key(n.node_id, g.index)] = i32(g?.other_mb ?? 0);
		}
		for (e in n.services) {
			if (e?.stale == true) { continue; }
			let st = e?.state ?? "running";
			if (st == "failed") { continue; }
			let mb = e?.vram_mb ?? {};
			if (st == "stopping") {
				units.push({ uid: e.id, kind: "stopping", node_id: n.node_id, gpus: e?.gpus ?? [],
					mb: mb, members: [], ports: [e.port] });
				continue;
			}
			let sh = e?.shared;
			if (sh?.role == "member") { continue; }
			if (sh?.role == "server") {
				let u = { uid: e.id, kind: "shared", node_id: n.node_id, gpus: e?.gpus ?? [], mb: mb,
					group: sh?.group, members: [],
					config: { adapters: sh?.adapters ?? [], slots: sh?.slots ?? 0,
						ctx_per_slot: sh?.ctx_per_slot ?? 0 } };
				units.push(u);
				by_id[e.id] = u;
				continue;
			}
			units.push({ uid: e.id, kind: "service", node_id: n.node_id, gpus: e?.gpus ?? [],
				mb: with_recorded_peak(e.profile, e?.profile_fp ?? "", e?.gpus ?? [], mb),
				members: [{ profile: e.profile, port: e.port, id: e.id, fp: e?.profile_fp ?? "",
					model_path: e?.model_path, binary: e?.binary }] });
		}
		for (e in n.services) {
			if (e?.stale == true || e?.shared?.role != "member" || e?.state != "running") { continue; }
			let u = by_id?[e.shared?.server_id];
			if (u == null) { continue; }
			let share = null;
			let p = fetch_profile_by_name(e.profile);
			try {
				share = { adapters: e.shared?.adapters ?? [], slots: member_slots(p),
					ctx_per_slot: member_ctx_per_slot(p) };
			} catch (x) { share = null; }
			u.members.push({ profile: e.profile, port: e.port, id: e.id, fp: e?.profile_fp ?? "",
				model_path: e?.model_path, share: share });
		}
	}
	return { units: units, fixed: fixed, gpus: gpus };
}

// Where a profile runs now (first fresh instance), or null.
fn current_instance(snap, profile: string) {
	for (n in snap.nodes) {
		for (e in n.services) {
			if (e?.stale == true || e?.profile != profile) { continue; }
			if ((e?.state ?? "running") != "running") { continue; }
			return { node_id: n.node_id, port: e.port, gpus: e?.gpus ?? [], id: e.id };
		}
	}
	return null;
}

// Build everything a plan needs from a request body + snapshot. Returns
// { error, status } or { input (planner), eff (name → new profile), patches
// (name → { old, new, patch }), estimates, desired_doc }.
fn layout_build(body, snap) {
	let verr = validate_layout_request(body);
	if (verr != null) { return { error: verr, status: 400 }; }
	let margin = i32(body?.margin_mb ?? LAYOUT_DEFAULT_MARGIN_MB);
	let keep = (body?.keep_unlisted ?? true) == true;
	let want_pin = (body?.pin ?? true) == true;
	let patches_in = body?.profile_patches ?? {};

	for (n in snap.nodes) {
		if (!n.reachable) {
			return { error: "node " + n.node_id + " is live but its agent didn't answer; its "
				+ "services are unknown, so no plan is safe. Retry when it answers.", status: 503 };
		}
	}
	// effective profiles: current ⊕ patch (⊕ pin, below)
	let names = [];
	for (e in body.desired) { names.push(e.profile); }
	for (k in patches_in.keys()) { if (!names.contains(k)) { names.push(k); } }
	let cur = {};
	let eff = {};
	for (nm in names) {
		let p = fetch_profile_by_name(nm);
		if (p == null) {
			return { error: "unknown profile '" + nm + "' (create it with POST /api/profiles first)",
				status: 400 };
		}
		cur[nm] = strip_meta(p);
		let np = cur[nm];
		if (patches_in.has(nm)) {
			let pt = patches_in[nm];
			if (pt == null || typeof(pt) != "object") {
				return { error: "profile_patches." + nm + " must be an object", status: 400 };
			}
			np = merge_patch(cur[nm], pt);
		}
		eff[nm] = np;
	}

	// desired entries → resolved ports, members
	let doc = [];
	let svc_units = [];
	let shared_groups = {};     // "group|node|gpus|model" → { group, node_id, gpus, members }
	let estimates = [];
	let notes = [];
	for (e in body.desired) {
		let p = eff[e.profile];
		let n = snap_node(snap, e.node_id);
		if (n == null) {
			return { error: "node '" + e.node_id + "' (for " + e.profile + ") is not live", status: 400 };
		}
		for (gi in e.gpus) {
			let found = false;
			for (g in n.gpus) { if (g.index == gi) { found = true; } }
			if (!found) {
				return { error: e.node_id + " has no GPU " + gi + " (for " + e.profile + ")", status: 400 };
			}
		}
		let port = e?.port;
		let ci = current_instance(snap, e.profile);
		if (port == null && ci != null && ci.node_id == e.node_id) { port = ci.port; }
		if (port == null) { port = p?.pin?.port; }
		if (port == null) { port = p?.default_port; }
		if (port == null && p?.binary == "local") {
			port = local_decl_on_node(e.node_id, p?.local_service)?.port;
		}
		if (port == null) {
			return { error: e.profile + ": no port (give port, or set the profile's default_port)", status: 400 };
		}
		if (port == extract_port(n.agent_url)) {
			return { error: e.profile + ": port " + port + " is the agent's own port", status: 400 };
		}
		let gs = sorted_ints(e.gpus);
		if (want_pin) {
			let pinned = eff[e.profile];
			pinned = merge_patch(pinned, { pin: null });
			pinned["pin"] = { node_id: e.node_id, gpus: gs, port: i32(port) };
			eff[e.profile] = pinned;
			p = pinned;
		}
		let perr = validate_profile(p, true);
		if (perr != null) { return { error: e.profile + ": " + perr, status: 400 }; }
		doc.push({ profile: e.profile, node_id: e.node_id, gpus: gs, port: i32(port) });
		let pv = profile_vram_row(e.profile);
		let startup = default_startup_s(p, e.node_id);
		if (pv?.startup_s != null) { startup = f64(pv.startup_s); }
		let member = { profile: e.profile, port: i32(port), fp: profile_fp_of(p), startup_s: startup };
		if (is_sharing_profile(p) && gs.length > 0) {
			let model = p?.model_alias ?? p?.default_model ?? "";
			let key = p.share_group + "|" + e.node_id + "|" + stringify(gs) + "|" + model;
			if (!shared_groups.has(key)) {
				shared_groups[key] = { group: "" + p.share_group, node_id: e.node_id, gpus: gs, members: [] };
			}
			let share = null;
			try {
				let ads = [];
				for (a in profile_adapters(p)) { ads.push(a.path); }
				share = { adapters: ads, slots: member_slots(p), ctx_per_slot: member_ctx_per_slot(p) };
			} catch (x) { }
			member["share"] = share;
			shared_groups[key].members.push({ name: e.profile, profile: p, entry: e, member: member });
			continue;
		}
		let est = estimate_service(e.profile, p, e, e.node_id, gs);
		if (est?.note != null) { notes.push(est.note); }
		estimates.push({ profiles: [e.profile], node_id: e.node_id, gpus: gs, mb: est.mb,
			total_mb: mb_total(est.mb), source: est.source });
		svc_units.push({ uid: e.profile, kind: "service", node_id: e.node_id, gpus: gs, mb: est.mb,
			source: est.source, members: [member] });
	}
	for (k in shared_groups.keys()) {
		let sg = shared_groups[k];
		let est = estimate_shared(sg.group, sg.members, sg.node_id, sg.gpus);
		if (est?.note != null) { notes.push(est.note); }
		let ms = [];
		let pn = [];
		for (m in sg.members) { ms.push(m.member); pn.push(m.name); }
		estimates.push({ profiles: pn, shared_group: sg.group, node_id: sg.node_id, gpus: sg.gpus,
			mb: est.mb, total_mb: mb_total(est.mb), source: est.source });
		svc_units.push({ uid: "shared:" + k, kind: "shared", group: sg.group, node_id: sg.node_id,
			gpus: sg.gpus, mb: est.mb, source: est.source, members: ms });
	}

	// keep_unlisted: false + pin: true — the layout owns the pins. A running
	// profile it stops loses its pin, so a later /v1/llama auto-spawn of it
	// goes through capacity-aware placement instead of back onto a card the
	// new layout gave to something else.
	if (!keep && want_pin) {
		for (n in snap.nodes) {
			for (e in n.services) {
				let pn = e?.profile;
				if (pn == null || names.contains(pn) || ("" + pn).starts_with("shared:")) { continue; }
				if (e?.stale == true || (e?.state ?? "running") != "running") { continue; }
				let sp = fetch_profile_by_name(pn);
				if (sp == null || sp?.pin == null) { continue; }
				names.push(pn);
				cur[pn] = strip_meta(sp);
				eff[pn] = merge_patch(cur[pn], { pin: null });
			}
		}
	}

	// patch steps: profiles whose stored JSON changes
	let patch_steps = [];
	let patches = {};
	for (nm in names) {
		if (canonical_json(drop_nulls(eff[nm])) == canonical_json(drop_nulls(cur[nm]))) { continue; }
		let shown = parse(stringify(json_tree(patches_in?[nm] ?? {})));
		if (want_pin && eff[nm]?.pin != null) {
			shown["pin"] = eff[nm].pin;
		} else if (want_pin && cur[nm]?.pin != null && eff[nm]?.pin == null) {
			shown["pin"] = null;
		}
		let restart = profile_fp_of(eff[nm]) != profile_fp_of(cur[nm]);
		patch_steps.push({ profile: nm, patch: shown, restart: restart });
		patches[nm] = { old: cur[nm], new: eff[nm] };
	}

	let cu = current_units_from(snap);
	let input = {
		margin_mb: margin, keep_unlisted: keep, gpus: cu.gpus, fixed: cu.fixed,
		current: cu.units, desired: svc_units, patches: patch_steps,
	};
	return { input: input, eff: eff, patches: patches, estimates: estimates, notes: notes,
		desired_doc: doc, keep: keep, margin: margin };
}

// Plan from a body: { status, plan } (plan carries ok/error).
fn layout_plan_now(body) {
	let snap = layout_snapshot();
	let b = layout_build(body, snap);
	if (b?.error != null) { return { status: b.status, plan: { ok: false, error: b.error }, snap: snap }; }
	let plan = plan_layout(b.input);
	plan["estimates"] = b.estimates;
	let w = plan?.warnings ?? [];
	for (nt in b.notes) { w.push(nt); }
	plan["warnings"] = w;
	plan["layout"] = { desired: b.desired_doc, keep_unlisted: b.keep, margin_mb: b.margin };
	return { status: (plan.ok ? 200 : 409), plan: plan, build: b, snap: snap };
}

// ── GET /api/layout ──

fn layout_document(snap): object {
	let desired = [];
	let nodes = [];
	let all_pinned = true;
	let any = false;
	for (n in snap.nodes) {
		let gv = [];
		for (g in n.gpus) {
			let svcs = [];
			for (e in n.services) {
				let mb = i32(e?.vram_mb?["" + g.index] ?? 0);
				if (e?.shared?.role == "member") { continue; }
				let on_gpu = (e?.gpus ?? []).contains(g.index);
				if (mb <= 0 && !on_gpu) { continue; }
				let label = e.profile;
				let item = { profile: e.profile, port: e.port, mb: mb, service_id: e.id,
					state: e?.state ?? "running" };
				if (e?.shared?.role == "server") {
					let names = [];
					for (m in (e.shared?.members ?? [])) { names.push(m.profile); }
					item["shared_group"] = e.shared?.group;
					item["members"] = names;
					item["profile"] = "shared:" + (e.shared?.group ?? "?");
				}
				if (e?.stale == true) { item["stale"] = true; }
				svcs.push(item);
			}
			gv.push({ index: g.index, name: g?.name, total_mb: g.total_mb, used_mb: g?.used_mb,
				free_mb: g?.free_mb, other_mb: g?.other_mb ?? 0, services: svcs });
		}
		nodes.push({ node_id: n.node_id, reachable: n.reachable, measured: n.measured, gpus: gv });
		for (e in n.services) {
			let st = e?.state ?? "running";
			if (st != "running") { continue; }
			if (e?.shared?.role == "server") { continue; }
			if (e?.profile == null || ("" + e.profile).starts_with("shared:")) { continue; }
			let item = { profile: e.profile, node_id: n.node_id, gpus: sorted_ints(e?.gpus ?? []),
				port: e.port, measured_mb: e?.vram_mb ?? {}, service_id: e.id };
			if (e?.shared?.role == "member") {
				item["shared_group"] = e.shared?.group;
				item["measured_mb"] = {};
			}
			if (e?.stale == true) { item["stale"] = true; }
			desired.push(item);
			any = true;
			let p = fetch_profile_by_name(e.profile);
			let pin = p?.pin;
			if (pin == null || pin.node_id != n.node_id || !same_gpus(pin?.gpus ?? [], item.gpus)
				|| (pin?.port != null && pin.port != e.port)) {
				all_pinned = false;
			}
		}
	}
	return {
		keep_unlisted: true,
		pin: (any && all_pinned),
		margin_mb: LAYOUT_DEFAULT_MARGIN_MB,
		desired: desired,
		nodes: nodes,
	};
}

fn handle_get_layout(req): object {
	let snap = layout_snapshot();
	return { status: 200, body: stringify(json_tree(layout_document(snap))),
		headers: { "content-type": "application/json" } };
}

fn handle_plan_layout(req): object {
	let body = null;
	try { body = parse(req?.body ?? ""); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	let r = layout_plan_now(body);
	return { status: r.status, body: stringify(json_tree(r.plan)),
		headers: { "content-type": "application/json" } };
}

// ── apply ──

fn write_profile(name: string, prof): i32 {
	let ex = query(DB, "select version from profiles where name = ?", [name]);
	if (ex.length == 0) { throw "no such profile: " + name; }
	let v = ex[0].version + 1;
	exec(DB, "update profiles set profile_json = ?, version = ?, updated_at = ? where name = ?",
		[stringify(json_tree(prof)), v, iso_now(), name]);
	return v;
}

fn run_set(id: string, status: string, log, result): null {
	exec(DB, "update layout_runs set status = ?, log_json = ?, result_json = ?, "
		+ "finished_at = case when ? = 'running' then null else datetime('now') end where id = ?",
		[status, stringify(json_tree(log)), (result == null ? null : stringify(json_tree(result))), status, id]);
	return null;
}

fn agent_stop_verified(node_id: string, service_id: string): object {
	let url = lookup_agent(node_id);
	if (url == null) { return { ok: false, error: "no agent for " + node_id }; }
	try {
		let r = cp_post_json(url + "/services/stop", { id: service_id, report: true });
		if (r.status_code == 404) { return { ok: true, gone: true, note: "already gone" }; }
		if (r.status_code == 204) { return { ok: true, gone: true }; }
		let rep = null;
		try { rep = parse(r.body); } catch (e) { }
		if (r.status_code == 200) { return { ok: (rep?.gone ?? true) == true, report: rep }; }
		return { ok: false, error: "agent stop " + r.status_code + ": " + r.body, report: rep };
	} catch (e) {
		return { ok: false, error: "agent unreachable: " + e };
	}
}

fn health_timeout_for(profile, node_id: string, body): i32 {
	if (body?.health_timeout_s != null) { return i32(body.health_timeout_s); }
	if (profile?.binary == "local") {
		let d = local_decl_on_node(node_id, profile?.local_service);
		if (d?.startup_timeout_s != null && i32(d.startup_timeout_s) > LAYOUT_HEALTH_TIMEOUT_S) {
			return i32(d.startup_timeout_s);
		}
	}
	return LAYOUT_HEALTH_TIMEOUT_S;
}

// Start a profile pinned at (node, gpus, port) and wait for health.
fn layout_start(profile_name: string, node_id: string, gpus, port, model, body): object {
	let req_body = { profile: profile_name, node_id: node_id, gpus: gpus, port: port,
		ignore_pin: true };
	if (model != null) { req_body["model"] = model; }
	let t0 = unix_ms();
	let resp = handle_spawn_proxy({ method: "POST", path: "/services", headers: {},
		body: stringify(req_body) });
	if (resp.status < 200 || resp.status >= 300) {
		return { ok: false, error: "spawn " + resp.status + ": " + resp.body };
	}
	let svc = parse(resp.body);
	let profile = fetch_profile_by_name(profile_name);
	let host = extract_host(lookup_agent(node_id) ?? "");
	let tmo = health_timeout_for(profile, node_id, body);
	if (!wait_for_service_ready(host, i32(svc.port), health_path_for_profile(profile), tmo)) {
		return { ok: false, id: svc?.id, error: profile_name + " did not become healthy within "
			+ tmo + "s on " + node_id + ":" + svc.port };
	}
	let secs = f64(unix_ms() - t0) / 1000.0;
	record_startup_s(profile_name, secs);
	return { ok: true, id: svc?.id, port: svc.port, startup_s: secs };
}

fn measured_now(snap): object {
	let out = {};
	for (n in snap.nodes) {
		for (g in n.gpus) { out[gpu_key(n.node_id, g.index)] = i32(g?.used_mb ?? 0); }
	}
	return out;
}

fn find_entry_in_snap(snap, profile: string, node_id) {
	for (n in snap.nodes) {
		if (node_id != null && n.node_id != node_id) { continue; }
		for (e in n.services) {
			if (e?.profile == profile && e?.stale != true && (e?.state ?? "running") == "running") {
				return { node_id: n.node_id, e: e };
			}
		}
	}
	return null;
}

// Undo what a run changed: stop what it started, restore profiles,
// restart what it stopped where it was. Returns the rollback log.
fn layout_rollback(run_id: string, ex, body): array {
	let log = [];
	let si = ex.started.length - 1;
	while (si >= 0) {
		let s = ex.started[si];
		let snap = layout_snapshot();
		let cur = find_entry_in_snap(snap, s.profile, s.node_id);
		if (cur != null && cur.e.id == s.id) {
			let r = agent_stop_verified(s.node_id, s.id);
			log.push({ op: "stop", profile: s.profile, node_id: s.node_id, ok: r.ok, error: r?.error });
		}
		si = si - 1;
	}
	let pi = ex.patched.length - 1;
	while (pi >= 0) {
		let p = ex.patched[pi];
		try {
			let v = write_profile(p.profile, p.old);
			log.push({ op: "restore_profile", profile: p.profile, version: v, ok: true });
		} catch (e) {
			log.push({ op: "restore_profile", profile: p.profile, ok: false, error: "" + e });
		}
		pi = pi - 1;
	}
	for (s in ex.stopped) {
		let snap = layout_snapshot();
		if (find_entry_in_snap(snap, s.profile, null) != null) { continue; }
		let model = (s?.binary == "local") ? null : s?.model_path;
		let r = layout_start(s.profile, s.node_id, s.gpus, s.port, model, body);
		log.push({ op: "start", profile: s.profile, node_id: s.node_id, gpus: s.gpus, port: s.port,
			ok: r.ok, error: r?.error });
	}
	return log;
}

// Execute one plan step. Mutates `ex` (what to roll back).
fn layout_exec_step(step, b, snap, ex, body): object {
	if (step.op == "patch_profile") {
		let pt = b.patches?[step.profile];
		if (pt == null) { return { ok: true, note: "nothing to patch" }; }
		let already = false;
		for (x in ex.patched) { if (x.profile == step.profile) { already = true; } }
		if (!already) { ex.patched.push({ profile: step.profile, old: pt.old }); }
		let v = write_profile(step.profile, pt.new);
		return { ok: true, version: v };
	}
	let res = { ok: true };
	if (step.op == "stop" || step.op == "restart") {
		let from = step?.from ?? { node_id: step.node_id, gpus: step.gpus, port: step.port,
			service_id: step?.service_id };
		let ent = null;
		for (n in snap.nodes) {
			for (e in n.services) { if (e.id == from.service_id) { ent = e; } }
		}
		let r = agent_stop_verified(from.node_id, from.service_id);
		if (!r.ok) { return { ok: false, error: "stop of " + step.profile + " failed: " + (r?.error ?? "process still present after SIGKILL") , report: r?.report }; }
		res["stop"] = r?.report;
		if (ent != null && !(ent?.profile ?? "").starts_with("shared:")) {
			ex.stopped.push({ profile: step.profile, node_id: from.node_id, gpus: from?.gpus ?? [],
				port: from.port, model_path: ent?.model_path, binary: ent?.binary });
		}
	}
	if (step.op == "start" || step.op == "restart") {
		let r = layout_start(step.profile, step.node_id, step.gpus, step.port, null, body);
		if (r?.id != null) { ex.started.push({ profile: step.profile, node_id: step.node_id, id: r.id }); }
		if (!r.ok) { return { ok: false, error: r.error }; }
		res["service_id"] = r.id;
		res["startup_s"] = r.startup_s;
	}
	return res;
}

fn step_brief(s): object {
	return { op: s.op, profile: s.profile, node_id: s?.node_id, gpus: s?.gpus, port: s?.port };
}

async fn layout_apply_task(run_id: string): null {
	let rows = query(DB, "select request_json from layout_runs where id = ?", [run_id]);
	if (rows.length == 0) { return null; }
	let body = parse(rows[0].request_json);
	let log = [];
	let ex = { patched: [], stopped: [], started: [] };
	try {
		layout_apply_run(run_id, body, log, ex);
	} catch (e) {
		eprint("[layout] apply " + run_id + " crashed: " + e);
		log.push({ error: "internal error: " + e });
		let rb = [];
		try { rb = layout_rollback(run_id, ex, body); } catch (e2) {
			rb = [{ error: "rollback failed: " + e2 }];
		}
		run_set(run_id, "rolled_back", log, { ok: false, error: "internal error: " + e, rollback: rb });
	}
	return null;
}

fn layout_apply_run(run_id: string, body, log, ex): null {
	let it = 0;
	let prev_rest = null;
	let first_plan = null;
	loop {
		it = it + 1;
		if (it > LAYOUT_MAX_ITERATIONS) {
			log.push({ error: "gave up after " + LAYOUT_MAX_ITERATIONS + " steps (plan keeps changing)" });
			let rb = layout_rollback(run_id, ex, body);
			run_set(run_id, "rolled_back", log, { ok: false, error: "did not converge", rollback: rb,
				layout: layout_document(layout_snapshot()) });
			return null;
		}
		let r = layout_plan_now(body);
		let plan = r.plan;
		if (first_plan == null) {
			first_plan = plan;
			exec(DB, "update layout_runs set plan_json = ? where id = ?", [stringify(json_tree(plan)), run_id]);
		}
		if (!plan.ok) {
			log.push({ error: plan.error, plan: plan });
			if (ex.patched.length == 0 && ex.stopped.length == 0 && ex.started.length == 0) {
				run_set(run_id, "failed", log, { ok: false, error: plan.error, plan: plan });
				return null;
			}
			let rb = layout_rollback(run_id, ex, body);
			run_set(run_id, "rolled_back", log, { ok: false, error: plan.error, rollback: rb,
				layout: layout_document(layout_snapshot()) });
			return null;
		}
		if (plan.steps.length == 0) {
			let status = (log.length == 0) ? "noop" : "done";
			run_set(run_id, status, log, { ok: true, status: status,
				layout: layout_document(layout_snapshot()) });
			return null;
		}
		let step = plan.steps[0];
		// replanned = the remaining plan differs from what the previous
		// iteration expected after this point
		let replanned = false;
		if (prev_rest != null) {
			let now_rest = [];
			for (s in plan.steps) { now_rest.push(step_brief(s)); }
			replanned = stringify(json_tree(now_rest)) != stringify(json_tree(prev_rest));
		}
		let t0 = unix_ms();
		let out = null;
		try {
			out = layout_exec_step(step, r.build, r.snap, ex, body);
		} catch (e) {
			out = { ok: false, error: "" + e };
		}
		// patches don't move memory; everything else settles before measuring
		if (step.op != "patch_profile") { sleep(LAYOUT_SETTLE_S); }
		let after = (step.op == "patch_profile") ? r.snap : layout_snapshot();
		let measured = measured_now(after);
		let entry = { n: log.length + 1, op: step.op, profile: step.profile,
			node_id: step?.node_id, gpus: step?.gpus, port: step?.port,
			ok: out.ok, seconds: f64(unix_ms() - t0) / 1000.0,
			projected_mb: step?.projected_mb, measured_mb: measured, replanned: replanned };
		if (out?.error != null) { entry["error"] = out.error; }
		if (out?.stop != null) { entry["stop"] = out.stop; }
		if (out?.service_id != null) { entry["service_id"] = out.service_id; }
		if (out?.version != null) { entry["version"] = out.version; }
		let drift = [];
		for (k in measured.keys()) {
			let pr = step?.projected_mb?[k];
			if (pr != null && measured[k] > i32(pr) + 512) {
				drift.push(k + " measured " + measured[k] + " MB vs projected " + pr);
			}
		}
		if (drift.length > 0) { entry["drift"] = drift; }
		log.push(entry);
		run_set(run_id, "running", log, null);
		if (!out.ok) {
			let rb = layout_rollback(run_id, ex, body);
			run_set(run_id, "rolled_back", log, { ok: false, error: out.error, failed_step: entry,
				rollback: rb, layout: layout_document(layout_snapshot()) });
			return null;
		}
		let rest = [];
		let ri = 1;
		while (ri < plan.steps.length) { rest.push(step_brief(plan.steps[ri])); ri = ri + 1; }
		prev_rest = rest;
	}
}

fn run_row_obj(row): object {
	let o = { run_id: row.id, status: row.status, started_at: row.started_at,
		finished_at: row?.finished_at };
	try { if (row?.log_json != null) { o["log"] = parse(row.log_json); } } catch (e) { }
	try { if (row?.result_json != null) { o["result"] = parse(row.result_json); } } catch (e) { }
	try { if (row?.plan_json != null) { o["plan"] = parse(row.plan_json); } } catch (e) { }
	return o;
}

fn handle_apply_layout(req): object {
	let body = null;
	try { body = parse(req?.body ?? ""); } catch (e) {
		return { status: 400, body: "{\"error\":\"bad json\"}" };
	}
	if (body?.confirm != true) {
		return { status: 400, body: stringify({
			error: "apply changes the fleet: send confirm: true (preview first with POST /api/layout/plan)",
		})};
	}
	let verr = validate_layout_request(body);
	if (verr != null) { return { status: 400, body: stringify({ error: verr }) }; }
	let busy = query(DB, "select id from layout_runs where status = 'running' "
		+ "and started_at > datetime('now', '-2 hours')", []);
	if (busy.length > 0) {
		return { status: 409, body: stringify({ error: "a layout apply is already running",
			run_id: busy[0].id }) };
	}
	let id = query(DB, "select lower(hex(randomblob(8))) as id", [])[0].id;
	exec(DB, "insert into layout_runs (id, status, request_json, started_at) "
		+ "values (?, 'running', ?, datetime('now'))", [id, stringify(body)]);
	let t = spawn(layout_apply_task, id);
	detach(t);
	let wait_s = i32(body?.wait_s ?? 900);
	let waited = 0.0;
	loop {
		let r = query(DB, "select * from layout_runs where id = ?", [id]);
		if (r.length > 0 && r[0].status != "running") {
			let o = run_row_obj(r[0]);
			let code = 200;
			if (o.status == "failed" || o.status == "rolled_back") { code = 409; }
			return { status: code, body: stringify(json_tree(o)), headers: { "content-type": "application/json" } };
		}
		if (waited >= f64(wait_s)) {
			let o = (r.length > 0) ? run_row_obj(r[0]) : { run_id: id, status: "running" };
			o["note"] = "still running; poll GET /api/layout/runs/" + id;
			return { status: 202, body: stringify(json_tree(o)), headers: { "content-type": "application/json" } };
		}
		sleep(1.0);
		waited = waited + 1.0;
	}
}

fn handle_get_layout_run(req): object {
	let prefix = "/api/layout/runs/";
	let id = req.path.substr(prefix.length, req.path.length - prefix.length);
	if (id.length == 0) {
		let rows = query(DB, "select id, status, started_at, finished_at from layout_runs "
			+ "order by started_at desc limit 20", []);
		let out = [];
		for (r in rows) { out.push({ run_id: r.id, status: r.status, started_at: r.started_at,
			finished_at: r?.finished_at }); }
		return { status: 200, body: stringify(out) };
	}
	let r = query(DB, "select * from layout_runs where id = ?", [id]);
	if (r.length == 0) { return { status: 404, body: stringify({ error: "no such run: " + id }) }; }
	return { status: 200, body: stringify(json_tree(run_row_obj(r[0]))) };
}

// ── MCP server (cp/mcp.hml) ──────────────────────────────────────────
//
// Each tool wraps an existing CP handler by synthesizing the request it
// expects and passing its { status, body } straight back to the MCP layer.
// No new business logic lives here — the MCP surface is a thin adapter
// over the same HTTP API the dashboard uses, so it inherits its behavior
// (and tests) for free.

// Synthesize the in-process request each wrapped handler expects.
fn mcp_req(verb: string, target: string, body: string): object {
	return { method: verb, path: target, body: body, headers: {} };
}

// Tool dispatch. mcp.hml validates the tool name against mcp_tools() then
// calls this with (name, arguments). One function (passed to mcp_handle as
// an argument, like serve()'s auth_check) keeps function values off the
// object-literal path hemlockc can't lower, and `stringify` runs here in a
// plain module function rather than a captured closure. Each arm wraps an
// existing CP handler — no new business logic.
fn mcp_invoke(name: string, args): object {
	if (name == "list_nodes") {
		return handle_list_nodes(mcp_req("GET", "/nodes", ""));
	}
	if (name == "list_services") {
		return handle_list_services(mcp_req("GET", "/services", ""));
	}
	if (name == "list_profiles") {
		return handle_list_profiles_v2(mcp_req("GET", "/api/profiles", ""));
	}
	if (name == "list_catalog") {
		return handle_list_catalog(mcp_req("GET", "/api/catalog", ""));
	}
	if (name == "fleet_status") {
		return handle_state(mcp_req("GET", "/api/state", ""));
	}
	if (name == "resolve_profile") {
		let profile = args?.profile ?? "";
		return handle_resolve(mcp_req("GET", "/resolve/" + profile, ""));
	}
	if (name == "spawn_service") {
		return handle_spawn_proxy(mcp_req("POST", "/services", stringify(args)));
	}
	if (name == "stop_service") {
		return handle_stop_proxy(mcp_req("POST", "/services/stop", stringify(args)));
	}
	if (name == "get_layout") {
		return handle_get_layout(mcp_req("GET", "/api/layout", ""));
	}
	if (name == "plan_layout") {
		return handle_plan_layout(mcp_req("POST", "/api/layout/plan", stringify(args)));
	}
	if (name == "apply_layout") {
		// MCP clients time out long calls: wait at most 120 s by default,
		// then hand back the run id for get_layout_run.
		let a = args;
		if (a?.wait_s == null) { a["wait_s"] = 120; }
		return handle_apply_layout(mcp_req("POST", "/api/layout/apply", stringify(a)));
	}
	if (name == "get_layout_run") {
		return handle_get_layout_run(mcp_req("GET", "/api/layout/runs/" + (args?.run_id ?? ""), ""));
	}
	return { status: 404, body: stringify({ error: "unknown tool: " + name }) };
}

// The tool catalog — pure data (name + description + JSON Schema). Read-only
// introspection + the two mutating fleet actions (spawn/stop). Kept
// deliberately small: this is the operator's control surface, not the
// consumer inference path (that stays on /v1/llama/* with its own flow).
fn mcp_tools(): array {
	return [
		{
			name: "list_nodes",
			description: "List every registered node in the fleet with its "
				+ "hardware (GPUs, VRAM, RAM), liveness, and state.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "list_services",
			description: "List running inference services across the fleet, "
				+ "each tagged with the node it runs on, its profile, port, and pid.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "list_profiles",
			description: "List the configured service profiles (chat, image, "
				+ "embedding, etc.) the fleet can spawn, with their intent + model.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "list_catalog",
			description: "List the GGUF model catalog aggregated across all nodes, "
				+ "by alias, with which nodes hold each model on disk.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "fleet_status",
			description: "Get a single snapshot of overall fleet state (nodes + "
				+ "services + recent events) as the dashboard sees it.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "resolve_profile",
			description: "Resolve a profile (or alias) to a live inference "
				+ "endpoint (host, port, base_url). Returns 404 if nothing is "
				+ "running for it. Use this to find where to send inference.",
			schema: {
				"type": "object",
				properties: {
					profile: { "type": "string",
						description: "Profile name or alias, e.g. 'chat-mahou'." },
				},
				required: ["profile"],
				additionalProperties: false,
			},
		},
		{
			name: "spawn_service",
			description: "Spawn a service for a profile. Omit node_id/gpus to let "
				+ "the control plane do capacity-aware placement; pin them (and "
				+ "supply model) to place manually. Returns the spawned service.",
			schema: {
				"type": "object",
				properties: {
					profile: { "type": "string",
						description: "Profile name to spawn (required)." },
					node_id: { "type": "string",
						description: "Pin to a specific node. Optional; placement picks one if omitted." },
					gpus:    { "type": "array", items: { "type": "integer" },
						description: "GPU indices to use when pinning a node. Optional." },
					model:   { "type": "string",
						description: "Explicit GGUF path override. Required only when node_id+gpus are pinned." },
					port:    { "type": "integer",
						description: "Port override. Optional; one is picked if omitted." },
					device:  { "type": "string", "enum": ["auto", "cpu", "gpu"],
						description: "Force CPU/GPU placement. Optional, defaults to the profile's setting." },
				},
				required: ["profile"],
				additionalProperties: false,
			},
		},
		{
			name: "get_layout",
			description: "Current fleet layout: per node and GPU, total/used/free MB and the services "
				+ "on it with MEASURED MB; plus `desired`, the running services in the exact shape "
				+ "plan_layout/apply_layout accept. Start here: edit `desired`, then plan.",
			schema: { "type": "object", properties: {}, additionalProperties: false },
		},
		{
			name: "plan_layout",
			description: "Dry run: the ordered steps (patch_profile/stop/start/restart) that reach "
				+ "`desired` without any GPU exceeding capacity minus margin at any step, with "
				+ "projected MB per GPU after each step, expected downtime per service and the "
				+ "estimates used. Only what changes is touched; ports are kept. Infeasible → "
				+ "error naming each GPU and by how many MB it overflows. Changes nothing.",
			schema: {
				"type": "object",
				properties: {
					desired: {
					"type": "array",
					description: "The services to run and where: one entry per profile.",
					items: {
						"type": "object",
						properties: {
							profile: { "type": "string" },
							node_id: { "type": "string" },
							gpus:    { "type": "array", items: { "type": "integer" },
								description: "GPU indices on that node; [] = CPU." },
							port:    { "type": "integer",
								description: "Optional; default keeps the current port, else pin/default_port." },
							vram_mb: { description: "Optional size override: MB for the whole service, or {\"<gpu>\": MB}. For a share_group, the whole shared server." },
						},
						required: ["profile", "node_id", "gpus"],
					},
				},
					profile_patches: { "type": "object",
						description: "Optional { profile: JSON merge patch } applied first, e.g. {\"chat-mahou\": {\"intent\": {\"context\": 65536}}}. null deletes a key." },
					keep_unlisted: { "type": "boolean",
						description: "Default true. false = stop every running service not in desired." },
					pin: { "type": "boolean",
						description: "Default true: record each placement as profile.pin so respawns land there." },
					margin_mb: { "type": "integer", description: "Free MB kept on every GPU at every step (default 512)." },
				},
				required: ["desired"],
				additionalProperties: false,
			},
		},
		{
			name: "apply_layout",
			description: "Execute plan_layout's plan: one step at a time, waiting for each started "
				+ "service's health and for each stopped process to be gone (SIGKILL if needed), "
				+ "re-measuring VRAM and re-planning after every step. On a failed step it rolls "
				+ "back (restores profiles, restarts what it stopped). Applying the current layout "
				+ "is a no-op. Needs confirm: true. Returns the step log, or a run_id to poll with "
				+ "get_layout_run if it runs longer than wait_s (default 120).",
			schema: {
				"type": "object",
				properties: {
					desired: {
					"type": "array",
					description: "The services to run and where: one entry per profile.",
					items: {
						"type": "object",
						properties: {
							profile: { "type": "string" },
							node_id: { "type": "string" },
							gpus:    { "type": "array", items: { "type": "integer" },
								description: "GPU indices on that node; [] = CPU." },
							port:    { "type": "integer",
								description: "Optional; default keeps the current port, else pin/default_port." },
							vram_mb: { description: "Optional size override: MB for the whole service, or {\"<gpu>\": MB}. For a share_group, the whole shared server." },
						},
						required: ["profile", "node_id", "gpus"],
					},
				},
					profile_patches: { "type": "object",
						description: "Optional { profile: JSON merge patch } applied first, e.g. {\"chat-mahou\": {\"intent\": {\"context\": 65536}}}. null deletes a key." },
					keep_unlisted: { "type": "boolean",
						description: "Default true. false = stop every running service not in desired." },
					pin: { "type": "boolean",
						description: "Default true: record each placement as profile.pin so respawns land there." },
					margin_mb: { "type": "integer", description: "Free MB kept on every GPU at every step (default 512)." },
					confirm: { "type": "boolean", description: "Must be true." },
					wait_s:  { "type": "integer", description: "Seconds to wait before returning a run_id (default 120)." },
					health_timeout_s: { "type": "integer", description: "Per-start health wait (default 300)." },
				},
				required: ["desired", "confirm"],
				additionalProperties: false,
			},
		},
		{
			name: "get_layout_run",
			description: "Status + step log of a layout apply (run_id from apply_layout); omit "
				+ "run_id to list recent runs.",
			schema: {
				"type": "object",
				properties: { run_id: { "type": "string" } },
				additionalProperties: false,
			},
		},
		{
			name: "stop_service",
			description: "Stop a running service by its id and node_id "
				+ "(both from list_services).",
			schema: {
				"type": "object",
				properties: {
					id:      { "type": "string", description: "Service id (required)." },
					node_id: { "type": "string", description: "Owning node id (required)." },
				},
				required: ["id", "node_id"],
				additionalProperties: false,
			},
		},
	];
}

fn handle_mcp(req): object {
	let server_info = { name: "witchgrid-cp", version: WITCHGRID_VERSION };
	return mcp_handle(req, mcp_tools(), mcp_invoke, server_info);
}

// GET /mcp — we don't offer a server-initiated SSE stream (every reply is
// a buffered POST response), so advertise that with 405 per the Streamable
// HTTP spec instead of leaving the client hanging on an open GET.
fn handle_mcp_get(req): object {
	return { status: 405,
		headers: { "content-type": "application/json", "allow": "POST" },
		body: "{\"error\":\"GET not supported; POST JSON-RPC to /mcp\"}" };
}

// ── boot ─────────────────────────────────────────────────────────────

fn main(): null {
	DB_PATH = resolve_data_path(DB_PATH);
	if (!exists(DB_PATH)) {
		print("[cp] creating NEW database at " + DB_PATH
			+ " — if unexpected, check CWD or set WITCHGRID_DATA_DIR "
			+ "(a stray fresh DB drops every node/profile/service from view)");
	}
	DB = open_db(DB_PATH);
	// Concurrency + durability pragmas, set before any table work:
	//   busy_timeout — a momentarily-locked DB waits up to 5s and retries
	//     instead of throwing "database is locked". The detached
	//     db_backup_loop runs `vacuum into` while the HTTP loop writes
	//     nodes/services/samples; without this they collide.
	//   journal_mode=WAL — readers don't block the writer and vice versa,
	//     and it's the crash-safe journal the systemd unit already assumes
	//     ("give sqlite time to release the WAL lock") but nothing enabled.
	//   synchronous=NORMAL — the standard, safe WAL pairing.
	exec(DB, "PRAGMA busy_timeout=5000", []);
	exec(DB, "PRAGMA journal_mode=WAL", []);
	exec(DB, "PRAGMA synchronous=NORMAL", []);
	init_db(DB);
	print("[cp] sqlite ready: " + DB_PATH);
	print("[cp] witchgrid control plane " + WITCHGRID_VERSION);
	init_auth();

	// Detached background task: sqlite auto-backup loop. No-op when
	// db_backup_interval_min=0 (the default); flips on as soon as the
	// operator sets a positive interval via PUT /api/settings.
	let bk = spawn(db_backup_loop);
	detach(bk);

	// Route auth tiers (see cp_auth_check):
	//   public: true        — always open: /healthz + the static dashboard
	//                         shell/assets (baked into the binary, no
	//                         fleet data).
	//   scope: "read"       — dashboard fragments + read-only JSON: open
	//                         by default, bearer-gated when
	//                         WITCHGRID_AUTH_PROTECT_READ is set (no
	//                         operator cookie yet — slice 2).
	//   scope: "inference"  — /v1/llama/*: open by default, bearer-gated
	//                         when WITCHGRID_AUTH_PROTECT_INFERENCE is
	//                         set (per-consumer tokens are slice 3).
	//   (no flag)           — mutating control surface, always gated.
	let routes = [
		{ method: "POST", path: "/register",      handler: handle_register },
		{ method: "GET",  path: "/nodes",         handler: handle_list_nodes,         scope: "read" },
		{ method: "PATCH", path: "/api/nodes/",   prefix: true, handler: handle_patch_node },
		// Node-scoped llama_cpp proxies (since v0.7 C2). Method = *
		// so GET (list installed) + POST (install/activate) hit the
		// same handler which dispatches by action segment.
		{ method: "*",     path: "/api/nodes/",   prefix: true, handler: fn(req): object {
			// Sub-resource dispatch under /api/nodes/{id}/...:
			//   /llama_cpp/{action}  → install-layer proxy
			//   /auto-restart        → watchdog toggle proxy (PUT)
			if (req.path.find("/llama_cpp/") >= 0) {
				return handle_node_llama_cpp(req);
			}
			if (req.path.find("/auto-restart") >= 0) {
				return handle_node_auto_restart(req);
			}
			return { status: 404, body: "{\"error\":\"not found\"}" };
		} },
		{ method: "GET",  path: "/healthz",       handler: handle_health,             public: true },
		{ method: "GET",  path: "/metrics",       handler: handle_metrics,            scope: "read" },
		// MCP server (Model Context Protocol over Streamable HTTP). Lets an
		// AI assistant introspect + drive the fleet as MCP tools. NOT public:
		// it spawns/stops services, so it sits behind the shared bearer like
		// the rest of the operator API. Clients pass Authorization: Bearer
		// <WITCHGRID_SHARED_SECRET>.
		{ method: "POST", path: "/mcp",           handler: handle_mcp },
		{ method: "GET",  path: "/mcp",           handler: handle_mcp_get },
		{ method: "POST", path: "/services",      handler: handle_spawn_proxy },
		{ method: "GET",  path: "/services",      handler: handle_list_services },
		{ method: "POST", path: "/services/stop", handler: handle_stop_proxy },
		{ method: "POST", path: "/unmanaged/kill", handler: handle_kill_unmanaged_proxy },
		{ method: "GET",  path: "/services/log/", prefix: true, handler: handle_service_log, scope: "read" },
		// Control-plane location lookup — consumers resolve a profile/
		// alias to a live llama-server host:port and connect directly
		// (CP stays off the inference data path). public: a location,
		// not a secret, and workers hit it before any bearer exists.
		{ method: "GET",  path: "/resolve/",      prefix: true, handler: handle_resolve, scope: "read" },
		// Dashboard shell + static assets (all baked into the binary)
		{ method: "GET",  path: "/",                       handler: handle_page_overview,    public: true },
		{ method: "GET",  path: "/catalog",                handler: handle_page_catalog,     public: true },
		{ method: "GET",  path: "/transfers",              handler: handle_page_transfers,   public: true },
		{ method: "GET",  path: "/profiles",               handler: handle_page_profiles,    public: true },
		{ method: "GET",  path: "/bench",                  handler: handle_page_bench,       public: true },
		{ method: "GET",  path: "/utilities",              handler: handle_page_bench,       public: true },
		{ method: "GET",  path: "/deploy",                 handler: handle_page_deploy,      public: true },
		{ method: "GET",  path: "/settings",               handler: handle_page_settings,    public: true },
		{ method: "GET",  path: "/assets/styles.css",      handler: handle_dashboard_css,    public: true },
		{ method: "GET",  path: "/assets/dashboard.js",    handler: handle_dashboard_js,     public: true },
		{ method: "GET",  path: "/assets/logo.svg",        handler: handle_logo,             public: true },
		// Dashboard live fragments + JSON profiles (the form needs structured data)
		{ method: "GET",  path: "/ui/nodes",        handler: handle_ui_nodes,         scope: "read" },
		{ method: "GET",  path: "/ui/services",     handler: handle_ui_services,      scope: "read" },
		{ method: "GET",  path: "/ui/layout",       handler: handle_ui_layout,        scope: "read" },
		{ method: "GET",  path: "/ui/profiles",     handler: handle_ui_profiles,      scope: "read" },
		{ method: "GET",  path: "/ui/capabilities", handler: handle_ui_capabilities,  scope: "read" },
		// Live state stream (SSE) — pushes fleet snapshots on change so the
		// dashboard updates without polling. Public, like the /ui fragments.
		{ method: "GET",  path: "/events",          handler: handle_events,           scope: "read" },
		{ method: "GET",  path: "/api/state",        handler: handle_state,            scope: "read" },
		{ method: "GET",  path: "/api/ready/",       prefix: true, handler: handle_service_ready, scope: "read" },
		{ method: "GET",  path: "/api/capabilities", handler: handle_list_capabilities, scope: "read" },
		// JSON API — moved under /api/ prefix in v0.6 because the
		// human-facing pages now own /catalog, /transfers, /profiles
		// at the URL roots. Spawn form's onProfileChange() fetch
		// updated to match.
		// Profiles CRUD lives under /api/profiles[/{name}] since v0.7
		// (CP-owned storage, was baked into agent binaries before).
		{ method: "GET",  path: "/api/profiles",    handler: handle_list_profiles_v2, scope: "read" },
		{ method: "POST", path: "/api/profiles",    handler: handle_create_profile },
		{ method: "GET",  path: "/api/settings",    handler: handle_list_settings,    scope: "read" },
		{ method: "GET",  path: "/api/config",      handler: handle_get_config,       scope: "read" },
		{ method: "PUT",  path: "/api/settings",    handler: handle_update_settings },
		{ method: "GET",  path: "/api/profile-aliases",  handler: handle_list_profile_aliases,   scope: "read" },
		{ method: "PUT",  path: "/api/profile-aliases",  handler: handle_upsert_profile_alias },
		{ method: "DELETE", path: "/api/profile-aliases/", prefix: true, handler: handle_delete_profile_alias },
		{ method: "GET",  path: "/api/profiles/",   prefix: true, handler: handle_get_profile,    scope: "read" },
		{ method: "PUT",  path: "/api/profiles/",   prefix: true, handler: handle_update_profile },
		{ method: "DELETE", path: "/api/profiles/", prefix: true, handler: handle_delete_profile },
		{ method: "GET",  path: "/api/catalog",     handler: handle_list_catalog,     scope: "read" },
		{ method: "GET",  path: "/ui/catalog",      handler: handle_ui_catalog,       scope: "read" },
		{ method: "POST", path: "/models/distribute", handler: handle_distribute },
		{ method: "POST", path: "/models/delete",   handler: handle_model_delete_proxy },
		{ method: "POST", path: "/api/scan-dirs",   handler: handle_scan_dirs_proxy },
		// HF search + pull (slice C4) — operator types a name in the
		// catalog page, picks a quant, kicks off a transfer to a node.
		{ method: "POST", path: "/api/hf/search",   handler: handle_hf_search },
		{ method: "POST", path: "/api/hf/files",    handler: handle_hf_files },
		{ method: "POST", path: "/api/hf/card",     handler: handle_hf_card },
		{ method: "POST", path: "/api/hf/discover", handler: handle_hf_discover },
		{ method: "POST", path: "/models/pull_hf",  handler: handle_pull_hf },
		{ method: "POST", path: "/api/placement_preview", handler: handle_placement_preview, scope: "read" },
		// Declarative layout (cp/layout.hml): the fleet as a document, a
		// capacity-safe ordered plan to reach another one, and its executor.
		{ method: "GET",  path: "/api/layout",       handler: handle_get_layout,       scope: "read" },
		{ method: "POST", path: "/api/layout/plan",  handler: handle_plan_layout,      scope: "read" },
		{ method: "POST", path: "/api/layout/apply", handler: handle_apply_layout },
		{ method: "GET",  path: "/api/layout/runs/", prefix: true, handler: handle_get_layout_run, scope: "read" },
		{ method: "GET",  path: "/api/transfers",   handler: handle_list_transfers,   scope: "read" },
		// Bench (v0.7+ slice C3): operator-triggered benchmarks of
		// (node × profile × build) combos. POST kicks off async,
		// GETs read history.
		{ method: "POST", path: "/api/bench",       handler: handle_create_bench },
		{ method: "GET",  path: "/api/bench",       handler: handle_list_bench,       scope: "read" },
		{ method: "GET",  path: "/api/bench/",      prefix: true, handler: handle_get_bench,      scope: "read" },
		{ method: "GET",  path: "/ui/bench",        handler: handle_ui_bench,         scope: "read" },
		{ method: "GET",  path: "/ui/transfers",    handler: handle_ui_transfers,     scope: "read" },
		{ method: "GET",  path: "/ui/missing",      handler: handle_ui_missing,       scope: "read" },
		{ method: "GET",  path: "/ui/stats",        handler: handle_ui_stats,         scope: "read" },
		// Inference routing — prefix-matches anything under /v1/llama/.
		// method "*" means any HTTP method is forwarded. Open by default;
		// WITCHGRID_AUTH_PROTECT_INFERENCE gates it behind the shared
		// bearer (per-consumer API tokens are slice 3).
		{ method: "*",    path: "/v1/llama/",     handler: handle_llama_proxy,
		  prefix: true, scope: "inference" },
	];

	// Graceful shutdown: on a termination signal, checkpoint the WAL (TRUNCATE
	// empties the -wal file) and exit cleanly, so the next start is from a
	// compact, fully-merged DB. Requires the Hemlock signal fix (async runtime
	// now masks signals on worker threads + delivers to the main thread, and
	// runs 0-/1-arg handlers; ≥ the build with hemlang/hemlock#587). WAL is
	// crash-durable regardless, so an incomplete checkpoint only ever falls
	// back to today's recover-on-next-open behavior.
	on_shutdown(fn(sig) {
		print("[cp] signal " + sig + " — checkpointing WAL and exiting");
		try { exec(DB, "PRAGMA wal_checkpoint(TRUNCATE)", []); } catch (e) { }
		try { close_db(DB); } catch (e) { }
		exit(0);
	});

	serve(HOST, PORT, routes, cp_auth_check);
	close_db(DB);
	return null;
}

main();
