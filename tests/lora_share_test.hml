// lora_share_test.hml — coverage for agent/lora_share.hml, the decisions
// behind shared-base LoRA serving (no I/O, no GPU).
//
// What matters most here: a member's request must select exactly its own
// adapter (every other id explicitly 0 — an empty list means "global
// scales" to llama-server), a client can't override that, profiles that
// differ in server settings never share, and the shared server is sized so
// no member loses slots or per-slot context.

import { describe, test, assert_eq, assert_true, assert_false } from "@stdlib/testing";
import { parse } from "@stdlib/json";
import {
	is_sharing_profile, is_shared_server_profile, valid_group_name,
	split_extra_flags, profile_adapters, profile_alias, member_slots,
	member_ctx_per_slot, sharing_profile_error, compat_signature, share_key,
	desired_config, config_covers, restart_config, selection_for, selection_json,
	is_injectable, blocked_reason, is_alias_rewrite, inject_lora,
	rewrite_alias_json, shared_server_profile, server_config, strip_query,
} from "../agent/lora_share";

fn thrown(cb) {
	try { cb(); } catch (e) { return "" + e; }
	return null;
}

fn luna(): object {
	return {
		binary: "llama-server", share_group: "spark",
		intent: { context: 65536, parallel_slots: 2, gpu_layers: 99, flash_attention: true },
		extra_flags: ["--jinja", "--lora", "/m/luna-f16.gguf"],
		kv_type: "f16",
	};
}

fn familiar(): object {
	return {
		binary: "llama-server", share_group: "spark",
		intent: { gpu_layers: 99, flash_attention: true, context: 65536, parallel_slots: 2 },
		extra_flags: ["--jinja"],
	};
}

fn riko(): object {
	return {
		binary: "llama-server", share_group: "spark",
		intent: { context: 24576, parallel_slots: 4, gpu_layers: 99, flash_attention: true },
		extra_flags: ["--jinja", "-a", "riko-9b-distill"],
		lora: [{ path: "/m/riko-f16.gguf", scale: 0.8 }],
	};
}

export fn register(): null {
	describe("lora_share: profile inspection", fn() {
		test("share_group opts in; other binaries / no group don't", fn() {
			assert_true(is_sharing_profile(luna()));
			assert_false(is_sharing_profile({ binary: "llama-server", intent: {} }));
			assert_false(is_sharing_profile({ binary: "sd-server", share_group: "x" }));
			assert_false(is_sharing_profile({ binary: "llama-server", share_group: "" }));
			assert_false(is_sharing_profile(null));
		});
		test("group names", fn() {
			assert_true(valid_group_name("spark"));
			assert_true(valid_group_name("b4-9b_q8.0"));
			assert_false(valid_group_name("Spark"));
			assert_false(valid_group_name("a b"));
			assert_false(valid_group_name(""));
			assert_false(valid_group_name(7));
		});
		test("extra_flags: adapters + alias pulled out, rest kept in order", fn() {
			let s = split_extra_flags(["--jinja", "--lora", "/a.gguf,/b.gguf", "-a", "luna,x",
				"--lora-scaled", "/c.gguf:0.5", "--lora-init-without-apply", "--cache-ram", "64",
				"--reasoning-budget", "0"]);
			assert_eq(s.common.join(" "), "--jinja --reasoning-budget 0");
			assert_eq(s.alias, "luna");
			assert_eq(s.adapters.length, 3);
			assert_eq(s.adapters[0].path, "/a.gguf");
			assert_eq(s.adapters[1].scale, 1.0);
			assert_eq(s.adapters[2].path, "/c.gguf");
			assert_eq(s.adapters[2].scale, 0.5);
		});
		test("extra_flags: context/slots/model must come from intent", fn() {
			assert_true(thrown(fn() { split_extra_flags(["-c", "8192"]); }) != null);
			assert_true(thrown(fn() { split_extra_flags(["--parallel", "2"]); }) != null);
			assert_true(thrown(fn() { split_extra_flags(["-m", "/x.gguf"]); }) != null);
			assert_true(thrown(fn() { split_extra_flags(["--lora"]); }) != null);
		});
		test("adapters from the lora field and flags; duplicates refused", fn() {
			let a = profile_adapters(riko());
			assert_eq(a.length, 1);
			assert_eq(a[0].scale, 0.8);
			assert_eq(profile_adapters({ lora: "/x.gguf" })[0].path, "/x.gguf");
			assert_eq(profile_adapters(familiar()).length, 0);
			let dup = { lora: "/m/luna-f16.gguf", extra_flags: ["--lora", "/m/luna-f16.gguf"] };
			assert_true(thrown(fn() { profile_adapters(dup); }) != null);
		});
		test("adapter paths llama-server can't parse are refused", fn() {
			assert_true(thrown(fn() { profile_adapters({ lora: "/x:y.gguf" }); }) != null);
			assert_true(thrown(fn() { profile_adapters({ lora: "/x,y.gguf" }); }) != null);
			assert_true(thrown(fn() { profile_adapters({ lora: 5 }); }) != null);
		});
		test("alias", fn() {
			assert_eq(profile_alias(riko()), "riko-9b-distill");
			assert_eq(profile_alias(luna()), null);
		});
		test("slots + per-slot context (ceil)", fn() {
			assert_eq(member_slots(luna()), 2);
			assert_eq(member_ctx_per_slot(luna()), 32768);
			assert_eq(member_ctx_per_slot({ intent: { context: 4097, parallel_slots: 2 } }), 2049);
			assert_true(thrown(fn() { member_slots({ intent: { context: 4096 } }); }) != null);
		});
		test("sharing_profile_error", fn() {
			assert_eq(sharing_profile_error(luna()), null);
			assert_eq(sharing_profile_error({ binary: "llama-server" }), null);
			assert_true(sharing_profile_error({ share_group: "spark", intent: { context: 1 } }) != null);
			assert_true(sharing_profile_error({ share_group: "Bad Name",
				intent: { context: 1, parallel_slots: 1 } }) != null);
		});
	});

	describe("lora_share: compatibility", fn() {
		test("signature ignores context, slots, adapters, alias, intent key order", fn() {
			assert_eq(compat_signature(luna()), compat_signature(familiar()));
			assert_eq(compat_signature(luna()), compat_signature(riko()));
		});
		test("signature differs on server settings", fn() {
			let f = familiar();
			f["extra_flags"] = [];
			assert_true(compat_signature(f) != compat_signature(luna()));
			let g = familiar();
			g.intent["kv_cache_k"] = "q8_0";
			assert_true(compat_signature(g) != compat_signature(luna()));
		});
		test("share key: same for compatible members, differs by model / GPUs / group", fn() {
			let k = share_key("spark", "/m/b4.gguf", luna(), [2]);
			assert_eq(k, share_key("spark", "/m/b4.gguf", familiar(), [2]));
			assert_true(k != share_key("spark", "/m/other.gguf", familiar(), [2]));
			assert_true(k != share_key("spark", "/m/b4.gguf", familiar(), [3]));
			assert_true(k != share_key("ember", "/m/b4.gguf", familiar(), [2]));
			assert_true(k.starts_with("spark#"));
		});
	});

	describe("lora_share: sizing", fn() {
		test("Luna + Familiar: 4 slots x 32768 = 131072, one adapter", fn() {
			let c = desired_config([luna(), familiar()]);
			assert_eq(c.slots, 4);
			assert_eq(c.ctx_per_slot, 32768);
			assert_eq(c.context, 131072);
			assert_eq(c.adapters.join(","), "/m/luna-f16.gguf");
		});
		test("adapters keep first-seen order; per-slot context is the max", fn() {
			let c = desired_config([luna(), riko(), familiar()]);
			assert_eq(c.adapters.join(","), "/m/luna-f16.gguf,/m/riko-f16.gguf");
			assert_eq(c.slots, 8);
			assert_eq(c.ctx_per_slot, 32768);
		});
		test("covers: loaded adapters + enough slots/context → no restart", fn() {
			let cur = desired_config([luna(), familiar()]);
			assert_true(config_covers(cur, desired_config([luna()])));
			assert_true(config_covers(cur, desired_config([familiar(), familiar()])));
			assert_false(config_covers(cur, desired_config([luna(), familiar(), familiar()])));
			assert_false(config_covers(cur, desired_config([riko()])));
			assert_false(config_covers(null, desired_config([luna()])));
		});
		test("restart config keeps surviving adapters' order and drops unwanted ones", fn() {
			let cur = { adapters: ["/a", "/b"], slots: 2, ctx_per_slot: 10, context: 20 };
			let want = { adapters: ["/c", "/b"], slots: 3, ctx_per_slot: 8, context: 24 };
			let r = restart_config(cur, want);
			assert_eq(r.adapters.join(","), "/b,/c");
			assert_eq(r.context, 24);
		});
	});

	describe("lora_share: per-request selection", fn() {
		test("member adapter at its scale, every other id explicitly 0", fn() {
			let server = ["/m/luna-f16.gguf", "/m/riko-f16.gguf"];
			assert_eq(selection_json(selection_for(server, profile_adapters(luna()))),
				"[{\"id\":0,\"scale\":1.0},{\"id\":1,\"scale\":0.0}]");
			assert_eq(selection_json(selection_for(server, profile_adapters(riko()))),
				"[{\"id\":0,\"scale\":0.0},{\"id\":1,\"scale\":0.8}]");
		});
		test("no-LoRA member: all zeros, never an empty list", fn() {
			let sel = selection_for(["/m/luna-f16.gguf"], profile_adapters(familiar()));
			assert_eq(sel.length, 1);
			assert_eq(sel[0].scale, 0.0);
			let p = parse(selection_json(sel));
			assert_eq(p[0].id, 0);
		});
		test("injectable endpoints: generation POSTs only", fn() {
			assert_true(is_injectable("POST", "/v1/chat/completions"));
			assert_true(is_injectable("POST", "/completion?x=1"));
			assert_true(is_injectable("POST", "/v1/embeddings"));
			assert_true(is_injectable("POST", "/infill"));
			assert_false(is_injectable("GET", "/v1/chat/completions"));
			assert_false(is_injectable("POST", "/tokenize"));
			assert_false(is_injectable("POST", "/apply-template"));
			assert_eq(strip_query("/a?b=c"), "/a");
		});
		test("refused on member ports: global adapter scales, slot save/restore", fn() {
			assert_true(blocked_reason("POST", "/lora-adapters") != null);
			assert_true(blocked_reason("POST", "/slots/0?action=restore") != null);
			assert_eq(blocked_reason("GET", "/lora-adapters"), null);
			assert_eq(blocked_reason("GET", "/slots"), null);
			assert_eq(blocked_reason("POST", "/completion"), null);
		});
		test("inject: appended as the last key (overrides a client lora), bytes kept", fn() {
			let sel = "[{\"id\":0,\"scale\":0.0}]";
			let out = inject_lora("{\"prompt\":\"héllo\",\"lora\":[{\"id\":0,\"scale\":1}]}\n", sel);
			assert_eq(out, "{\"prompt\":\"héllo\",\"lora\":[{\"id\":0,\"scale\":1}],\"lora\":" + sel + "}");
			assert_eq(inject_lora("{}", sel), "{\"lora\":" + sel + "}");
			assert_eq(inject_lora("  { \"a\" : 1 }  ", sel), "{ \"a\" : 1 ,\"lora\":" + sel + "}");
		});
		test("inject: non-object bodies are left alone", fn() {
			assert_eq(inject_lora("[1,2]", "[]"), null);
			assert_eq(inject_lora("not json", "[]"), null);
			assert_eq(inject_lora("{broken", "[]"), null);
			assert_eq(inject_lora("", "[]"), null);
		});
		test("alias rewrite: /v1/models, /models, /props", fn() {
			assert_true(is_alias_rewrite("GET", "/v1/models"));
			assert_true(is_alias_rewrite("GET", "/props"));
			assert_false(is_alias_rewrite("POST", "/props"));
			let m = parse(rewrite_alias_json("/v1/models",
				"{\"object\":\"list\",\"data\":[{\"id\":\"/m/b4.gguf\",\"owned_by\":\"llamacpp\"}],\"models\":[{\"name\":\"/m/b4.gguf\",\"model\":\"/m/b4.gguf\"}]}",
				"riko-9b-distill"));
			assert_eq(m.data[0].id, "riko-9b-distill");
			assert_eq(m.data[0].owned_by, "llamacpp");
			assert_eq(m.models[0].model, "riko-9b-distill");
			let p = parse(rewrite_alias_json("/props", "{\"model_alias\":\"x\",\"n_ctx\":4}", "luna"));
			assert_eq(p.model_alias, "luna");
			assert_eq(rewrite_alias_json("/v1/models", "nope", "a"), null);
		});
	});

	describe("lora_share: shared server profile", fn() {
		test("all adapters at global scale 0, cache-ram off, loopback, summed size", fn() {
			let cfg = desired_config([luna(), familiar()]);
			let caps = { "cache-ram": {}, "lora-scaled": {} };
			let p = shared_server_profile(familiar(), cfg, "spark", "spark#abc", caps, "/m/b4.gguf");
			assert_true(is_shared_server_profile(p));
			assert_false(is_sharing_profile(p));
			assert_eq(p.intent.context, 131072);
			assert_eq(p.intent.parallel_slots, 4);
			assert_eq(p.intent.gpu_layers, 99);
			assert_eq(p.extra_flags.join(" "),
				"--jinja --lora-scaled /m/luna-f16.gguf:0 --cache-ram 0");
			assert_eq(p.bind_host, "127.0.0.1");
			assert_eq(p.__shared_server.key, "spark#abc");
			let sc = server_config(p);
			assert_eq(sc.slots, 4);
			assert_eq(sc.adapters.join(","), "/m/luna-f16.gguf");
		});
		test("no --cache-ram on builds that don't have it", fn() {
			let cfg = desired_config([familiar()]);
			let p = shared_server_profile(familiar(), cfg, "spark", "k", { "lora-scaled": {} }, "/m");
			assert_eq(p.extra_flags.join(" "), "--jinja");
			assert_false(p.__shared_server.cache_ram_off);
		});
	});
	return null;
}
