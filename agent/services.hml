// services.hml — llama-server supervisor.
//
// The "fancy llama-server wrapper" pillar of Witchgrid v0.x: profile templates
// encoding opinionated default flags (Merlina-style: 4-bit KV cache, 128K
// context, no parallel slots), posix_spawn-detached children, sqlite-tracked
// PIDs, SIGTERM-graceful shutdown.
//
// Spawn model: open the log file and /dev/null as raw fds via fs.open_fd,
// hand them to posix_spawn as stdout/stderr/stdin redirects, set setsid:true
// so the child becomes its own session leader and survives us going away.
// No shell wrapper, no argv quoting, no shell-injection surface.
//
// CUDA_VISIBLE_DEVICES: setenv on the parent immediately before spawn
// (children inherit env), unsetenv immediately after. cp.hml's HTTP loop
// is single-threaded so there's no race window.
//
// Endpoints registered by cp.hml:
//   POST /services            { profile, model, port?, gpus? }    → 201 {id,...}
//   GET  /services                                                → [ {...} ]
//   POST /services/stop       { id }                              → 204
//   GET  /profiles                                                → [profile names]

import { posix_spawn, kill, get_pid, waitpid, exec_argv } from "@stdlib/process";
// Aliased: hemlockc emits `#undef <name>` for imported names, which
// clobbers the C macros SIGTERM / AF_INET for modules initialized later.
import { SIGTERM as SIG_TERM } from "@stdlib/signal";
import { setenv, unsetenv, getenv } from "@stdlib/env";
import { SpinLock } from "@stdlib/atomic";
import { open, open_fd, file_stat, list_dir, exists } from "@stdlib/fs";
import { fd_close } from "@stdlib/ipc";
import { exec as db_exec, query } from "@stdlib/sqlite";
import { parse, stringify } from "@stdlib/json";
import { sleep } from "@stdlib/time";
import { render_argv } from "./intent";
// Binary-path resolvers for the auto-restart watchdog (reconcile_services).
// reconcile respawns dead services itself, so it needs to resolve a
// profile's binary the same way agent.hml's spawn path does. No import
// cycle: only agent.hml imports services.hml, never these engine modules.
import { current_binary_path } from "./llama_cpp";
import { current_binary_path as sd_current_binary_path } from "./sd_cpp";
import { current_binary_path as wcpp_current_binary_path } from "./whisper_cpp";
import { current_binary_path as pcpp_current_binary_path } from "./piper_cpp";
// `local` engine: operator-declared command + port services. The
// declaration (argv/cwd/env) is read from the agent's own disk at spawn
// time — never from the CP payload. See local_services.hml.
import { local_services_dir, find_declaration, build_argv as local_build_argv,
	build_env as local_build_env } from "./local_services";
// Shared-base LoRA serving: pure decisions + the member-port proxy.
import { is_sharing_profile, is_shared_server_profile, sharing_profile_error,
	share_key, compat_signature, desired_config, config_covers, restart_config,
	shared_server_profile, server_config, profile_adapters, profile_alias,
	member_slots, member_ctx_per_slot } from "./lora_share";
import { start_member_proxy, stop_member_proxy, member_proxy_alive } from "./lora_proxy";
import { socket_create, AF_INET as NET_AF_INET, SOCK_STREAM as NET_SOCK_STREAM,
	SOL_SOCKET as NET_SOL_SOCKET, SO_REUSEADDR as NET_SO_REUSEADDR } from "@stdlib/net";

// IDs come from sqlite's hex(randomblob(16)) rather than @stdlib/uuid —
// keeps us at one FFI-backed stdlib dep (libsqlite3) and avoids needing
// libcrypto. The post-#531 codegen handles two FFI libs cleanly, but one
// fewer dynamic dep on the deploy box is still worth keeping.
fn new_id(db): string {
	let r = query(db, "select hex(randomblob(16)) as id", []);
	return r[0].id;
}

// ── profiles ──────────────────────────────────────────────────────────
// Profiles live on CP since v0.7 (was a baked-in PROFILES map here
// pre-v0.7). The agent doesn't know what profiles exist anymore — it
// just runs whatever profile object CP inlines into the spawn payload.
// Same intent → argv translation via agent/intent.hml; same capability
// gating; the only thing that changed is where the source of truth
// lives.

// ── schema ────────────────────────────────────────────────────────────

export fn init_services_schema(db): null {
	db_exec(db, "create table if not exists services ("
		+ "id text primary key,"
		+ "profile text not null,"
		+ "model_path text not null,"
		+ "pid integer not null,"
		+ "port integer not null,"
		+ "log_path text not null,"
		+ "args_json text not null,"
		+ "started_at text not null"
		+ ")", []);
	// profile_version added in slice 8 of the v0.7 dashboard polish.
	// Cross-version SQLite migration: ALTER TABLE ADD COLUMN succeeds
	// against fresh DBs (column gets created normally) and against
	// existing DBs (nullable column added, old rows get NULL). Wrapped
	// in try/catch because ALTER TABLE re-running on a DB that already
	// has the column throws "duplicate column name".
	try {
		db_exec(db, "alter table services add column profile_version integer", []);
	} catch (e) { }
	// state added for orphan adoption: services rows are now
	// soft-deleted ('stopped' / 'dead') instead of removed, so when
	// the agent restarts and finds an orphan llama-server matching a
	// previously-stored row's port, we can re-adopt with the right
	// profile metadata. Defaults to 'running' for fresh inserts and
	// for migration of pre-existing rows (those should all be live;
	// reap_zombie_services will catch any that aren't on next pass).
	try {
		db_exec(db, "alter table services add column state text not null default 'running'", []);
	} catch (e) { }
	// profile_json holds the full inlined profile object so adoption
	// can rebuild the row exactly as CP originally pushed it. Nullable
	// for back-compat with rows inserted by older agents.
	try {
		db_exec(db, "alter table services add column profile_json text", []);
	} catch (e) { }
	// gpus_json / tensor_split_json: the GPU pinning (CUDA_VISIBLE_DEVICES
	// indices) and tensor-split weights aren't recoverable from args_json
	// — gpus is passed via env, not argv — so the auto-restart watchdog
	// can't faithfully respawn a pinned service without them. Persist both
	// at spawn so reconcile_services rebuilds the exact placement.
	try {
		db_exec(db, "alter table services add column gpus_json text", []);
	} catch (e) { }
	try {
		db_exec(db, "alter table services add column tensor_split_json text", []);
	} catch (e) { }
	// restart_count: crash-loop bookkeeping for the watchdog. Carried
	// across respawns so a service that keeps dying gets parked in
	// 'failed' instead of looping forever.
	try {
		db_exec(db, "alter table services add column restart_count integer not null default 0", []);
	} catch (e) { }
	// stopped_at: when stop_service sent SIGTERM. finish_stops uses it to
	// escalate to SIGKILL once STOP_GRACE_SECONDS pass and the process is
	// still ours and alive. NULL for rows that ended any other way.
	try {
		db_exec(db, "alter table services add column stopped_at text", []);
	} catch (e) { }
	// Shared-base LoRA serving (lora_share.hml). share_role is 'server' for
	// a shared llama-server, 'member' for a profile served through it (its
	// pid is the agent's own — the member is a proxy inside the agent);
	// share_key links them. NULL for every ordinary service.
	try {
		db_exec(db, "alter table services add column share_key text", []);
	} catch (e) { }
	try {
		db_exec(db, "alter table services add column share_role text", []);
	} catch (e) { }
	return null;
}

// ── agent settings ──────────────────────────────────────────────────────
// Tiny key/value store for per-agent runtime knobs, mirroring CP's
// cp_settings pattern. Currently just `auto_restart` — the watchdog
// toggle — which defaults to 'true' so a fresh agent supervises its
// services (respawn on crash/reboot) without any operator setup.

export fn init_agent_settings_schema(db): null {
	db_exec(db, "create table if not exists agent_settings ("
		+ "key text primary key,"
		+ "value text not null"
		+ ")", []);
	db_exec(db,
		"insert or ignore into agent_settings (key, value) values ('auto_restart', 'true')",
		[]);
	return null;
}

export fn get_auto_restart(db): bool {
	let r = query(db, "select value from agent_settings where key = 'auto_restart'", []);
	if (r.length == 0) { return true; }   // default-on if the row is missing
	return r[0].value == "true";
}

export fn set_auto_restart(db, on: bool): null {
	db_exec(db,
		"insert into agent_settings (key, value) values ('auto_restart', ?) "
		+ "on conflict(key) do update set value = excluded.value",
		[on ? "true" : "false"]);
	return null;
}

// Generic agent_settings get/set (string values). Used for the editable
// scan-dirs override (persisted as a JSON array string).
export fn agent_setting_get(db, key: string, default_value: string): string {
	let r = query(db, "select value from agent_settings where key = ?", [key]);
	if (r.length == 0) { return default_value; }
	return r[0].value;
}

export fn agent_setting_set(db, key: string, value: string): null {
	db_exec(db,
		"insert into agent_settings (key, value) values (?, ?) "
		+ "on conflict(key) do update set value = excluded.value",
		[key, value]);
	return null;
}

// Mark stale rows as 'dead' (soft-delete) so the orphan-adoption
// path can later port-match a discovered llama-server back to the
// profile metadata that originally spawned it. Catches:
//
//   1. Process exited (crash, OOM, operator kill) — process_alive
//      returns false. Row becomes 'dead'.
//   2. PID recycled to a different process — process_alive returns
//      true but cmdline isn't llama-server. Row becomes 'dead'.
//   3. PID alive AND is one of our llama-servers — keep state.
//      This is the agent-crash-and-restart path; children survived
//      (init reparented via setsid), the row survived in sqlite,
//      reconciliation is automatic.
//
// Also prunes 'dead' rows older than ADOPTION_HISTORY_DAYS so the
// table doesn't grow forever. 7d is plenty — after a week, the
// llama-server children have almost certainly been killed by reboot.
//
// Returns the number of rows transitioned to 'dead' (for logging).
let ADOPTION_HISTORY_DAYS = 7;

export fn reap_zombie_services(db): i32 {
	let rows = query(db,
		"select id, pid, profile_json, share_role from services where state = 'running'", []);
	let reaped = 0;
	let me = get_pid();
	for (row in rows) {
		// Binary-aware (service_healthy), so with the watchdog off a live
		// sd/whisper/piper/local service isn't misread as a recycled
		// llama-server pid and dropped from 'running'. A shared-LoRA member
		// is a proxy inside the agent: alive iff it belongs to this process
		// (with the watchdog off nothing re-binds it after an agent restart).
		let drop = false;
		if (row?.share_role == "member") { drop = (row.pid != me); }
		else { drop = !service_healthy(row.pid, row_binary(row.profile_json)); }
		if (drop) {
			db_exec(db,
				"update services set state = 'dead' where id = ?",
				[row.id]);
			reaped = reaped + 1;
		}
	}
	prune_service_history(db);
	return reaped;
}

// Prune ancient soft-deleted rows. Keep enough recent history for
// adoption to work across the kinds of restart windows that happen
// during normal ops (CP upgrades, agent bounces). Shared by
// reap_zombie_services and reconcile_services so history is pruned on
// whichever path is doing the per-tick cleanup.
fn prune_service_history(db): null {
	// Superseded rows: a profile that crashed (state 'failed'/'dead'/
	// 'stopped') but is now 'running' again left a stale terminal row that
	// the dashboard renders as a phantom "down" alongside the live one.
	// Drop those immediately regardless of age — the failure is resolved
	// once a running instance for the same profile exists. (The 'failed'
	// "needs a human" signal is only meaningful while nothing's running.)
	db_exec(db,
		"delete from services where state in ('dead', 'stopped', 'failed') "
		+ "and profile in (select profile from services where state = 'running')",
		[]);
	// Age-based prune of the remaining (genuinely-not-running) history.
	db_exec(db,
		"delete from services where state in ('dead', 'stopped', 'failed') "
		+ "and started_at < datetime('now', ?)",
		["-" + ADOPTION_HISTORY_DAYS + " days"]);
	return null;
}

// Platform probe for the process-introspection helpers below. Linux
// exposes /proc (fast, no fork); macOS/BSD don't, so we fall back to
// `ps`. A bare exists() stat — cheap enough to call per-helper rather
// than caching across the spawn()-snapshot boundary of the watchdog
// task. Without this branch the /proc reads silently return "dead" on
// macOS, which would make the watchdog respawn every healthy service.
fn host_has_proc(): bool {
	return exists("/proc/self");
}

// True iff the process at <pid> is one of ours running `binary`
// (e.g. "llama-server", "sd-server"). Used by reap/reconcile/discover
// to detect PID recycling (a live pid that ISN'T our server). Linux:
// argv[0] from /proc/<pid>/cmdline. macOS: the command column from ps.
fn proc_runs_binary(pid: i32, binary: string): bool {
	if (host_has_proc()) {
		try {
			let f = open("/proc/" + pid + "/cmdline", "r");
			let content = f.read();
			f.close();
			if (content == null || content.length == 0) { return false; }
			// argv[0] is the first nul-terminated string; match the name
			// anywhere in it (covers absolute paths and bare names).
			let nul = content.find("\0");
			let head = nul > 0 ? content.substr(0, nul) : content;
			return head.find(binary) >= 0;
		} catch (e) {
			return false;
		}
	}
	// macOS / no-proc: ps -o command= gives the full command line.
	try {
		let r = exec_argv(["ps", "-o", "command=", "-p", "" + pid]);
		if (r.exit_code != 0) { return false; }
		return r.output.find(binary) >= 0;
	} catch (e) {
		return false;
	}
}

fn is_our_llama_server(pid: i32): bool {
	return proc_runs_binary(pid, "llama-server");
}

// Walk own-uid llama-server processes and emit a log line for any
// not currently represented in the services table. Doesn't auto-
// adopt — without the original profile/intent metadata we can't
// fabricate a matching services row that would survive a witchgrid
// upgrade. But surfacing them at boot lets the operator see "hey,
// these are here, decide whether to claim or kill."
//
// Uses `pgrep -af llama-server` rather than nvidia-smi: CPU-only
// services (gpu_layers=0) don't appear in nvidia-smi compute apps,
// and we want to catch those too.
// On boot, walk same-uid llama-server processes and reconcile them
// with our services table. Three outcomes per discovered process:
//
//   - Already running in our table (PID match) → no-op
//   - Port matches a soft-deleted row (state in 'dead'/'stopped')
//     and the row has profile_json → ADOPT: update pid, flip state
//     back to 'running'. The service is now under our wing again.
//   - No port match anywhere → log [orphan] and leave alone. We
//     have no profile metadata to reconstruct it; operator decides.
//
// This is the "agent crashed mid-flight, children survived" recovery
// path: the row was preserved in sqlite (because reap soft-deletes
// rather than hard-deletes), the child kept running, and now we
// stitch them back together by port.
export fn discover_orphan_llama_servers(db, our_uid: i32): null {
	let r = null;
	try {
		r = exec_argv(["pgrep", "-u", "" + our_uid, "-f", "llama-server"]);
	} catch (e) { return null; }
	if (r.output.length == 0) { return null; }

	// PIDs already running in our table — skip.
	let known = {};
	let owned = query(db,
		"select pid from services where state = 'running'", []);
	for (o in owned) { known["" + o.pid] = true; }

	let lines = r.output.split("\n");
	for (line in lines) {
		let pid_str = line.trim();
		if (pid_str.length == 0) { continue; }
		let pid = i32(pid_str);
		if (!is_our_llama_server(pid)) { continue; }
		if (known.has("" + pid)) { continue; }
		if (!is_our_uid(pid, our_uid)) { continue; }
		let port_str = read_arg_after(pid, "--port");
		let model = read_arg_after(pid, "-m");
		if (port_str == null) {
			print("[orphan] pid " + pid + " no --port in argv, can't adopt");
			continue;
		}
		let port = i32(port_str);

		// Find the most recent soft-deleted row with this port +
		// matching model_path (if we know the model). Model match
		// guards against the case where the operator stopped one
		// service, started a different one on the same port, then
		// the agent crashed — we don't want to adopt the new one
		// into the old one's profile slot.
		let candidates = query(db,
			"select id, profile, port, profile_json, profile_version "
			+ "from services where state in ('dead', 'stopped') and port = ? "
			+ "and (model_path = ? or model_path is null) "
			+ "and (share_role is null or share_role <> 'member') "
			+ "order by started_at desc limit 1",
			[port, model ?? ""]);
		if (candidates.length == 0) {
			print("[orphan] pid " + pid + " port=" + port
				+ " model=" + (model ?? "?")
				+ " — running but no matching history row. "
				+ "Kill manually or spawn a fresh service for the same profile.");
			continue;
		}
		let cand = candidates[0];
		// Adopt: bind the new pid to the historical row, flip back
		// to 'running'. The profile_json on the row already carries
		// everything CP needs to recognize this service.
		db_exec(db,
			"update services set pid = ?, state = 'running' where id = ?",
			[pid, cand.id]);
		print("[adopt] pid " + pid + " port=" + port + " profile="
			+ cand.profile + " v" + cand.profile_version
			+ " — re-attached to historical row " + cand.id.substr(0, 8) + "…");
	}
	return null;
}

// sd-server (stable-diffusion.cpp) orphan reconciliation. Parallel to
// discover_orphan_llama_servers — same crash-recovery contract — but
// matches the sd-server binary and reads the bind port from
// --listen-port (sd-server's flag) instead of --port.
fn is_our_sd_server(pid: i32): bool {
	return proc_runs_binary(pid, "sd-server");
}

export fn discover_orphan_sd_servers(db, our_uid: i32): null {
	let r = null;
	try {
		r = exec_argv(["pgrep", "-u", "" + our_uid, "-f", "sd-server"]);
	} catch (e) { return null; }
	if (r.output.length == 0) { return null; }

	let known = {};
	let owned = query(db,
		"select pid from services where state = 'running'", []);
	for (o in owned) { known["" + o.pid] = true; }

	let lines = r.output.split("\n");
	for (line in lines) {
		let pid_str = line.trim();
		if (pid_str.length == 0) { continue; }
		let pid = i32(pid_str);
		if (!is_our_sd_server(pid)) { continue; }
		if (known.has("" + pid)) { continue; }
		if (!is_our_uid(pid, our_uid)) { continue; }
		let port_str = read_arg_after(pid, "--listen-port");
		let model = read_arg_after(pid, "-m");
		if (port_str == null) {
			print("[orphan] sd pid " + pid + " no --listen-port in argv, can't adopt");
			continue;
		}
		let port = i32(port_str);

		let candidates = query(db,
			"select id, profile, port, profile_json, profile_version "
			+ "from services where state in ('dead', 'stopped') and port = ? "
			+ "and (model_path = ? or model_path is null) "
			+ "and (share_role is null or share_role <> 'member') "
			+ "order by started_at desc limit 1",
			[port, model ?? ""]);
		if (candidates.length == 0) {
			print("[orphan] sd pid " + pid + " port=" + port
				+ " model=" + (model ?? "?")
				+ " — running but no matching history row. "
				+ "Kill manually or spawn a fresh service for the same profile.");
			continue;
		}
		let cand = candidates[0];
		db_exec(db,
			"update services set pid = ?, state = 'running' where id = ?",
			[pid, cand.id]);
		print("[adopt] sd pid " + pid + " port=" + port + " profile="
			+ cand.profile + " v" + cand.profile_version
			+ " — re-attached to historical row " + cand.id.substr(0, 8) + "…");
	}
	return null;
}

fn is_our_uid(pid: i32, our_uid: i32): bool {
	if (host_has_proc()) {
		try {
			let s = exec_argv(["stat", "-c", "%u", "/proc/" + pid]);
			if (s.exit_code != 0) { return false; }
			return i32(s.output.trim()) == our_uid;
		} catch (e) { return false; }
	}
	// macOS / no-proc: ps uid column.
	try {
		let r = exec_argv(["ps", "-o", "uid=", "-p", "" + pid]);
		if (r.exit_code != 0) { return false; }
		return i32(r.output.trim()) == our_uid;
	} catch (e) { return false; }
}

// Read /proc/<pid>/cmdline, find the named arg, return its value
// (the next argv element). Null when not found or unreadable.
//
// cmdline is nul-separated argv. Use file.read_binary (Hemlock 2.4.1+)
// to get the raw bytes intact, walk to find 0x00 boundaries, slice
// out each segment as a string. The pre-2.4.1 workaround was a
// `tr '\0' '\n'` shellout because file.read() truncated at the first
// nul byte.
fn read_arg_after(pid: i32, name: string) {
	if (host_has_proc()) {
		try {
			let f = open("/proc/" + pid + "/cmdline", "r");
			let buf = f.read_binary();
			f.close();
			if (buf == null || buf.length == 0) { return null; }

			// Walk bytes, slice each nul-bounded segment into argv. We only
			// need to find one match so we could short-circuit on the first
			// `name` hit, but a full pass is microseconds for typical
			// cmdlines (< 1 KB) — readability wins.
			let argv = [];
			let start: i32 = 0;
			let i: i32 = 0;
			while (i < buf.length) {
				if (buf[i] == 0) {
					let sub = buf.slice(start, i);
					argv.push(__string_from_bytes(sub));
					start = i + 1;
				}
				i = i + 1;
			}

			let j: i32 = 0;
			while (j < argv.length - 1) {
				if (argv[j] == name) { return argv[j + 1]; }
				j = j + 1;
			}
		} catch (e) { }
		return null;
	}
	// macOS / no-proc: ps -o command= then split on spaces. Lossy for
	// args containing spaces, but our flags (--port/--listen-port/-m)
	// all take simple values.
	try {
		let r = exec_argv(["ps", "-o", "command=", "-p", "" + pid]);
		if (r.exit_code != 0) { return null; }
		let parts = r.output.trim().split(" ");
		let k: i32 = 0;
		while (k < parts.length - 1) {
			if (parts[k] == name) { return parts[k + 1]; }
			k = k + 1;
		}
	} catch (e) { }
	return null;
}

// ── helpers ───────────────────────────────────────────────────────────

fn iso_now(db): string {
	let r = query(db, "select datetime('now') as ts", []);
	return r[0].ts;
}

// kill(pid, 0) returns success for zombie processes (process exited but
// not yet reaped), which makes it useless for "is this child still doing
// work?" checks. Read /proc/<pid>/status and parse the State: line —
// Z (zombie), X (dead), T (stopped) all mean "not alive" for placement
// purposes. Linux-specific; portability hit if we ever support macOS
// agents (waitpid(pid, WNOHANG) would be the cross-platform answer
// once Hemlock 2.2.x is settled).
fn process_alive(pid: i32): bool {
	if (host_has_proc()) {
		try {
			let f = open("/proc/" + pid + "/status", "r");
			let content = f.read();
			f.close();
			if (content == null || content.length == 0) { return false; }
			let idx = content.find("State:");
			if (idx < 0) { return false; }
			let i = idx + 6;
			while (i < content.length) {
				let c = content[i];
				if (c != ' ' && c != '\t') { break; }
				i = i + 1;
			}
			if (i >= content.length) { return false; }
			let state = content[i];
			return state != 'Z' && state != 'X' && state != 'T';
		} catch (e) {
			return false;
		}
	}
	// macOS / no-proc: ps state column. First char Z=zombie, T=stopped
	// → not alive (mirrors the Linux Z/X/T exclusion; macOS ps has no X).
	try {
		let r = exec_argv(["ps", "-o", "state=", "-p", "" + pid]);
		if (r.exit_code != 0) { return false; }
		let s = r.output.trim();
		if (s.length == 0) { return false; }
		let c = s[0];
		return c != 'Z' && c != 'T';
	} catch (e) {
		return false;
	}
}

// Read up to `max_bytes` from the end of a file. Best-effort — returns
// empty string on any error so callers can use it inline without their
// own try/catch (we use this in the spawn-failed error path; the original
// failure is the interesting bit, not whether we could read its log).
fn read_log_tail(path: string, max_bytes: i32): string {
	try {
		let stat = file_stat(path);
		let f = open(path, "r");
		let start = 0;
		if (stat.size > max_bytes) { start = i32(stat.size) - max_bytes; }
		f.seek(start);
		let content = f.read();
		f.close();
		if (content == null) { return ""; }
		return content;
	} catch (e) {
		return "";
	}
}

// How long to wait before deciding the child crashed-on-launch.
//
// Choosing this is a tradeoff. Too short and we false-pass spawns that
// will fail their socket bind a moment later (llama-server runs CUDA
// init *before* binding, which on a multi-GPU box takes ~1s — we get
// past the grace check, then bind fails, then we've already returned
// 201). Too long and we tax every successful spawn with that latency.
//
// 2.0s is empirical: covers post-CUDA-init bind failures on schneewolf
// (4× 4060 Ti, ~1s CUDA enumeration) with margin, while a successful
// 12B model spawn takes 15-30s of mmap + GPU upload, so the grace is
// noise on top.
let SPAWN_FAILURE_GRACE_SECONDS = 2.0;

// Serializes the process-global env mutation (CUDA_VISIBLE_DEVICES /
// LD_LIBRARY_PATH) around posix_spawn so concurrent spawns on the
// multi-threaded agent can't cross-contaminate each other's GPU pin.
// See spawn_service() for the critical section.
let SPAWN_ENV_LOCK = SpinLock();

// Multimodal autoload: a llama.cpp vision model is a normal chat GGUF
// plus a separate projector (mmproj) GGUF. The catalog can't track the
// mmproj (no arch metadata — same reason SD ggufs are skipped), so we
// pair it here from the model's own directory: any sibling whose name
// contains "mmproj" and ends .gguf. Prefer f16 (projector is small;
// quantizing it costs vision quality for ~no VRAM — same principle as
// keeping the KV cache f16), then q8, then whatever's there. Returns
// the absolute mmproj path or null. An explicit --mmproj in the
// profile's extra_flags overrides this (checked at the call site).
fn find_mmproj_sibling(model_path: string) {
	let li = -1;
	let i = 0;
	while (i < model_path.length) {
		if (model_path.substr(i, 1) == "/") { li = i; }
		i = i + 1;
	}
	if (li < 0) { return null; }
	let dir = model_path.substr(0, li);
	let entries = null;
	try { entries = list_dir(dir); } catch (e) { return null; }
	let f16 = null;
	let q8 = null;
	let any = null;
	for (name in entries) {
		let ln = name.lower();
		if (ln.find("mmproj") < 0) { continue; }
		if (name.length < 5) { continue; }
		if (name.substr(name.length - 5, 5) != ".gguf") { continue; }
		let full = dir + "/" + name;
		if (any == null) { any = full; }
		if (f16 == null && ln.find("f16") >= 0) { f16 = full; }
		if (q8 == null && ln.find("q8") >= 0) { q8 = full; }
	}
	if (f16 != null) { return f16; }
	if (q8 != null) { return q8; }
	return any;
}

// ── core: spawn ───────────────────────────────────────────────────────

export fn spawn_service(db, profile_name: string, prof, model_path: string, port: i32, gpus, tensor_split, capabilities, binary_path: string): object {
	if (prof == null) {
		throw "spawn_service called without a profile object — "
			+ "v0.7+ requires CP to inline the profile in the spawn payload";
	}
	if (prof?.binary == "local") {
		return spawn_local_service(db, profile_name, prof, port, gpus);
	}
	// share_group profile: join (or start) the shared llama-server for its
	// base model and serve this profile through a proxy on its own port.
	if (is_sharing_profile(prof)) {
		return join_shared(db, profile_name, prof, model_path, port, gpus,
			tensor_split, capabilities, binary_path);
	}

	// Build full argv: binary + intent-derived flags + extras + spawner-set
	// model/port/host. capabilities is the parsed --help map for prof.binary
	// — passed in rather than re-introspected per spawn.
	//
	// binary_path is the resolved on-disk binary (or bare name for PATH
	// lookup) provided by agent.hml's caller — comes from
	// llama_cpp.current_binary_path() since v0.7 C2 so a Witchgrid-
	// managed install is honored.
	// sd-server (stable-diffusion.cpp) is a second engine with a
	// different CLI surface: image profiles carry an empty intent map
	// (no context/kv/gpu-layers concepts) + extra_flags only, and the
	// bind flags are -l/--listen-port, not --host/--port. It also has
	// no --tensor-split. Branch on the profile's declared binary.
	let is_sd = (prof?.binary == "sd-server");

	// The caps-empty guard exists because llama profiles render intents
	// against the parsed --help map; an empty map means a broken/missing
	// binary. sd-server image profiles render no intents, so an empty
	// caps map is benign there — skip the guard for sd-server.
	if (!is_sd && (capabilities == null || capabilities.keys().length == 0)) {
		throw "agent has no parsed capabilities for " + prof.binary
			+ " (introspection may have failed at boot — check agent log)";
	}
	let argv = [binary_path];
	let derived = render_argv(prof?.intent ?? {}, prof?.extra_flags ?? [],
		capabilities ?? {});
	for (a in derived) { argv.push(a); }
	argv.push("-m"); argv.push(model_path);
	if (is_sd) {
		argv.push("--listen-port"); argv.push("" + port);
		argv.push("-l"); argv.push("0.0.0.0");
	} else {
		argv.push("--port"); argv.push("" + port);
		// A shared-LoRA server binds loopback only: members reach it through
		// their proxies, which pin the adapter per request.
		argv.push("--host");
		argv.push(is_shared_server_profile(prof) ? (prof?.bind_host ?? "127.0.0.1") : "0.0.0.0");

		// Multimodal autoload (llama-server only). If the model has a
		// co-located mmproj projector and the profile didn't already
		// pin one explicitly, pass it so vision "just works" off a
		// normal chat profile pointing at a VL model.
		let has_explicit_mmproj = false;
		for (f in (prof?.extra_flags ?? [])) {
			if (f == "--mmproj") { has_explicit_mmproj = true; }
		}
		if (!has_explicit_mmproj) {
			let mmproj = find_mmproj_sibling(model_path);
			if (mmproj != null) {
				argv.push("--mmproj"); argv.push(mmproj);
				print("[spawn] mmproj autoloaded: " + mmproj);
			}
		}
	}

	// Multi-GPU tensor-parallel split. We only emit --tensor-split when
	// CP told us to — for single-GPU spawns the flag isn't needed (or
	// meaningful), and for multi-GPU pinned spawns where CP didn't
	// compute weights, we leave llama-server to its default equal-split.
	//
	// Capability gate: if the binary doesn't expose --tensor-split (very
	// old llama.cpp or a CPU-only build), fail loud rather than silently
	// shipping a malformed argv. The placement decision was made on the
	// assumption tensor-split would work; if it can't, the operator
	// needs to know.
	if (!is_sd && tensor_split != null && tensor_split.length > 1) {
		if (!capabilities.has("tensor-split")) {
			throw "binary does not support --tensor-split but CP placed a "
				+ "multi-GPU spawn (" + tensor_split.length + " GPUs). "
				+ "Either upgrade llama.cpp on this node or pin to a "
				+ "single GPU.";
		}
		let csv = "";
		let i = 0;
		while (i < tensor_split.length) {
			if (i > 0) { csv = csv + ","; }
			csv = csv + tensor_split[i];
			i = i + 1;
		}
		// Use the binary's actual short form when present (typically -ts).
		let ts_cap = capabilities["tensor-split"];
		let ts_flag = "--tensor-split";
		if (ts_cap?.short != null) { ts_flag = ts_cap.short; }
		argv.push(ts_flag);
		argv.push(csv);
	}

	let id = new_id(db);
	let log_path = "/tmp/witchgrid-" + id + ".log";

	// Open the log file (truncate) and /dev/null (read) as raw fds so
	// posix_spawn can dup2 them onto the child's std{in,out,err}.
	let log_fd = open_fd(log_path, "w");
	let null_fd = open_fd("/dev/null", "r");

	// CUDA_VISIBLE_DEVICES via setenv around the spawn. posix_spawn's `env`
	// opt would *replace* the parent env (losing PATH/HOME/etc), so we
	// mutate the parent env transiently instead — children inherit, then
	// we restore. Safe because cp.hml is single-threaded.
	//
	// Three placement modes:
	//   pinned (gpus.length > 0)              → CVD = "0,2"   pick GPUs
	//   cpu_only (gpu_layers=0, gpus empty)   → CVD = ""      hide all GPUs
	//                                                           so flash_attn
	//                                                           can't grab one
	//   neither (auto, no constraint)          → CVD untouched (child sees all)
	let pinned   = (gpus != null && gpus.length > 0);
	let cpu_only = (!pinned && prof?.intent?.gpu_layers == 0);

	// The env mutation below is PROCESS-GLOBAL but the agent serves each
	// connection on its own thread, so two concurrent spawns could
	// cross-contaminate the GPU pin (a service landing on the wrong GPU,
	// or a cpu_only service inheriting a stale CUDA_VISIBLE_DEVICES).
	// Serialize the whole setenv→posix_spawn→unsetenv window under a
	// module lock. The critical section is microseconds (posix_spawn is
	// fork+exec, not the model load), so spin contention is negligible.
	// try/catch guarantees the lock + env are released even if
	// posix_spawn throws — otherwise one failure would deadlock all
	// future spawns.
	SPAWN_ENV_LOCK.acquire();
	let result = null;
	try {
		if (pinned) {
			let csv = "";
			let g = 0;
			while (g < gpus.length) {
				if (g > 0) { csv = csv + ","; }
				csv = csv + gpus[g];
				g = g + 1;
			}
			setenv("CUDA_VISIBLE_DEVICES", csv);
		} else if (cpu_only) {
			setenv("CUDA_VISIBLE_DEVICES", "");
		}

		// sd-server can't find libstable-diffusion.so on its own: the
		// upstream prebuilt's RUNPATH is the dead GitHub-Actions build dir
		// (no $ORIGIN), and even a source build keeps the lib next to the
		// binary rather than in a system path. Point LD_LIBRARY_PATH at the
		// binary's own directory so the co-located .so (and any ggml libs)
		// resolve. Same transient-parent-env trick as CUDA_VISIBLE_DEVICES.
		// The agent's launch env doesn't set LD_LIBRARY_PATH, so a plain
		// set→unset (no prior-value restore) is safe here.
		if (is_sd) {
			let li = -1;
			let bi = 0;
			while (bi < binary_path.length) {
				if (binary_path.substr(bi, 1) == "/") { li = bi; }
				bi = bi + 1;
			}
			let libdir = li >= 0 ? binary_path.substr(0, li) : ".";
			setenv("LD_LIBRARY_PATH", libdir);
		}

		result = posix_spawn(argv, {
			stdin: null_fd,
			stdout: log_fd,
			stderr: log_fd,
			setsid: true,
		});

		if (pinned || cpu_only) {
			unsetenv("CUDA_VISIBLE_DEVICES");
		}
		if (is_sd) {
			unsetenv("LD_LIBRARY_PATH");
		}
	} catch (e) {
		try { unsetenv("CUDA_VISIBLE_DEVICES"); } catch (e2) { }
		try { unsetenv("LD_LIBRARY_PATH"); } catch (e2) { }
		SPAWN_ENV_LOCK.release();
		fd_close(log_fd);
		fd_close(null_fd);
		throw e;
	}
	SPAWN_ENV_LOCK.release();
	fd_close(log_fd);
	fd_close(null_fd);

	return finish_spawn(db, id, log_path, result.pid, profile_name, prof,
		model_path, port, argv, gpus, tensor_split, false);
}

// Shared tail of every spawn: the crash-on-launch grace check, then the
// services row. group_kill: the child is a `local` service — on a failed
// launch, take down anything it already forked (its process group; see
// signal_group) so a half-started venv doesn't keep a port or a GPU.
fn finish_spawn(db, id: string, log_path: string, pid: i32, profile_name: string,
                prof, model_path: string, port: i32, argv, gpus, tensor_split,
                group_kill: bool): object {
	if (pid <= 0) {
		throw "posix_spawn returned invalid pid: " + pid;
	}

	// Did the child immediately exit? Common causes: contended port,
	// missing model file, missing CUDA runtime, malformed args. Without
	// this check, we'd return 201 + a pid that's already a zombie, and
	// the caller wouldn't know until the next /v1/llama/* request fails
	// or the next agent /services list shows alive=false. Surface it now.
	sleep(SPAWN_FAILURE_GRACE_SECONDS);
	if (!process_alive(pid)) {
		reap_child(pid);
		if (group_kill) { signal_group(pid, SIGKILL); }
		let tail = read_log_tail(log_path, 4096);
		let msg = "spawn died immediately (pid " + pid + " exited within "
			+ SPAWN_FAILURE_GRACE_SECONDS + "s)";
		if (tail.length > 0) {
			msg = msg + "; log tail:\n" + tail;
		} else {
			msg = msg + " (no log output captured at " + log_path + ")";
		}
		throw msg;
	}

	let now = iso_now(db);
	// profile_version comes from CP's all_profiles_map() which stamps
	// __version onto the inlined profile object. Captured at spawn time
	// so the dashboard can flag a "stale" badge if the operator edits
	// the profile after the service is already running.
	let pv = prof?.__version;
	// profile_json holds the full inlined profile so adoption can
	// rebuild the row exactly when an orphan is discovered after
	// agent restart with sqlite intact OR after sqlite wipe (when
	// adoption falls back to log-only because no row exists at all).
	let pjson = stringify(prof);
	// Persist placement so the watchdog can respawn with identical GPU
	// pinning (gpus → CUDA_VISIBLE_DEVICES, not visible in argv) and
	// tensor-split weights. Null when unpinned/auto.
	let gjson = (gpus != null && gpus.length > 0) ? stringify(gpus) : null;
	let tjson = (tensor_split != null) ? stringify(tensor_split) : null;
	db_exec(db,
		"insert into services (id, profile, model_path, pid, port, log_path, args_json, started_at, profile_version, profile_json, gpus_json, tensor_split_json, state) "
		+ "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'running')",
		[id, profile_name, model_path, pid, port, log_path, stringify(argv), now, pv, pjson, gjson, tjson]);
	if (is_shared_server_profile(prof)) {
		db_exec(db, "update services set share_key = ?, share_role = 'server' where id = ?",
			[prof.__shared_server.key, id]);
	}

	return {
		id: id,
		profile: profile_name,
		model_path: model_path,
		pid: pid,
		port: port,
		log_path: log_path,
		started_at: now,
		profile_version: pv,
	};
}

// ── local engine: spawn + process-group helpers ───────────────────────

// Spawn a `local` service from its agent-side declaration. The profile
// contributes only the declared name (prof.local_service) and, through
// placement, the port and GPU pin; its intent / extra_flags / model are
// ignored on purpose — the CP can choose WHICH declared service runs and
// where, never WHAT it runs.
//
// Differences from the engine path above, both because the child is an
// arbitrary program rather than a single known binary:
//   - env is built explicitly and handed to posix_spawn (`env:` replaces
//     the environment), with cwd set via `cwd:` — no setenv on the agent,
//     so no SPAWN_ENV_LOCK window, and the agent's shared secret is not
//     inherited.
//   - setsid makes the child the leader of its own process group
//     (pgid == pid). A `run.sh` that starts python without `exec` leaves
//     the real server as a grandchild; stop / SIGKILL escalation / the
//     watchdog therefore signal the whole group, not just the leader.
fn spawn_local_service(db, profile_name: string, prof, port: i32, gpus): object {
	let decl = find_declaration(local_services_dir(), prof?.local_service);
	let argv = local_build_argv(decl, port);

	// Same three placement modes as the engines, expressed as a value
	// rather than an env mutation. A service declared with vram_mb 0
	// gets no GPU (CUDA hidden) unless explicitly pinned.
	let pinned = (gpus != null && gpus.length > 0);
	let cvd = null;
	if (pinned) {
		let csv = "";
		let g = 0;
		while (g < gpus.length) {
			if (g > 0) { csv = csv + ","; }
			csv = csv + gpus[g];
			g = g + 1;
		}
		cvd = csv;
	} else if (prof?.intent?.gpu_layers == 0 || decl.vram_mb == 0) {
		cvd = "";
	}
	let env = local_build_env(decl, port, cvd);

	let id = new_id(db);
	let log_path = "/tmp/witchgrid-" + id + ".log";
	let log_fd = open_fd(log_path, "w");
	let null_fd = open_fd("/dev/null", "r");
	let result = null;
	try {
		result = posix_spawn(argv, {
			stdin: null_fd,
			stdout: log_fd,
			stderr: log_fd,
			setsid: true,
			env: env,
			cwd: decl.cwd,
		});
	} catch (e) {
		fd_close(log_fd);
		fd_close(null_fd);
		throw e;
	}
	fd_close(log_fd);
	fd_close(null_fd);
	print("[spawn] local " + decl.name + " port=" + port
		+ " gpus=" + (cvd == null ? "inherit" : (cvd == "" ? "none" : cvd))
		+ " pid=" + result.pid);
	return finish_spawn(db, id, log_path, result.pid, profile_name, prof,
		"local:" + decl.name, port, argv, gpus, null, true);
}

// kill(2) on a process group (negative pid). Only ever called with a pid
// we spawned with setsid — pgid == that pid, and a pgid is not reused
// while any member is alive, so this cannot reach someone else's group.
// The compiled runtime's kill() returns -1 instead of throwing (the
// interpreter throws), so check both.
fn signal_group(pgid: i32, sig: i32): bool {
	if (pgid <= 1) { return false; }
	try {
		let r = kill(0 - pgid, sig);
		return r != -1;
	} catch (e) {
		return false;
	}
}

// Does ANY process (zombie or stopped included) hold this pid?
fn process_exists(pid: i32): bool {
	if (pid <= 1) { return true; }
	try {
		let r = kill(pid, 0);
		return r != -1;
	} catch (e) {
		return false;
	}
}

fn group_alive(pgid: i32): bool {
	return signal_group(pgid, 0);
}

// Pids in process group `pgid` (Linux /proc walk; [] elsewhere). Used to
// tell the unmanaged-GPU-process probe that a local service's python
// grandchild is ours, not a squatter.
export fn group_member_pids(pgid: i32): array {
	let out = [];
	if (!host_has_proc() || pgid <= 1) { return out; }
	let entries = null;
	try { entries = list_dir("/proc"); } catch (e) { return out; }
	for (name in entries) {
		let c = name.substr(0, 1);
		if (!(c >= "0" && c <= "9")) { continue; }
		try {
			let f = open("/proc/" + name + "/stat", "r");
			let st = f.read();
			f.close();
			// "<pid> (<comm>) <state> <ppid> <pgrp> ..." — comm may hold
			// spaces/parens, so split after the LAST ')'.
			let rp = -1;
			let i = 0;
			while (i < st.length) {
				if (st.substr(i, 1) == ")") { rp = i; }
				i = i + 1;
			}
			if (rp < 0) { continue; }
			let fields = st.substr(rp + 2, st.length - rp - 2).split(" ");
			if (fields.length > 2 && i32(fields[2]) == pgid) { out.push(i32(name)); }
		} catch (e) { }
	}
	return out;
}

// Binary of a services row's stored profile ("llama-server" for rows
// that predate profile_json).
fn row_binary(profile_json): string {
	if (profile_json == null) { return "llama-server"; }
	try { return parse(profile_json)?.binary ?? "llama-server"; } catch (e) { }
	return "llama-server";
}

// Every pid that belongs to a running service: the tracked pids plus,
// for local services, the members of their process groups. Feeds the
// unmanaged-process probe's "ours" set (agent.hml collect_known_pids).
export fn managed_pids(db): array {
	let rows = query(db, "select pid, state, profile_json from services", []);
	let out = [];
	for (r in rows) {
		out.push(r.pid);
		if (r.state == "running" && row_binary(r.profile_json) == "local") {
			for (p in group_member_pids(r.pid)) {
				if (p != r.pid) { out.push(p); }
			}
		}
	}
	return out;
}

export fn list_services(db): array {
	// Surface running services + crash-loop-exhausted ones (state='failed').
	// 'failed' rows are the durable "needs a human" signal — the watchdog
	// respawns transient crashes, so anything left as 'failed' gave up after
	// the crash-loop guard tripped. The dashboard health banner keys off
	// these (a just-crashed 'running' row gets reaped within ~1 tick, too
	// fleeting to rely on). Adoption-history ('dead'/'stopped') stays hidden.
	let rows = query(db,
		"select id, profile, model_path, pid, port, log_path, started_at, profile_version, gpus_json, state, profile_json, share_key, share_role "
		+ "from services where state in ('running', 'failed') order by started_at desc", []);
	let out = [];
	let me = get_pid();
	for (row in rows) {
		// device reflects where the service actually runs: gpus_json is the
		// pinned GPU index list at spawn time — empty/null means it was
		// placed CPU-only (gpu_layers=0, CUDA_VISIBLE_DEVICES="").
		let device = "cpu";
		let gpus = [];
		let gj = row?.gpus_json;
		if (gj != null && gj != "" && gj != "[]") {
			try {
				let parsed = parse(gj);
				if (parsed.length > 0) { device = "gpu"; gpus = parsed; }
			} catch (e) { }
		}
		out.push({
			id: row.id,
			profile: row.profile,
			model_path: row.model_path,
			pid: row.pid,
			port: row.port,
			log_path: row.log_path,
			started_at: row.started_at,
			profile_version: row?.profile_version,
			device: device,
			gpus: gpus,        // pinned GPU index list (empty = CPU-only)
			state: row?.state,
			binary: row_binary(row?.profile_json),
			alive: process_alive(row.pid),
		});
		let sv = shared_view(db, row);
		if (sv != null) {
			let entry = out[out.length - 1];
			entry["shared"] = sv;
			// A member is up when its proxy belongs to this agent process
			// and the shared server it forwards to is up.
			if (sv.role == "member") {
				entry["alive"] = (row.pid == me) && (sv.server_alive == true);
			}
		}
	}
	return out;
}

export fn stop_service(db, id: string): bool {
	let rows = query(db,
		"select port, share_key, share_role from services where id = ? and state = 'running'", [id]);
	if (rows.length == 0) {
		return false;
	}
	let role = rows[0]?.share_role;
	if (role == "member" || role == "server") {
		share_lock();
		try {
			if (role == "member") { stop_member_locked(db, id, rows[0].port, rows[0].share_key); }
			else { stop_server_locked(db, id, rows[0].share_key); }
		} catch (e) {
			share_unlock();
			throw e;
		}
		share_unlock();
		return true;
	}
	return stop_plain_service(db, id);
}

// SIGTERM a process-backed service and soft-delete its row (the original
// stop path; shared members are handled above).
fn stop_plain_service(db, id: string): bool {
	let rows = query(db,
		"select pid, profile_json from services where id = ? and state = 'running'", [id]);
	if (rows.length == 0) {
		return false;
	}
	let pid = rows[0].pid;
	if (row_binary(rows[0].profile_json) == "local") {
		// The whole process group: a wrapper script's children too.
		signal_group(pid, SIG_TERM);
	} else if (process_alive(pid)) {
		try { kill(pid, SIG_TERM); } catch (e) { /* race with exit; fine */ }
	}
	reap_child(pid);
	// Soft-delete: keep the row so adoption can match by port if the
	// operator later restarts the service with the same profile and
	// the previous llama-server hadn't yet exited. finish_stops follows
	// up on the next heartbeat tick in case SIGTERM wasn't enough.
	db_exec(db, "update services set state = 'stopped', stopped_at = datetime('now') where id = ?", [id]);
	return true;
}

// Seconds a stopped service gets to exit on SIGTERM before finish_stops
// sends SIGKILL. llama-server normally exits in well under a second; one
// stuck in a CUDA call or a long prompt can ignore SIGTERM indefinitely,
// which used to leave it holding its GPUs after /services/stop said 204.
let STOP_GRACE_SECONDS = 15;
// Only escalate on recent stops: an hour-old 'stopped' row whose pid is
// alive is far more likely a recycled pid than our server.
let STOP_ESCALATE_WINDOW_SECONDS = 3600;
let SIGKILL = 9;   // same value on Linux and macOS; @stdlib/signal doesn't export it

// Collect the exit status of a child we spawned, if it has exited.
// posix_spawn children stay ours even with setsid, so without this every
// stopped or crashed service lingers as a zombie until the agent exits.
// WNOHANG: never blocks. Not our child (adopted after an agent restart,
// so init reaps it) or already reaped → waitpid errors; ignore.
fn reap_child(pid: i32): null {
	if (pid <= 1) { return null; }
	try { waitpid(pid, 1); } catch (e) { }
	return null;
}

// Supervisor follow-up for stops, run once per heartbeat tick: reap
// exited children of every non-running row, and SIGKILL recently stopped
// services whose process is still alive and still ours after the grace
// period. Returns the number of processes killed (for logging).
export fn finish_stops(db): i32 {
	let rows = query(db,
		"select id, pid, profile_json, "
		+ "(strftime('%s','now') - strftime('%s', stopped_at)) as since_s "
		+ "from services where state <> 'running' "
		+ "and (share_role is null or share_role <> 'member')", []);
	let running = query(db, "select pid from services where state = 'running'", []);
	let running_pids = {};
	for (r in running) { running_pids["" + r.pid] = true; }
	let killed = 0;
	for (row in rows) {
		reap_child(row.pid);
		if (row.since_s == null) { continue; }
		let since = i32(row.since_s);
		if (since < STOP_GRACE_SECONDS || since > STOP_ESCALATE_WINDOW_SECONDS) { continue; }
		// Re-adopted or respawned onto the same pid: not ours to kill.
		if (running_pids["" + row.pid] == true) { continue; }
		let binary = row_binary(row.profile_json);
		if (binary == "local") {
			// The leader may have exited on SIGTERM while a grandchild
			// (the real server under a wrapper script) did not — check
			// and kill the group, not the leader pid.
			if (!group_alive(row.pid)) { continue; }
			eprint("[watchdog] local service " + row.id + " (pgid " + row.pid
				+ ") still running " + since + "s after SIGTERM; sending SIGKILL to the group");
			if (signal_group(row.pid, SIGKILL)) { killed = killed + 1; }
			continue;
		}
		if (!service_healthy(row.pid, binary)) { continue; }
		eprint("[watchdog] service " + row.id + " (pid " + row.pid + ") ignored SIGTERM for "
			+ since + "s; sending SIGKILL");
		try { kill(row.pid, SIGKILL); killed = killed + 1; } catch (e) { }
	}
	return killed;
}

// ── auto-restart watchdog ───────────────────────────────────────────────
// reconcile_services is the supervisor tick: called once at boot and once
// per heartbeat from agent.hml. It brings the running set back in line
// with the desired set (every row still marked 'running' in sqlite).
//
//   auto_restart OFF → behave like reap_zombie_services: soft-delete any
//     'running' row whose process is gone. The operator opted out of
//     supervision, so we just keep /services honest.
//   auto_restart ON  → respawn dead services from their stored
//     profile/model/port/gpus, carrying a restart_count for crash-loop
//     protection.
//
// This is also the reboot-recovery path: after a host reboot the agent
// restarts, its sqlite still holds the pre-reboot 'running' rows, their
// pids are dead, and reconcile respawns them. The agent-crash-children-
// survived case is a no-op here (pids still alive + ours → healthy).
//
// Crash-loop guard: a service that dies again within STABLE_SECONDS of
// its last (re)start bumps restart_count; once it exceeds
// MAX_RAPID_RESTARTS the row is parked in 'failed' and left alone, so a
// genuinely-broken service (bad model, missing CUDA, contended port)
// doesn't spin forever. A service that stayed up past STABLE_SECONDS
// resets the count — "crashed once after a day" is treated as fresh.
let STABLE_SECONDS = 120;
let MAX_RAPID_RESTARTS = 5;

fn caps_for_binary(caps_ref, binary) {
	if (binary == "llama-server")   { return caps_ref?.llama_server ?? {}; }
	if (binary == "sd-server")      { return caps_ref?.sd_server ?? {}; }
	if (binary == "whisper-server") { return caps_ref?.whisper_server ?? {}; }
	if (binary == "piper")          { return caps_ref?.piper ?? {}; }
	return {};
}

fn binpath_for_binary(binary: string): string {
	if (binary == "llama-server")   { return current_binary_path(); }
	if (binary == "sd-server")      { return sd_current_binary_path(); }
	if (binary == "whisper-server") { return wcpp_current_binary_path(); }
	if (binary == "piper")          { return pcpp_current_binary_path(); }
	return binary;
}

// Is the process at `pid` still one of ours for this profile's binary?
// Mirrors reap's liveness logic but binary-aware (sd-server vs llama).
fn service_healthy(pid: i32, binary: string): bool {
	if (!process_alive(pid)) { return false; }
	if (binary == "sd-server") { return is_our_sd_server(pid); }
	// whisper-server / piper / local / llama-server: treat a live pid as
	// healthy. (local: the setsid leader we spawned — the declaration's
	// argv[0], usually a wrapper script.)
	// is_our_llama_server only matches llama; for whisper/piper we can't
	// cheaply fingerprint, so a live pid is good enough (PID-recycle on a
	// short-lived CPU server is vanishingly unlikely and self-heals next
	// tick if it does).
	if (binary == "llama-server") { return is_our_llama_server(pid); }
	return true;
}

// Returns the number of services respawned this tick (for logging).
//
// Two-phase by design: phase 1 reads the running rows and classifies
// them; phase 2 does all the inserts/updates. We must NOT write to the
// services table while iterating a query over it — SQLite can re-yield
// rows inserted mid-scan, which made an earlier version respawn its own
// fresh spawns in a runaway loop (duplicate servers on every port). The
// per-port guard is the belt to that suspenders: never start a second
// server on a port already served by a healthy row, and respawn each
// port at most once per tick.
export fn reconcile_services(db, caps_ref): i32 {
	if (!get_auto_restart(db)) {
		// Watchdog off — plain reap so dead rows still leave 'running'.
		return 0 - reap_zombie_services(db);   // negative = "reaped, not restarted"
	}
	// Under SHARE_LOCK so a respawn can't interleave with a shared-server
	// join/restart on another thread. try_acquire, not wait: a join can hold
	// the lock for a model reload, and blocking the heartbeat that long
	// would make the CP drop this node as stale. The next tick catches up.
	if (!SHARE_LOCK.try_acquire()) {
		print("[watchdog] shared-server change in progress; reconcile deferred to next tick");
		return 0;
	}
	let n = 0;
	try {
		n = reconcile_services_locked(db, caps_ref);
		ensure_member_proxies_locked(db);
	} catch (e) {
		share_unlock();
		throw e;
	}
	share_unlock();
	return n;
}

fn reconcile_services_locked(db, caps_ref): i32 {

	// ── phase 1: read-only classification ──────────────────────────
	let rows = query(db,
		"select id, profile, model_path, pid, port, profile_json, gpus_json, "
		+ "tensor_split_json, restart_count, "
		+ "(strftime('%s','now') - strftime('%s', started_at)) as uptime_s "
		+ "from services where state = 'running' "
		+ "and (share_role is null or share_role <> 'member')", []);
	let dead = [];
	let live_ports = {};   // ports already served by a healthy 'running' row
	for (row in rows) {
		let prof = null;
		try { if (row.profile_json != null) { prof = parse(row.profile_json); } } catch (e) { prof = null; }
		let binary = prof?.binary ?? "llama-server";
		if (service_healthy(row.pid, binary)) {
			live_ports["" + row.port] = true;
			continue;
		}
		dead.push({
			id: row.id, pid: row.pid, profile: row.profile, model_path: row.model_path,
			port: row.port, prof: prof, binary: binary,
			gpus_json: row.gpus_json, tensor_split_json: row.tensor_split_json,
			restart_count: row?.restart_count ?? 0, uptime_s: row?.uptime_s,
		});
	}

	// ── phase 2: act (inserts/updates, no longer scanning the table) ──
	let restarted = 0;
	let handled_ports = {};   // ports we (re)spawned this tick
	for (d in dead) {
		let pkey = "" + d.port;
		// Duplicate-row guard: this port is already served (a healthy row)
		// or we just respawned it — retire this stale row instead of
		// stacking a second server on the same port.
		if (live_ports.has(pkey) || handled_ports.has(pkey)) {
			db_exec(db, "update services set state = 'dead' where id = ?", [d.id]);
			continue;
		}

		// Can't rebuild without profile + model → soft-delete (old
		// pre-profile_json row, or a wiped sqlite).
		if (d.prof == null || d.model_path == null) {
			db_exec(db, "update services set state = 'dead' where id = ?", [d.id]);
			print("[watchdog] " + d.profile
				+ " down but no profile metadata to respawn — marked dead");
			continue;
		}

		// Crash-loop accounting. uptime_s ≈ how long it actually ran
		// (detection lag ≤ one heartbeat); a long run resets the counter.
		let stable = (d.uptime_s != null && d.uptime_s >= STABLE_SECONDS);
		let next_count = stable ? 1 : (d.restart_count + 1);
		if (next_count > MAX_RAPID_RESTARTS) {
			db_exec(db, "update services set state = 'failed' where id = ?", [d.id]);
			print("[watchdog] " + d.profile + " crash-looping ("
				+ d.restart_count + " rapid restarts) — parked in 'failed'. Fix "
				+ "the underlying cause and re-spawn it manually.");
			continue;
		}

		let gpus = null;
		let tsplit = null;
		try { if (d.gpus_json != null) { gpus = parse(d.gpus_json); } } catch (e) { }
		try { if (d.tensor_split_json != null) { tsplit = parse(d.tensor_split_json); } } catch (e) { }
		let caps = caps_for_binary(caps_ref, d.binary);
		let bin = binpath_for_binary(d.binary);
		// A local service's leader died but its group may not have (a
		// wrapper script crashed, its python child still holds the port
		// and the GPU). Clear the group before respawning on that port.
		// Only once the leader pid is fully gone: then a live group with
		// that id can only be the one we created (the kernel doesn't hand
		// out a pid still in use as a pgid).
		if (d.binary == "local") {
			reap_child(d.pid);
			if (!process_exists(d.pid)) { signal_group(d.pid, SIGKILL); }
		}
		try {
			let svc = spawn_service(db, d.profile, d.prof, d.model_path,
				i32(d.port), gpus, tsplit, caps, bin);
			// Old row → dead; carry the climbing count onto the new row.
			db_exec(db, "update services set state = 'dead' where id = ?", [d.id]);
			db_exec(db, "update services set restart_count = ? where id = ?",
				[next_count, svc.id]);
			handled_ports[pkey] = true;
			restarted = restarted + 1;
			print("[watchdog] restarted " + d.profile + " on port "
				+ d.port + " (pid " + svc.pid + ", attempt " + next_count + ")");
		} catch (e) {
			// Spawn failed (port still held by the dying child, OOM, etc).
			// Keep the row 'running' but reset started_at to now and bump
			// the count so the next tick retries with backoff accounting —
			// the crash-loop guard eventually parks it in 'failed'.
			db_exec(db,
				"update services set started_at = datetime('now'), restart_count = ? where id = ?",
				[next_count, d.id]);
			print("[watchdog] failed to restart " + d.profile
				+ " (attempt " + next_count + "): " + e);
		}
	}
	prune_service_history(db);
	return restarted;
}

// ── shared-base LoRA serving ────────────────────────────────────────────
// Profiles with `share_group` (lora_share.hml) are served by ONE
// llama-server per (group, base model, server settings, GPU set) — the
// "server" row — with every member's adapters loaded at global scale 0.
// Each member keeps its own port: a "member" row whose pid is the agent's
// own and whose port is served by an in-agent proxy (lora_proxy.hml) that
// pins the member's adapter on every generation request.
//
// Lifecycle:
//   join     first member starts the server; a later member joins it, and
//            the server restarts only when it doesn't already cover the
//            new member (adapter not loaded, too few slots/context) —
//            llama-server can't load an adapter at runtime. The restart is
//            stop-then-start (a 16 GB card can't hold two copies), so the
//            other members answer 503 "Loading model" for the reload time.
//   leave    stopping a member closes its port; the server keeps running
//            for the others WITHOUT a restart (the departed member's
//            adapter/slots are reclaimed at the next restart). Stopping
//            the LAST member stops the server. Stopping the server row
//            stops all of its members.
//   watchdog the server is an ordinary llama-server row: crash → respawn
//            from its stored profile (same config), crash-loop → 'failed'.
//            Members are re-checked every tick (ensure_member_proxies): a
//            member whose proxy isn't this agent process's — i.e. after an
//            agent restart — gets its port re-bound. The proxies live and
//            die with the agent; the server, a setsid child, outlives it.
// All membership changes and the watchdog tick hold SHARE_LOCK.

let SHARE_LOCK = SpinLock();

// Sleeping lock: a join can hold it across a model load, so don't spin.
fn share_lock(): null {
	while (!SHARE_LOCK.try_acquire()) { sleep(0.02); }
	return null;
}

fn share_unlock(): null {
	SHARE_LOCK.release();
	return null;
}

// Internal (loopback) ports for shared servers start here and walk up.
fn shared_port_base(): i32 {
	let v = getenv("WITCHGRID_SHARED_PORT_BASE");
	if (v == null || v.length == 0) { return 18700; }
	return i32(v);
}

fn port_bindable(port: i32): bool {
	let s = null;
	try { s = socket_create(NET_AF_INET, NET_SOCK_STREAM, 0); } catch (e) { return true; }
	try { s.setsockopt(NET_SOL_SOCKET, NET_SO_REUSEADDR, 1); } catch (e) { }
	let free = true;
	try { s.bind("0.0.0.0", port); } catch (e) { free = false; }
	try { s.close(); } catch (e) { }
	return free;
}

fn pick_internal_port(db): i32 {
	let used = {};
	let rows = query(db, "select port from services where state in ('running', 'failed')", []);
	for (r in rows) { used["" + r.port] = true; }
	let p = shared_port_base();
	let n = 0;
	while (n < 200) {
		if (!used.has("" + p) && port_bindable(p)) { return p; }
		p = p + 1;
		n = n + 1;
	}
	throw "share: no free internal port in " + shared_port_base() + "-" + (shared_port_base() + 199);
}

// The running server row for a share key (with its parsed profile), or null.
fn server_row_by_key(db, key: string) {
	let r = query(db,
		"select id, pid, port, model_path, profile_json, gpus_json, tensor_split_json, "
		+ "log_path, started_at from services "
		+ "where share_key = ? and share_role = 'server' and state = 'running' "
		+ "order by started_at desc limit 1", [key]);
	if (r.length == 0) { return null; }
	let row = r[0];
	let prof = null;
	try { prof = parse(row.profile_json); } catch (e) { }
	row["prof"] = prof;
	return row;
}

// Profiles of the running members of a share key, in join order.
fn member_profs(db, key: string): array {
	let rows = query(db,
		"select profile_json from services where share_key = ? and share_role = 'member' "
		+ "and state = 'running' order by started_at asc, rowid asc", [key]);
	let out = [];
	for (r in rows) {
		try { out.push(parse(r.profile_json)); } catch (e) { }
	}
	return out;
}

// Stop a shared server and WAIT for it to exit (its VRAM must be free
// before the replacement loads). SIGKILL after HALT_TERM_GRACE_SECONDS:
// a server spawned from one of the agent's worker threads inherits that
// thread's blocked signal mask (Hemlock blocks signals in spawned tasks and
// posix_spawn doesn't reset the mask), so SIGTERM stays pending and only
// SIGKILL ends it. llama-server holds nothing that needs a clean shutdown,
// and every second here is downtime for the other members.
let HALT_TERM_GRACE_SECONDS = 1.0;

fn halt_server(db, row): null {
	let pid = row.pid;
	if (process_alive(pid)) {
		try { kill(pid, SIG_TERM); } catch (e) { }
	}
	let waited = 0.0;
	while (process_alive(pid) && waited < HALT_TERM_GRACE_SECONDS) {
		sleep(0.2);
		waited = waited + 0.2;
		reap_child(pid);
	}
	if (process_alive(pid) && is_our_llama_server(pid)) {
		try { kill(pid, SIGKILL); } catch (e) { }
		sleep(0.5);
	}
	reap_child(pid);
	db_exec(db, "update services set state = 'stopped', stopped_at = datetime('now') where id = ?",
		[row.id]);
	return null;
}

fn parse_or_null(j) {
	if (j == null) { return null; }
	try { return parse(j); } catch (e) { }
	return null;
}

// Restart a shared server with a bigger config. On failure, bring the
// previous config back so the existing members keep serving, then throw.
fn restart_shared(db, srv, cfg, prof, group: string, key: string, caps, bin: string,
                  model_path: string) {
	let gpus = parse_or_null(srv.gpus_json);
	let ts = parse_or_null(srv.tensor_split_json);
	print("[share] restarting " + key + ": " + cfg.adapters.length + " adapter(s), "
		+ cfg.slots + " slot(s) x " + cfg.ctx_per_slot + " ctx");
	halt_server(db, srv);
	let sprof = shared_server_profile(prof, cfg, group, key, caps, model_path);
	try {
		spawn_service(db, "shared:" + group, sprof, model_path, pick_internal_port(db),
			gpus, ts, caps, bin);
	} catch (e) {
		eprint("[share] restart of " + key + " failed: " + e + " — restoring the previous config");
		try {
			spawn_service(db, "shared:" + group, srv.prof, model_path, pick_internal_port(db),
				gpus, ts, caps, bin);
		} catch (e2) {
			eprint("[share] restoring " + key + " failed too: " + e2);
		}
		throw e;
	}
	return server_row_by_key(db, key);
}

fn join_shared(db, profile_name: string, prof, model_path: string, port: i32, gpus,
               tensor_split, caps, bin: string): object {
	let err = sharing_profile_error(prof);
	if (err != null) { throw "share: " + err; }
	if (caps == null || !caps.has("lora-scaled")) {
		throw "share: this llama-server has no --lora-scaled (needed to load adapters "
			+ "at global scale 0); upgrade llama.cpp on this node";
	}
	share_lock();
	let out = null;
	try {
		out = join_shared_locked(db, profile_name, prof, model_path, port, gpus,
			tensor_split, caps, bin);
	} catch (e) {
		share_unlock();
		throw e;
	}
	share_unlock();
	return out;
}

fn join_shared_locked(db, profile_name: string, prof, model_path: string, port: i32,
                      gpus, tensor_split, caps, bin: string): object {
	let group = "" + prof.share_group;
	let key = share_key(group, model_path, prof, gpus);
	let sig = compat_signature(prof);

	// Same group + same base model already served with DIFFERENT server
	// settings is almost certainly a profile mismatch (one has --jinja, one
	// doesn't…). Refuse with the diff instead of quietly loading the base
	// twice. (Different GPU sets with equal settings are separate servers.)
	let others = query(db,
		"select profile_json, model_path from services "
		+ "where share_role = 'server' and state = 'running'", []);
	for (o in others) {
		let ss = parse_or_null(o.profile_json)?.__shared_server;
		if (ss == null || ss?.group != group || o.model_path != model_path) { continue; }
		if (ss?.signature != null && ss.signature != sig) {
			throw "share: share_group '" + group + "' already serves " + model_path
				+ " with " + ss.signature + "; '" + profile_name + "' has " + sig
				+ " — make the settings match or use another share_group";
		}
	}

	let srv = server_row_by_key(db, key);
	let profs = member_profs(db, key);
	profs.push(prof);
	let want = desired_config(profs);
	let restarted = false;
	if (srv != null) {
		let cur = server_config(srv.prof);
		if (!config_covers(cur, want)) {
			srv = restart_shared(db, srv, restart_config(cur, want), prof, group, key,
				caps, bin, model_path);
			restarted = true;
		} else {
			print("[share] " + profile_name + " joins " + key + " (no restart needed)");
		}
	} else {
		let iport = pick_internal_port(db);
		let sprof = shared_server_profile(prof, want, group, key, caps, model_path);
		spawn_service(db, "shared:" + group, sprof, model_path, iport, gpus, tensor_split,
			caps, bin);
		srv = server_row_by_key(db, key);
		print("[share] started shared server " + key + " on 127.0.0.1:" + iport
			+ " for " + profile_name);
	}
	if (srv == null) { throw "share: shared server for " + key + " is not running"; }

	let id = new_id(db);
	let now = iso_now(db);
	db_exec(db,
		"insert into services (id, profile, model_path, pid, port, log_path, args_json, "
		+ "started_at, profile_version, profile_json, gpus_json, tensor_split_json, state, "
		+ "share_key, share_role) values (?, ?, ?, ?, ?, ?, '[]', ?, ?, ?, ?, ?, 'running', ?, 'member')",
		[id, profile_name, model_path, get_pid(), port, srv.log_path, now, prof?.__version,
			stringify(prof), srv.gpus_json, srv.tensor_split_json, key]);
	try {
		start_member_proxy(db, id, port);
	} catch (e) {
		db_exec(db, "update services set state = 'dead' where id = ?", [id]);
		if (member_profs(db, key).length == 0) { halt_server(db, srv); }
		throw "spawn died immediately: member port " + port + " could not be bound (" + e + ")";
	}
	return {
		id: id,
		profile: profile_name,
		model_path: model_path,
		pid: get_pid(),
		port: port,
		log_path: srv.log_path,
		started_at: now,
		profile_version: prof?.__version,
		shared: { role: "member", group: group, key: key, server_id: srv.id,
			server_port: srv.port, restarted: restarted },
	};
}

// Watchdog half for members (called from reconcile_services under the
// lock): make sure every running member's port is served by THIS agent
// process. After an agent restart every member's stored pid is the old
// agent's, so all proxies get re-bound here; a member whose server is gone
// for good (stopped/dead, not just 'failed') is retired. Returns the
// number of proxies (re)started.
fn ensure_member_proxies_locked(db): i32 {
	let rows = query(db,
		"select id, profile, port, pid, share_key from services "
		+ "where share_role = 'member' and state = 'running'", []);
	let me = get_pid();
	let started = 0;
	for (r in rows) {
		let srv = query(db,
			"select id from services where share_key = ? and share_role = 'server' "
			+ "and state in ('running', 'failed') limit 1", [r.share_key]);
		if (srv.length == 0) {
			db_exec(db, "update services set state = 'dead' where id = ?", [r.id]);
			print("[share] member " + r.profile + " retired: its shared server is gone");
			continue;
		}
		if (r.pid == me && member_proxy_alive(r.id, r.port)) { continue; }
		db_exec(db, "update services set pid = ? where id = ?", [me, r.id]);
		try {
			start_member_proxy(db, r.id, r.port);
			started = started + 1;
		} catch (e) {
			eprint("[share] member " + r.profile + ": port " + r.port + " not re-bound: " + e);
		}
	}
	return started;
}

export fn ensure_member_proxies(db): i32 {
	share_lock();
	let n = 0;
	try { n = ensure_member_proxies_locked(db); } catch (e) {
		eprint("[share] ensure_member_proxies: " + e);
	}
	share_unlock();
	return n;
}

// Stop one member: close its port; stop the server if it was the last one.
fn stop_member_locked(db, id: string, port: i32, key: string): null {
	db_exec(db, "update services set state = 'stopped', stopped_at = datetime('now') where id = ?", [id]);
	stop_member_proxy(port);
	if (member_profs(db, key).length == 0) {
		let srv = server_row_by_key(db, key);
		if (srv != null) {
			print("[share] last member left " + key + " — stopping the shared server");
			stop_plain_service(db, srv.id);
		}
	}
	return null;
}

// Stop a shared server and every member it serves.
fn stop_server_locked(db, id: string, key: string): null {
	stop_plain_service(db, id);
	let rows = query(db,
		"select id, port from services where share_key = ? and share_role = 'member' and state = 'running'",
		[key]);
	for (r in rows) {
		db_exec(db, "update services set state = 'stopped', stopped_at = datetime('now') where id = ?", [r.id]);
		stop_member_proxy(r.port);
	}
	return null;
}

// /services view of the shared bits of a row (null for ordinary rows).
fn shared_view(db, row) {
	if (row?.share_role == null) { return null; }
	if (row.share_role == "server") {
		let prof = parse_or_null(row.profile_json);
		let ss = prof?.__shared_server ?? {};
		let members = query(db,
			"select profile, port from services where share_key = ? and share_role = 'member' "
			+ "and state = 'running' order by started_at asc", [row.share_key]);
		let names = [];
		let slots_in_use = 0;
		let cps_in_use = 0;
		let mrows = query(db,
			"select profile_json from services where share_key = ? and share_role = 'member' "
			+ "and state = 'running'", [row.share_key]);
		for (m in mrows) {
			let mp = parse_or_null(m.profile_json);
			try {
				slots_in_use = slots_in_use + member_slots(mp);
				let c = member_ctx_per_slot(mp);
				if (c > cps_in_use) { cps_in_use = c; }
			} catch (e) { }
		}
		for (m in members) { names.push({ profile: m.profile, port: m.port }); }
		return {
			role: "server",
			group: ss?.group,
			key: row.share_key,
			adapters: ss?.adapters ?? [],
			slots: ss?.slots,
			ctx_per_slot: ss?.ctx_per_slot,
			context: ss?.context,
			cache_ram_off: ss?.cache_ram_off,
			members: names,
			slots_in_use: slots_in_use,
			ctx_per_slot_in_use: cps_in_use,
		};
	}
	let mp = parse_or_null(row.profile_json);
	let srv = query(db,
		"select id, pid, port, state from services where share_key = ? and share_role = 'server' "
		+ "and state in ('running', 'failed') order by started_at desc limit 1", [row.share_key]);
	let adapters = [];
	try { for (a in profile_adapters(mp)) { adapters.push(a.path); } } catch (e) { }
	return {
		role: "member",
		group: mp?.share_group,
		key: row.share_key,
		server_id: (srv.length > 0 ? srv[0].id : null),
		server_port: (srv.length > 0 ? srv[0].port : null),
		server_alive: (srv.length > 0 && srv[0].state == "running" && process_alive(srv[0].pid)),
		adapters: adapters,
		alias: profile_alias(mp),
	};
}

// ── HTTP handlers ─────────────────────────────────────────────────────

// reserved_ports: ports the agent must refuse to spawn services on,
// regardless of who asks. The agent's own listen port is the obvious
// one — letting an llama-server land there is how schneewolf orphaned
// itself last session (a stray auto-spawn took 8766, agent restart
// then couldn't bind, ssh-and-pkill required to recover).
//
// capabilities_for: function `(binary_name) → caps_map` so each spawn
// can resolve its profile's intents against the right binary's --help
// map. Passed as a closure so the agent can refresh on its own schedule
// without us shipping a stale snapshot here.
export fn make_handlers(db, reserved_ports, capabilities_for, binary_path_for): object {
	return {
		create: fn(req): object {
			let payload = parse(req.body);
			// Since v0.7 CP inlines the profile object as `profile`,
			// with the human-friendly name in `profile_name`. The
			// agent doesn't have its own PROFILES map anymore.
			let profile = payload?.profile;
			let profile_name = payload?.profile_name;
			let model = payload?.model;
			// local engine: no model — the agent-side declaration is the
			// whole command. Look it up now (refusing undeclared names with
			// 403) so its declared port can be the default.
			let local_decl = null;
			if (profile?.binary == "local") {
				try {
					local_decl = find_declaration(local_services_dir(), profile?.local_service);
				} catch (e) {
					return { status: 403, body: stringify({ error: "" + e }) };
				}
				model = "local:" + local_decl.name;
			}
			if (profile == null || model == null) {
				return { status: 400, body: "{\"error\":\"profile+model required (CP must inline profile object since v0.7)\"}" };
			}
			if (profile_name == null) { profile_name = "<unnamed>"; }
			let port = payload?.port;
			if (port == null) { port = profile?.default_port; }
			if (port == null && local_decl != null) { port = local_decl.port; }
			if (port == null) {
				return { status: 400, body: "{\"error\":\"port required (profile has no default_port)\"}" };
			}
			// Refuse to bind on reserved ports. Caller (CP's pick_port)
			// should never send one of these, but defense in depth.
			let i = 0;
			while (i < reserved_ports.length) {
				if (port == reserved_ports[i]) {
					return { status: 409, body: stringify({
						error: "port " + port + " is reserved by the agent itself",
					})};
				}
				i = i + 1;
			}
			let gpus = payload?.gpus ?? [];
			let tensor_split = payload?.tensor_split;
			try {
				let caps = capabilities_for(profile.binary);
				let bin = binary_path_for(profile.binary);
				let svc = spawn_service(db, profile_name, profile, model, port, gpus, tensor_split, caps, bin);
				return { status: 201, body: stringify(svc) };
			} catch (e) {
				// 502 vs 400: a port-bind / missing-model / OOM error from
				// llama-server is upstream failure (502), not a client-input
				// error. The "spawn died immediately" prefix is the marker.
				let msg = "" + e;
				let status = 400;
				if (msg.find("spawn died") >= 0) { status = 502; }
				// Declaration removed/broken between the check above and
				// the spawn: still a refusal, not a bad request.
				if (msg.find("not declared") >= 0) { status = 403; }
				// Shared-LoRA refusals (incompatible settings, bad lora
				// field, no --lora-scaled): a conflict with what's running
				// or with the profile, not a malformed request.
				if (msg.find("share: ") == 0) { status = 409; }
				return { status: status, body: stringify({ error: msg }) };
			}
		},
		list: fn(req): object {
			return { status: 200, body: stringify(list_services(db)) };
		},
		stop: fn(req): object {
			let payload = parse(req.body);
			let id = payload?.id;
			if (id == null) {
				return { status: 400, body: "{\"error\":\"id required\"}" };
			}
			let ok = stop_service(db, id);
			if (!ok) {
				return { status: 404, body: "{\"error\":\"not found\"}" };
			}
			return { status: 204, body: "" };
		},
		// POST /unmanaged/kill { pid } — best-effort SIGTERM of a process
		// witchgrid did NOT spawn (the dashboard offers this on unmanaged
		// rows). Refuses pids that are our own managed services (use /stop).
		// Note: the agent runs as one user; killing another user's process
		// fails with EPERM — surfaced as a 502 so the UI can say so.
		kill_unmanaged: fn(req): object {
			let payload = parse(req.body);
			let pid_in = payload?.pid;
			if (pid_in == null) {
				return { status: 400, body: "{\"error\":\"pid required\"}" };
			}
			let pid = i32(pid_in);
			// kill(2) makes small/negative pids catastrophic: 0 = our whole
			// process group, -1 = EVERY process this user owns, other
			// negatives = that process group. And our own pid would be the
			// agent killing itself via its own API. Refuse all of these.
			if (pid < 2) {
				return { status: 400, body: "{\"error\":\"pid must be >= 2 (group/broadcast kills refused)\"}" };
			}
			if (pid == get_pid()) {
				return { status: 400, body: "{\"error\":\"refusing to kill the agent itself\"}" };
			}
			let mine = query(db,
				"select id from services where pid = ? and state = 'running'", [pid]);
			if (mine.length > 0) {
				return { status: 409, body: "{\"error\":\"that pid is a managed witchgrid service \\u2014 use stop\"}" };
			}
			try {
				kill(pid, SIG_TERM);
			} catch (e) {
				return { status: 502, body: stringify({ error: "kill failed: " + e }) };
			}
			return { status: 200, body: "{\"ok\":true}" };
		},
		// GET /settings → { auto_restart }. Per-agent knobs; CP mirrors
		// this into /nodes and the dashboard exposes a toggle.
		get_settings: fn(req): object {
			return { status: 200, body: stringify({
				auto_restart: get_auto_restart(db),
			})};
		},
		// PUT /settings  body { auto_restart: bool } — flips the watchdog
		// on/off for this agent; effective next reconcile tick.
		put_settings: fn(req): object {
			let payload = null;
			try { payload = parse(req?.body ?? "{}"); } catch (e) {
				return { status: 400, body: "{\"error\":\"bad json\"}" };
			}
			let ar = payload?.auto_restart;
			if (ar == null) {
				return { status: 400, body: "{\"error\":\"auto_restart (bool) required\"}" };
			}
			set_auto_restart(db, ar == true);
			return { status: 200, body: stringify({
				auto_restart: get_auto_restart(db),
			})};
		},
		// /profiles handler removed in v0.7 — profiles live on CP.
		// agent.hml dropped its registration; this stub stays so the
		// handlers map shape doesn't break callers expecting `.profiles`.
		profiles: fn(req): object {
			return { status: 410, body: stringify({
				error: "agent /profiles gone in v0.7 — see CP /api/profiles",
			})};
		},
		// GET /services/log/{id} → tail of the per-service log file.
		// 32KB cap so a single response doesn't dump multi-MB inference
		// logs. Returns plain text (Content-Type: text/plain) so the
		// dashboard can show it raw without JSON-decoding noise.
		log: fn(req): object {
			let prefix = "/services/log/";
			let id = req.path.substr(prefix.length, req.path.length - prefix.length);
			if (id == null || id.length == 0) {
				return { status: 400, body: "{\"error\":\"id required\"}" };
			}
			let rows = query(db,
				"select log_path from services where id = ?", [id]);
			if (rows.length == 0) {
				return { status: 404, body: "{\"error\":\"no such service\"}" };
			}
			let tail = read_log_tail(rows[0].log_path, 32768);
			return { status: 200, body: tail,
				headers: { "content-type": "text/plain; charset=utf-8" } };
		},
	};
}
